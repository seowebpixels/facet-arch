<style>
  :root {
    --accent-cyan: #00ffc8;
  }

  .highlight-link {
    color: var(--accent-cyan) !important;
    text-decoration: underline;
  }

  .legal-page {
    background-color: var(--bg-concrete, #BEBEBE);
    color: #111111;
    min-height: 100vh;
    padding: 8rem 2rem 4rem 2rem;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .legal-container {
    max-width: 850px;
    margin: 0 auto;
    background: #ffffff;
    padding: 3rem;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
  }

  h1 {
    font-family: 'Nesobrite', 'Bank Gothic', sans-serif;
    font-size: 2.2rem;
    margin-bottom: 0.5rem;
  }

  .updated-date {
    color: #666666;
    margin-bottom: 1.5rem;
  }

  .legal-divider {
    border: none;
    border-top: 1px solid #eeeeee;
    margin: 1.5rem 0 2rem 0;
  }

  h2 {
    font-size: 1.3rem;
    margin-top: 2rem;
    border-bottom: 1px solid #eeeeee;
    padding-bottom: 0.5rem;
    color: #000000;
  }

  p, li {
    line-height: 1.6;
    color: #333333;
    font-size: 0.95rem;
  }

  ol, ul {
    padding-left: 1.25rem;
  }

  li {
    margin-bottom: 0.5rem;
  }

  .contact-box {
    font-style: normal;
    line-height: 1.6;
    margin-top: 1rem;
    background: #f9f9f9;
    padding: 1rem 1.25rem;
    border-radius: 8px;
    border-left: 3px solid var(--accent-cyan);
  }

  @media (max-width: 768px) {
    .legal-page {
      padding: 6rem 1rem 2rem 1rem;
    }
    .legal-container {
      padding: 1.5rem;
    }
  }
</style>