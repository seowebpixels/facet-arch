---
import Layout from '../layouts/Layout.astro';
import MoodGrid from '../components/MoodGrid.astro';
import HomeFooter from '../components/HomeFooter.astro';
import { Image } from 'astro:assets';
import Hero from '../components/Hero.astro';

// Import featured assets
import commImg from '../assets/comm-i-stores.avif';
import devImg from '../assets/dev-kubu.avif';
import intImg from '../assets/int-david.avif';
import resImg from '../assets/res-eoa-1597-grid.avif';
import sustImg from '../assets/sustainability-thermal-comfort.avif';
import renImg from '../assets/renvid-elementum.jpg';
---

<Layout title="Facet Architecture | Selected Works">

  <Hero />

  <main class="main-wrapper">
    <!-- Left Column: Sticky Editorial Content -->
    <section class="left-sticky-col">
      <div class="brand-intro">
        <p class="subtitle" style="color: #D9DDDC !important;">SELECTED WORKS</p>
        <h1 class="headline" style="color: #D9DDDC !important;">Precision in Spatial & Sustainable Design</h1>
        <p class="philosophy" style="color: #FFFFFF !important;">
          Facet Architecture transforms complex spatial challenges into contemporary minimalist and innovative sustainable design. Rooted in material clarity and environmental context, our practice explores the interplay between space, movement and aesthetic integrity.
        </p>
      </div>

      <div class="index-legend" style="font-family: 'Bank Gothic', 'BankGothic', sans-serif !important; text-transform: uppercase !important;">
      <div class="legend-item" data-index="0" style="color: #D9DDC !important; font-family: 'FacetBankGothic', sans-serif !important; text-transform: uppercase !important;"><span class="legend-num" style="color: #D9DDC !important; font-family: 'FacetBankGothic', sans-serif !important;">01</span> ISTORE     
      <div class="legend-item" data-index="0" style="color: #D9DDC !important; font-family: 'FacetBankGothic', sans-serif !important; text-transform: uppercase !important;"><span class="legend-num" style="color: #D9DDC !important; font-family: 'FacetBankGothic', sans-serif !important;">02</span> KUBU
      <div class="legend-item" data-index="0" style="color: #D9DDC !important; font-family: 'FacetBankGothic', sans-serif !important; text-transform: uppercase !important;"><span class="legend-num" style="color: #D9DDC !important; font-family: 'FacetBankGothic', sans-serif !important;">03</span> DAVID
      <div class="legend-item" data-index="0" style="color: #D9DDC !important; font-family: 'FacetBankGothic', sans-serif !important; text-transform: uppercase !important;"><span class="legend-num" style="color: #D9DDC !important; font-family: 'FacetBankGothic', sans-serif !important;">04</span> EOA RESIDENCE
      <div class="legend-item" data-index="0" style="color: #D9DDC !important; font-family: 'FacetBankGothic', sans-serif !important; text-transform: uppercase !important;"><span class="legend-num" style="color: #D9DDC !important; font-family: 'FacetBankGothic', sans-serif !important;">05</span> THERMAL COMFORT STUDY
      <div class="legend-item" data-index="0" style="color: #D9DDC !important; font-family: 'FacetBankGothic', sans-serif !important; text-transform: uppercase !important;"><span class="legend-num" style="color: #D9DDC !important; font-family: 'FacetBankGothic', sans-serif !important;">06</span> ELEMENTUM      
      </div>
    </section>

    <!-- Right Column: Staggered Selected Works Grid -->
    <section class="right-grid-col">
      <!-- Tile 1 -->
      <a href="/portfolio#commercial" class="tile-card tile-1" data-bg="#3A3F47">
        <div class="image-container">
          <Image 
            src={commImg} 
            alt="iStore" 
            widths={[360, 720]} 
            sizes="(max-width: 768px) 90vw, 400px" 
            format="avif"
            quality={55}
            loading="eager" 
            decoding="sync"
          />
          <div class="tile-overlay">
            <span class="tile-num">01</span>
            <div class="tile-meta">
              <h2>iStore</h2>
              <p>Commercial</p>
            </div>
          </div>
        </div>
      </a>

      <!-- Tile 2 -->
      <a href="/portfolio#development" class="tile-card tile-2" data-bg="#5c5e5d">
        <div class="image-container">
          <Image 
            src={devImg} 
            alt="Kubu" 
            widths={[360, 720]} 
            sizes="(max-width: 768px) 90vw, 400px"
            loading="lazy" 
            decoding="async"
          />
          <div class="tile-overlay">
            <span class="tile-num">02</span>
            <div class="tile-meta">
              <h2>Kubu</h2>
              <p>Development & Masterplanning</p>
            </div>
          </div>
        </div>
      </a>

      <!-- Tile 3 -->
      <a href="/portfolio#interiors" class="tile-card tile-3" data-bg="#BF6363">
        <div class="image-container">
          <Image 
            src={intImg} 
            alt="David" 
            widths={[360, 720]} 
            sizes="(max-width: 768px) 90vw, 400px"
            format="avif"
            quality={55} 
            loading="lazy" 
            decoding="async"
          />
          <div class="tile-overlay">
            <span class="tile-num">03</span>
            <div class="tile-meta">
              <h2>David</h2>
              <p>Interiors</p>
            </div>
          </div>
        </div>
      </a>

      <!-- Tile 4 -->
      <a href="/portfolio#residential" class="tile-card tile-4" data-bg="#8C8275">
        <div class="image-container">
          <Image 
            src={resImg} 
            alt="EOA 1957 Residence" 
            widths={[360, 720]} 
            sizes="(max-width: 768px) 90vw, 400px"
            format="avif" 
            quality={55}
            loading="lazy" 
            decoding="async"
          />
          <div class="tile-overlay">
            <span class="tile-num">04</span>
            <div class="tile-meta">
              <h2>EOA 1597 Residence</h2>
              <p>Residential</p>
            </div>
          </div>
        </div>
      </a>

      <!-- Tile 5 -->
      <a href="/portfolio#sustainability" class="tile-card tile-5" data-bg="#E3DFD5">
        <div class="image-container">
          <Image 
            src={sustImg} 
            alt="Thermal Comfort Sustainability Project" 
            widths={[360, 720]} 
            sizes="(max-width: 768px) 90vw, 400px"
            quality={55} 
            loading="lazy" 
            decoding="async"
          />
          <div class="tile-overlay">
            <span class="tile-num">05</span>
            <div class="tile-meta">
              <h2>Thermal Comfort Study</h2>
              <p>Sustainability</p>
            </div>
          </div>
        </div>
      </a>

      <!-- Tile 6 -->
      <a href="/portfolio#rendering" class="tile-card tile-6" data-bg="#FAE870">
        <div class="image-container">
          <Image 
            src={renImg} 
            alt="Rendering and Video" 
            widths={[360, 720]} 
            sizes="(max-width: 768px) 90vw, 400px"
            quality={55} 
            loading="lazy" 
            decoding="async"
          />
          <div class="tile-overlay">
            <span class="tile-num">06</span>
            <div class="tile-meta">
              <h2>Elementum</h2>
              <p>Rendering and Videos</p>
            </div>
          </div>
        </div>
      </a>
    </section>
  </main>

  <!-- Responsive Centered Architectural Quote Banner -->
  <section class="quote-container">
    <div class="quote-inner">
      <blockquote class="quote-text">
        “The world is not as it seems, the world is as it is perceived”
      </blockquote>
      <cite class="quote-cite">
        — Warren Green
      </cite>
    </div>
  </section>

  <!-- MoodGrid Component -->
  <MoodGrid />

  <!-- Home Footer Component -->
  <HomeFooter />
</Layout>

<!-- Isolated Global Lock Styles -->
<style is:global>
  html.home-preloader-locked,
  html.home-preloader-locked body {
    overflow: hidden !important;
    overflow-y: hidden !important;
    height: 100vh !important;
    max-height: 100vh !important;
    touch-action: none !important;
    overscroll-behavior: none !important;
  }

  html.home-preloader-locked::-webkit-scrollbar,
  html.home-preloader-locked body::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
  }
</style>

<style>
  .hero-heading {
    font-family: 'Bank Gothic', sans-serif;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  :global(html) {
    background-color: #2D3239;
  }

  :global(body) {
    background-color: #2D3239;
    color: #FFFFFF;
    transition: background-color 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    margin: 0;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .main-wrapper {
    display: flex;
    flex-direction: column;
    max-width: 1400px;
    margin: 0 auto;
    padding: 120px 24px 80px;
    gap: 40px;
    background-color: transparent;
  }

  @media (min-width: 900px) {
    .main-wrapper {
      flex-direction: row;
      gap: 60px;
    }
  }

  /* Left Sticky Box Container */
  .left-sticky-col {
    width: 100%;
    padding: 32px;
    border-radius: 8px;
    box-sizing: border-box;
    background-color: #2D3239;
    isolation: isolate;
    position: relative;
    z-index: 2;
  }

  /* Target the project list titles specifically */
.project-list-item,
.project-list-item a,
.project-list-title {
  font-family: 'Bank Gothic', 'BankGothic', sans-serif !important;
  text-transform: uppercase !important;
  letter-spacing: 1.5px;
}

  @media (min-width: 900px) {
    .left-sticky-col {
      width: 40%;
      position: sticky;
      top: 140px;
      height: fit-content;
    }
  }

  .subtitle {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: 0.85rem;
    letter-spacing: 2px;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .headline {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: 2.2rem;
    line-height: 1.2;
    margin-bottom: 24px;
  }

  .philosophy {
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 40px;
  }

  .index-legend {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .legend-item {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: 0.9rem;
    letter-spacing: 1px;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .legend-num {
    margin-right: 12px;
    font-weight: bold;
  }

  .legend-item.active,
  .legend-item.active .legend-num {
    font-weight: 900;
    color: #FFFFFF !important;
  }

  /* Right Staggered Grid Column */
  .right-grid-col {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  @media (min-width: 900px) {
    .right-grid-col {
      width: 60%;
      position: relative;
      display: block;
      height: 1720px;
    }
  }

  .tile-card {
    display: block;
    text-decoration: none;
    color: #FFFFFF;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(0, 0, 0, 0.4);
    overflow: hidden;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .tile-card:hover {
    transform: scale(1.02);
    z-index: 10;
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  }

  .image-container {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .tile-card:hover img {
    transform: scale(1.05);
  }

  .tile-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.2) 60%, rgba(0,0,0,0.4) 100%);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
    color: #FFFFFF;
  }

  .tile-num {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: 1.1rem;
    font-weight: bold;
    letter-spacing: 1px;
    color: #FFFFFF;
  }

  .tile-meta h2 {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: 1.3rem;
    color: #FFFFFF;
    margin: 0 0 4px 0;
    font-weight: 700;
  }

  .tile-meta p {
    font-size: 0.85rem;
    margin: 0;
    color: #FFFFFF;
  }

  /* Desktop Staggered Overlay Absolute Positions */
  @media (min-width: 900px) {
    .tile-card {
      position: absolute;
      width: 50%;
    }

    .tile-1 { top: 0; left: 10%; z-index: 1; }
    .tile-2 { top: 220px; left: 45%; z-index: 2; }
    .tile-3 { top: 500px; left: 25%; z-index: 3; }
    .tile-4 { top: 760px; left: 5%; z-index: 4; }
    .tile-5 { top: 980px; left: 42%; z-index: 5; }
    .tile-6 { top: 1240px; left: 18%; z-index: 6; }
  }

  /* Base Quote Container Styles */
  .quote-container {
    width: 100%;
    min-height: 350px;
    padding: 80px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    box-sizing: border-box;
    background-color: #E3DFD5;
    color: #D9DDDC;
  }

  .quote-inner {
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
  }

  .quote-text {
    font-size: clamp(24px, 5vw, 50px);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.15;
    letter-spacing: -1px;
    margin: 0 0 20px 0;
    font-family: inherit;
    word-break: normal;
    overflow-wrap: break-word;
    color: #111111;
  }

  .quote-cite {
    display: block;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-style: normal;
    color: #111111;
  }

  /* Mobile Tweaks */
  @media (max-width: 899px) {
    .main-wrapper {
      padding: 100px 16px 60px;
    }

    .left-sticky-col {
      padding: 24px 18px;
      background-color: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 6px;
      width: 100%;
      box-sizing: border-box;
    }

    .headline {
      font-size: 2.05rem !important;
      letter-spacing: -0.5px !important;
      line-height: 1.25;
      word-break: break-word;
    }

    .quote-container {
      padding: 40px 16px;
      overflow: hidden;
    }
    
    .quote-inner {
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
      padding: 0;
    }

    .quote-text {
      font-size: clamp(1.15rem, 5.5vw, 1.4rem);
      line-height: 1.35;
      letter-spacing: 0px;
      text-align: center;
      margin: 0 auto 16px auto;
      width: 100%;
      display: block;
    }

    .quote-cite {
      font-size: 0.75rem;
      letter-spacing: 0.25em;
      text-align: center;
      margin: 0 auto;
      width: 100%;
      display: block;
    }
  }
</style>

<script>
  const unlockHomePreloader = () => {
    document.documentElement.classList.remove('home-preloader-locked');
    document.body.classList.remove('home-preloader-locked');
    document.documentElement.style.overflow = '';
    document.body.style.overflow = '';
    document.body.style.position = '';
    document.body.style.touchAction = '';
  };

  window.addEventListener('pageshow', unlockHomePreloader);
  window.addEventListener('load', () => setTimeout(unlockHomePreloader, 800), { once: true });
  setTimeout(unlockHomePreloader, 1500);
  window.addEventListener('preloader:complete', unlockHomePreloader, { once: true });

  const tiles = document.querySelectorAll('.tile-card');
  const legendItems = document.querySelectorAll('.legend-item');

  const observerOptions = {
    root: null,
    rootMargin: '-30% 0px -30% 0px',
    threshold: 0.2
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const target = entry.target as HTMLElement;
        const bg = target.dataset.bg;

        if (bg) {
          document.body.style.backgroundColor = bg;
        }

        const tileIndex = Array.from(tiles).indexOf(target);
        legendItems.forEach((item, idx) => {
          if (idx === tileIndex) {
            item.classList.add('active');
            (item as HTMLElement).style.setProperty('color', '#FFFFFF', 'important');
          } else {
            item.classList.remove('active');
            (item as HTMLElement).style.setProperty('color', '#D9DDDC', 'important');
          }
        });
      }
    });
  }, observerOptions);

  tiles.forEach((tile) => observer.observe(tile));

  // Navigation Menu Handler
  function initMenuToggle() {
    const hamburgerBtn = document.querySelector('.hamburger-btn') || document.getElementById('hero-hamburger');
    const overlay = document.getElementById('menu-overlay') || document.querySelector('.menu-overlay');

    if (!hamburgerBtn) return;

    hamburgerBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();

      const overlayEl = overlay || document.getElementById('menu-overlay') || document.querySelector('.menu-overlay');
      if (overlayEl) {
        const isActive = overlayEl.classList.contains('active');
        if (isActive) {
          overlayEl.classList.remove('active');
          hamburgerBtn.setAttribute('aria-expanded', 'false');
          document.body.classList.remove('menu-open');
          document.body.style.overflow = '';
        } else {
          overlayEl.classList.add('active');
          hamburgerBtn.setAttribute('aria-expanded', 'true');
          document.body.classList.add('menu-open');
          document.body.style.overflow = 'hidden';
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMenuToggle);
  } else {
    initMenuToggle();
  }

  document.addEventListener('astro:page-load', initMenuToggle);
</script>