---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import MenuOverlay from '../components/MenuOverlay.astro';
import Preloader from '../components/Preloader.astro';
import { Image } from 'astro:assets';

// Hero Background & Logo Imports
import heroBgImage from '../assets/hero-home.avif';
import logoImg from '../assets/facet-logo-white.avif';

// Commercial Imports
import commEmeraldResort from '../assets/comm-emerald-resort-hotel.avif';
import commCarsCoZa from '../assets/comm-cars-co-za.avif';
import commEcoCityStudRes from '../assets/comm-eco-city-sudent-res.avif';

// Development Imports
import devHabitatAlpha from '../assets/dev-habitat-alpha.avif';
import devElementum from '../assets/dev-elementum.avif';
import devSaronaCityPlan from '../assets/dev-sarona-city-master-plan.avif';

// Interior Imports
import intNdlovu from '../assets/int-ndlovu.avif';
import intCrestron from '../assets/int-crestron.avif';
import intCabanossi from '../assets/int-cabanossi.avif';

// Residential Imports
import resEoa1597 from '../assets/res-eoa-1597.avif';
import resThornValley from '../assets/res-thorn-valley.avif';
import resCopperleaf from '../assets/res-copperleaf.avif';

// Sustainability & Rendering Imports
import sustThermalComfort from '../assets/sustainability-thermal-comfort.avif';
import renImg from '../assets/renvid-elementum.jpg';

const categories = [
  {
    id: 'commercial',
    title: 'COMMERCIAL',
    num: '01',
    description: 'Corporate headquarters, retail centers, and educational facilities built for function and identity.',
    featured: [
      { name: 'EMERALD RESORT HOTEL', img: commEmeraldResort },
      { name: 'CARS.CO.ZA HEADQUARTERS', img: commCarsCoZa },
      { name: 'ECO CITY STUDENT RESIDENCE', img: commEcoCityStudRes }
    ]
  },
  {
    id: 'development',
    title: 'DEVELOPMENTS',
    num: '02',
    description: 'High-density residential estates, urban master plans, and mixed-use precincts across Africa.',
    featured: [
      { name: 'HABITAT ALPHA', img: devHabitatAlpha },
      { name: 'ELEMENTUM APARTMENTS', img: devElementum },
      { name: 'SARONA CITY MASTER PLAN', img: devSaronaCityPlan }
    ]
  },
  {
    id: 'interiors',
    title: 'INTERIORS',
    num: '03',
    description: 'Bespoke interior architecture, custom joinery, and tailored spatial flows for luxury living.',
    featured: [
      { name: 'NDLOVU RESIDENCE INTERIOR', img: intNdlovu },
      { name: 'CRESTRON EXPERIENCE CENTRE', img: intCrestron },
      { name: 'CABANOSSI RESIDENTIAL SUITE', img: intCabanossi }
    ]
  },
  {
    id: 'residential',
    title: 'RESIDENTIAL',
    num: '04',
    description: 'Custom private homes designed to harmonize with their surrounding landscape and climate.',
    featured: [
      { name: 'EOA 1597 RESIDENCE', img: resEoa1597 },
      { name: 'THORN VALLEY ESTATE', img: resThornValley },
      { name: 'COPPERLEAF LUXURY VILLA', img: resCopperleaf }
    ]
  },
  {
    id: 'sustainability',
    title: 'SUSTAINABILITY',
    num: '05',
    description: 'Passive design strategies, energy modeling, and eco-responsive building technology.',
    featured: [
      { name: 'THERMAL COMFORT ANALYSIS', img: sustThermalComfort }
    ]
  },
  {
    id: 'rendering',
    title: 'RENDERING',
    num: '06',
    description: 'High-fidelity 3D visualization, cinematic walkthroughs, and pre-construction marketing assets.',
    featured: [
      { name: 'ELEMENTUM 3D VISUALIZATION', img: renImg }
    ]
  }
];
---

<Layout title="Facet Architecture | Home">
  <Preloader />

  <!-- Fixed Top Bar & Navigation Header -->
  <header class="header-trigger-area" id="header-trigger-area">
    <div class="main-nav">
      <a href="/" class="logo-link" aria-label="Facet Architecture Home">
        <Image 
          src={logoImg} 
          alt="Facet Architecture Logo" 
          class="site-logo"
          loading="eager"
          decoding="sync"
        />
      </a>

      <!-- Hamburger Menu Button -->
      <button id="hero-hamburger" class="hamburger-btn" aria-label="Open Navigation Menu" aria-expanded="false">
        <span class="line line-1"></span>
        <span class="line line-2"></span>
        <span class="line line-3"></span>
      </button>
    </div>
  </header>

  <!-- Fullscreen Navigation Menu Drawer -->
  <MenuOverlay />

  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-bg-wrapper">
      <Image 
        src={heroBgImage} 
        alt="Facet Architecture Hero" 
        class="hero-bg-img"
        loading="eager"
        decoding="sync"
      />
      <div class="hero-overlay"></div>
    </div>

    <div class="hero-content">
      <p class="hero-tagline">FACET ARCHITECTURE</p>
      <h1 class="hero-title">PRECISION IN ARCHITECTURAL DESIGN</h1>
      <a href="/portfolio" class="hero-cta">VIEW PORTFOLIO</a>
    </div>
  </section>

  <!-- Discipline Category Overview Section -->
  <main class="overview-section">
    <div class="section-intro">
      <span class="section-sub">OUR DISCIPLINES</span>
      <h2 class="section-heading">ARCHITECTURAL DISCIPLINES</h2>
    </div>

    <div class="category-list">
      {categories.map((cat) => (
        <article class="category-block">
          <div class="category-header">
            <span class="cat-num">{cat.num}</span>
            <div class="cat-titles">
              <h3 class="cat-title">{cat.title}</h3>
              <p class="cat-desc">{cat.description}</p>
            </div>
            <a href={`/portfolio#${cat.id}`} class="cat-link">EXPLORE {cat.title} &rarr;</a>
          </div>

          <div class="featured-grid">
            {cat.featured.map((item) => (
              <a href={`/portfolio#${cat.id}`} class="featured-card">
                <div class="card-img-wrap">
                  <Image 
                    src={item.img} 
                    alt={item.name} 
                    class="card-img"
                    widths={[300, 500]}
                    sizes="(max-width: 768px) 100vw, 33vw"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="card-hover-overlay">
                    <span class="view-label">VIEW PROJECT</span>
                  </div>
                </div>
                <span class="card-title">{item.name}</span>
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  :global(body) {
    background-color: #2e343b;
    color: #ffffff;
    margin: 0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Fixed Header Bar */
  .header-trigger-area {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    z-index: 2147483646 !important;
    background-color: #2e343b;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-sizing: border-box;
    pointer-events: auto !important;
  }

  .main-nav {
    max-width: 1800px;
    margin: 0 auto;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
    box-sizing: border-box;
    pointer-events: auto !important;
  }

  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    height: 100%;
    pointer-events: auto !important;
  }

  .site-logo {
    height: 175px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  /* Hamburger Toggle Button */
  .hamburger-btn {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 32px;
    height: 22px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 2147483647 !important;
    pointer-events: auto !important;
  }

  .line {
    width: 100%;
    height: 2px;
    background-color: #ffffff;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .hamburger-btn[aria-expanded="true"] .line-1 {
    transform: translateY(10px) rotate(45deg);
  }

  .hamburger-btn[aria-expanded="true"] .line-2 {
    opacity: 0;
  }

  .hamburger-btn[aria-expanded="true"] .line-3 {
    transform: translateY(-10px) rotate(-45deg);
  }

  /* Hero Section */
  .hero-section {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 120px;
    box-sizing: border-box;
  }

  .hero-bg-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 24px;
    max-width: 900px;
  }

  .hero-tagline {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: clamp(0.85rem, 1.5vw, 1.1rem);
    letter-spacing: 3px;
    opacity: 0.8;
    margin-bottom: 12px;
  }

  .hero-title {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.1;
    margin: 0 0 28px 0;
    color: #ffffff;
  }

  .hero-cta {
    display: inline-block;
    padding: 14px 32px;
    border: 1px solid #00ffc8;
    color: #00ffc8;
    text-decoration: none;
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: 0.9rem;
    letter-spacing: 2px;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .hero-cta:hover {
    background-color: #00ffc8;
    color: #111111;
  }

  /* Disciplines Section */
  .overview-section {
    max-width: 1400px;
    margin: 0 auto;
    padding: 100px 24px;
  }

  .section-intro {
    margin-bottom: 60px;
  }

  .section-sub {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: 0.85rem;
    letter-spacing: 2px;
    opacity: 0.6;
    display: block;
    margin-bottom: 8px;
  }

  .section-heading {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin: 0;
    color: #ffffff;
  }

  .category-list {
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  .category-block {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 40px;
  }

  .category-header {
    display: flex;
    align-items: flex-start;
    gap: 32px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .cat-num {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: 1.2rem;
    color: #00ffc8;
    font-weight: bold;
  }

  .cat-titles {
    flex: 1;
    min-width: 260px;
  }

  .cat-title {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: 1.6rem;
    margin: 0 0 8px 0;
    color: #ffffff;
  }

  .cat-desc {
    font-size: 0.95rem;
    opacity: 0.75;
    margin: 0;
    line-height: 1.5;
  }

  .cat-link {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: 0.85rem;
    color: #00ffc8;
    text-decoration: none;
    letter-spacing: 1.5px;
    white-space: nowrap;
    transition: opacity 0.3s ease;
  }

  .cat-link:hover {
    opacity: 0.7;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  .featured-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: #000000;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .card-hover-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .view-label {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: 0.8rem;
    color: #00ffc8;
    letter-spacing: 2px;
    border: 1px solid #00ffc8;
    padding: 8px 16px;
  }

  .featured-card:hover .card-img {
    transform: scale(1.05);
  }

  .featured-card:hover .card-hover-overlay {
    opacity: 1;
  }

  .card-title {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: 0.85rem;
    letter-spacing: 1px;
    opacity: 0.9;
  }

  @media (max-width: 899px) {
    .main-nav {
      padding: 0 20px;
      height: 90px;
    }

    .site-logo {
      height: 45px;
    }

    .hero-section {
      padding-top: 90px;
    }

    .category-header {
      flex-direction: column;
      gap: 16px;
    }
  }
</style>

<script>
  function bindHomepageMenu() {
    const heroBtn = document.getElementById('hero-hamburger');
    const overlay = document.getElementById('menu-overlay');

    if (!heroBtn) return;

    heroBtn.onclick = (e) => {
      e.preventDefault();
      e.stopPropagation();

      const overlayEl = overlay || document.getElementById('menu-overlay');
      if (overlayEl) {
        const isActive = overlayEl.classList.contains('active');
        if (isActive) {
          overlayEl.classList.remove('active');
          heroBtn.setAttribute('aria-expanded', 'false');
          document.body.classList.remove('menu-open');
          document.body.style.overflow = '';
        } else {
          overlayEl.classList.add('active');
          heroBtn.setAttribute('aria-expanded', 'true');
          document.body.classList.add('menu-open');
          document.body.style.overflow = 'hidden';
        }
      }
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindHomepageMenu);
  } else {
    bindHomepageMenu();
  }

  document.addEventListener('astro:page-load', bindHomepageMenu);
</script>