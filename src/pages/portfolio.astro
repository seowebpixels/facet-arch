---

<Layout title="Facet Architecture | Portfolio Matrix">
  <Header />

  <!-- Category Navigation Bar -->
  <nav class="portfolio-nav">
    <div class="nav-track">
      {portfolioData.map((cat, idx) => (
        <button class={`nav-btn ${idx === 0 ? 'active' : ''}`} data-category={cat.id}>
          <span class="nav-num">{cat.num}</span>
          <span class="nav-title">{cat.title}</span>
        </button>
      ))}
    </div>
  </nav>

  <!-- Dynamic Category Rail Display -->
  <main class="portfolio-stage">
    {portfolioData.map((cat, idx) => (
      <section class={`category-panel ${idx === 0 ? 'active' : ''}`} id={`panel-${cat.id}`}>
        <div class="panel-header">
          <span class="panel-num">{cat.num} // ARCHITECTURAL CATEGORY</span>
          <h2 class="panel-title">{cat.title}</h2>
        </div>

        <!-- Horizontal Scroll Track -->
        <div class="scroll-rail">
          {cat.items.map((item) => (
            <div class="portfolio-card cad-trigger" data-fullsrc={item.img} data-caption={item.name}>
              <div class="card-frame">
                <div class="card-image-layer" style={`background-image: url('${item.img}');`}></div>
                <div class="card-shield"></div>
                <div class="cad-grid-layer"></div>
              </div>
              <div class="card-caption">
                <h3>{item.name}</h3>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </main>

  <div class="portfolio-spacer-gap"></div>

  <footer class="home-matched-footer">
    <div class="cta-section">
      <div class="cta-content">
        <div class="cta-text">
          <span class="cta-sub">NEXT STEPS</span>
          <h2 class="cta-heading">HAVE A PROJECT IN MIND?</h2>
        </div>
        <div class="cta-action">
          <a href="/contact" class="cta-btn">INITIATE CONSULTATION &rarr;</a>
        </div>
      </div>
    </div>

    <div class="footer-divider"></div>

    <div class="footer-base">
      <p class="footer-line copyright-line">© {currentYear} FACET ARCHITECTURE</p>
      <p class="footer-line rights-line">ALL RIGHTS RESERVED</p>
      <p class="footer-line credits-line">
        DESIGNED BY&nbsp;<a 
          href="https://webdesignpros.co.za" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="wdp-link"
        >WEB DESIGN PROS</a>
      </p>
    </div>
  </footer>

  <!-- Fixed Lightbox Modal Structure -->
  <div id="lightbox-modal" class="lightbox-modal">
    <button class="lightbox-close" id="lightbox-close">&times; CLOSE</button>
    <div class="lightbox-content">
      <div id="lightbox-img-layer" class="lightbox-img-layer"></div>
      <div class="lightbox-shield"></div>
    </div>
    <p id="lightbox-caption" class="lightbox-caption"></p>
  </div>
</Layout>

<style>
  :global(html) {
    overflow-x: hidden;
    overflow-y: auto !important;
    height: auto !important;
  }

  :global(body) {
    background-color: #111111;
    color: #ffffff;
    margin: 0;
    overflow-x: hidden;
    overflow-y: auto !important;
    height: auto !important;
    position: relative !important;
    -webkit-touch-callout: none !important;
    -webkit-user-select: none !important;
    user-select: none !important;
  }

  .portfolio-nav {
    position: fixed;
    top: 90px;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: 12px 24px;
    background: rgba(17, 17, 17, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .nav-track {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    gap: 28px;
    max-width: 1400px;
    margin: 0 auto;
    padding-bottom: 8px;
    scrollbar-width: auto;
    scrollbar-color: #00ffc8 rgba(255, 255, 255, 0.12);
  }

  .nav-track::-webkit-scrollbar {
    height: 14px;
    display: block !important;
  }

  .nav-track::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
  }

  .nav-track::-webkit-scrollbar-thumb {
    background: #00ffc8;
    border-radius: 4px;
    box-shadow: 0 0 10px rgba(0, 255, 200, 0.5);
  }

  .nav-btn {
    position: relative;
    background: none;
    border: none;
    color: #ffffff;
    font-family: 'BankGothic', sans-serif, system-ui;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 0.4s ease, color 0.4s ease;
    padding: 6px 0 10px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-btn::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #00ffc8;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .nav-btn:hover, .nav-btn.active {
    opacity: 1;
    color: #00ffc8;
  }

  .nav-btn.active::after,
  .nav-btn:hover::after {
    transform: scaleX(1);
  }

  .nav-num {
    font-size: 0.8rem;
    color: #bf6363;
    font-weight: bold;
  }

  .nav-title {
    font-size: 0.85rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .portfolio-stage {
    padding-top: 160px;
    min-height: auto;
  }

  .category-panel {
    display: none;
    padding: 20px 24px 30px;
  }

  .category-panel.active {
    display: block;
  }

  .panel-header {
    margin-bottom: 20px;
  }

  .panel-num {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .panel-title {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: clamp(1.8rem, 6vw, 2.8rem);
    text-transform: uppercase;
    margin: 4px 0 0;
    color: #ffffff;
    line-height: 1.1;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .scroll-rail {
    display: flex;
    gap: 24px;
    overflow-x: scroll;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 24px;
    scroll-behavior: smooth;
    scrollbar-width: auto;
    scrollbar-color: #00ffc8 rgba(255, 255, 255, 0.12);
  }

  .scroll-rail::-webkit-scrollbar {
    height: 14px;
    display: block !important;
  }

  .scroll-rail::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
  }

  .scroll-rail::-webkit-scrollbar-thumb {
    background: #00ffc8;
    border-radius: 4px;
    box-shadow: 0 0 10px rgba(0, 255, 200, 0.5);
  }

  .portfolio-card {
    flex: 0 0 auto;
    width: 320px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .portfolio-card {
      width: 440px;
    }
  }

  .card-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(255, 255, 255, 0.2);
    overflow: hidden;
    background-color: #000000;
  }

  .card-image-layer {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    filter: grayscale(100%) contrast(110%);
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), filter 0.6s ease;
  }

  .card-shield {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: transparent;
  }

  .card-caption h3 {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: 0.95rem;
    color: #ffffff;
    margin: 0;
    text-transform: uppercase;
  }

  .cad-grid-layer {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: radial-gradient(circle, rgba(0,255,200,0.08) 1px, transparent 1px);
    background-size: 18px 18px;
    opacity: 1;
    transition: opacity 0.4s ease;
    pointer-events: none;
    border: 1px solid rgba(0, 255, 200, 0.2);
  }

  .cad-trigger:hover .card-image-layer {
    transform: scale(1.04);
    filter: grayscale(0%) contrast(100%);
  }

  .cad-trigger:hover .cad-grid-layer {
    opacity: 0;
  }

  .portfolio-spacer-gap {
    height: 40px;
    background-color: #2a2f35;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .home-matched-footer {
    background-color: #2e343b;
    color: #ffffff;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif !important;
    padding: 40px 24px 60px;
    box-sizing: border-box;
    width: 100%;
    position: relative;
    z-index: 10;
    margin-bottom: 20px;
  }

  .cta-section {
    max-width: 1400px;
    margin: 0 auto;
    padding-bottom: 32px;
  }

  .cta-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .cta-sub {
    display: block;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif !important;
    font-size: 0.65rem;
    color: #94a3b8;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 10px;
    font-weight: 400;
  }

  .cta-heading {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif !important;
    font-size: 1.3rem;
    color: #e2e8f0;
    font-weight: 300;
    letter-spacing: 2px;
    margin: 0;
    text-transform: uppercase;
  }

  .cta-btn {
    display: inline-block;
    padding: 10px 22px;
    border: 1px solid #ffffff !important;
    background-color: transparent;
    color: #ffffff;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif !important;
    font-size: 0.7rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  .cta-btn:hover {
    background-color: #ffffff;
    color: #000000;
  }

  .footer-divider {
    max-width: 1400px;
    margin: 0 auto 24px;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.15);
  }

  .footer-base {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.65rem;
    color: #94a3b8;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }

  .footer-line {
    margin: 0;
  }

  .wdp-link {
    color: #94a3b8;
    font-weight: 400;
    text-decoration: none;
    transition: color 0.2s ease, font-weight 0.2s ease, text-shadow 0.2s ease;
  }

  .wdp-link:hover {
    color: #ffffff !important;
    font-weight: 700 !important;
    text-shadow: 0 0 1px #ffffff;
  }

  /* MOBILE SPECIFIC OVERRIDES (< 899px) */
  @media (max-width: 899px) {
    .portfolio-stage {
      padding-top: 155px;
    }

    /* 1 & 3. Persistent 14px Scrollbar on Menu Row */
    .nav-track {
      scrollbar-width: thin !important;
      scrollbar-color: #00ffc8 rgba(255, 255, 255, 0.12) !important;
      padding-bottom: 12px !important;
      -webkit-overflow-scrolling: touch;
    }

    .nav-track::-webkit-scrollbar {
      height: 14px !important;
      display: block !important;
      -webkit-appearance: none;
    }

    .nav-track::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.12) !important;
      border-radius: 4px !important;
    }

    .nav-track::-webkit-scrollbar-thumb {
      background: #00ffc8 !important;
      border-radius: 4px !important;
      box-shadow: 0 0 8px rgba(0, 255, 200, 0.6) !important;
      min-width: 40px !important;
    }

    /* 2 & 3. Persistent Matched 14px Scrollbar on Image Rail */
    .scroll-rail {
      scrollbar-width: thin !important;
      scrollbar-color: #00ffc8 rgba(255, 255, 255, 0.12) !important;
      padding-bottom: 20px !important;
      -webkit-overflow-scrolling: touch;
    }

    .scroll-rail::-webkit-scrollbar {
      height: 14px !important;
      display: block !important;
      -webkit-appearance: none;
    }

    .scroll-rail::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.12) !important;
      border-radius: 4px !important;
    }

    .scroll-rail::-webkit-scrollbar-thumb {
      background: #00ffc8 !important;
      border-radius: 4px !important;
      box-shadow: 0 0 8px rgba(0, 255, 200, 0.6) !important;
      min-width: 40px !important;
    }

    /* 4. Complete Footer Visibility & Untruncated Layout */
    .home-matched-footer {
      padding: 40px 24px 80px !important;
      margin-bottom: 40px !important;
    }

    .cta-content {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 20px !important;
    }

    .cta-text {
      width: 100% !important;
    }

    .cta-heading {
      font-size: clamp(1rem, 4.8vw, 1.3rem) !important;
      white-space: nowrap !important;
      letter-spacing: 1.5px !important;
      line-height: 1.2 !important;
    }

    .cta-action {
      width: 100% !important;
    }

    .cta-btn {
      display: block !important;
      width: 100% !important;
      text-align: center !important;
      box-sizing: border-box !important;
      padding: 12px 16px !important;
      font-size: 0.7rem !important;
      letter-spacing: 2px !important;
    }

    .footer-base {
      flex-direction: column !important;
      align-items: center !important;
      text-align: center !important;
      gap: 0 !important;
    }

    .footer-line {
      white-space: nowrap !important;
      line-height: 1.6 !important;
    }

    .credits-line {
      margin-top: 1rem !important;
    }
  }

  /* Lightbox Styles */
  .lightbox-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.94);
    backdrop-filter: blur(12px);
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 24px;
  }

  .lightbox-modal.active {
    display: flex;
  }

  .lightbox-close {
    position: absolute;
    top: 24px;
    right: 24px;
    background: none;
    border: 1px solid #00ffc8;
    color: #00ffc8;
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: 0.85rem;
    padding: 6px 14px;
    cursor: pointer;
    text-transform: uppercase;
    z-index: 1010;
  }

  .lightbox-content {
    position: relative;
    width: 85vw;
    height: 70vh;
    display: block;
    box-sizing: border-box;
  }

  .lightbox-img-layer {
    width: 100%;
    height: 100%;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .lightbox-shield {
    position: absolute;
    inset: 0;
    z-index: 1005;
    background: transparent;
  }

  .lightbox-caption {
    font-family: 'BankGothic', sans-serif, system-ui;
    color: #ffffff;
    font-size: 1.1rem;
    margin-top: 18px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-align: center;
  }
</style>

<script>
  const navBtns = document.querySelectorAll('.nav-btn');
  const panels = document.querySelectorAll('.category-panel');

  // Clear potential leftover scroll lock classes on page load
  document.documentElement.style.overflow = '';
  document.documentElement.style.height = '';
  document.body.style.overflow = '';
  document.body.style.height = '';
  document.body.style.position = '';

  // Function to switch active category panel
  function activateCategory(catId: string) {
    const targetBtn = document.querySelector(`.nav-btn[data-category="${catId}"]`);
    const targetPanel = document.getElementById(`panel-${catId}`);

    if (targetBtn && targetPanel) {
      navBtns.forEach((b) => b.classList.remove('active'));
      panels.forEach((p) => p.classList.remove('active'));

      targetBtn.classList.add('active');
      targetPanel.classList.add('active');
    }
  }

  // 1. Check URL Hash on Initial Page Load (e.g. /portfolio#interiors)
  const currentHash = window.location.hash.replace('#', '');
  if (currentHash) {
    activateCategory(currentHash);
  }

  // 2. Navigation Button Click Handler
  navBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetCat = btn.getAttribute('data-category');
      if (targetCat) {
        activateCategory(targetCat);
        history.replaceState(null, '', `#${targetCat}`);
      }
    });
  });

  // 3. Lightbox Expansion Logic
  const modal = document.getElementById('lightbox-modal');
  const modalImgLayer = document.getElementById('lightbox-img-layer') as HTMLElement;
  const modalCaption = document.getElementById('lightbox-caption');
  const modalClose = document.getElementById('lightbox-close');

  const cards = document.querySelectorAll('.portfolio-card');
  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const fullSrc = card.getAttribute('data-fullsrc');
      const caption = card.getAttribute('data-caption');

      if (modal && modalImgLayer && modalCaption && fullSrc) {
        modalImgLayer.style.backgroundImage = `url('${fullSrc}')`;
        modalCaption.textContent = caption || '';
        modal.classList.add('active');
      }
    });
  });

  if (modalClose && modal) {
    modalClose.addEventListener('click', () => {
      modal.classList.remove('active');
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.remove('active');
      }
    });
  }

  // Intercept Page Save Shortcuts (Ctrl+S / Cmd+S / Ctrl+U)
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && (e.key === 's' || e.key === 'S' || e.key === 'u' || e.key === 'U')) {
      e.preventDefault();
    }
  });

  // Disable Right-Click Context Menu globally
  document.addEventListener('contextmenu', (e) => {
    e.preventDefault();
  });
</script>
