---

<Layout title="Facet Architecture | Portfolio Matrix">
  <Header />

  <!-- Category Navigation Bar -->
  <nav class="portfolio-nav">
    <div class="nav-track scroll-container">
      {portfolioData.map((cat, idx) => (
        <button class={`nav-btn ${idx === 0 ? 'active' : ''}`} data-category={cat.id}>
          <span class="nav-num">{cat.num}</span>
          <span class="nav-title">{cat.title}</span>
        </button>
      ))}
    </div>
  </nav>

  <!-- Dynamic Category Rail Display -->
  <main class="portfolio-stage">
    {portfolioData.map((cat, idx) => (
      <section class={`category-panel ${idx === 0 ? 'active' : ''}`} id={`panel-${cat.id}`}>
        <div class="panel-header">
          <span class="panel-num">{cat.num} // ARCHITECTURAL CATEGORY</span>
          <h2 class="panel-title">{cat.title}</h2>
        </div>

        <!-- Horizontal Scroll Track -->
        <div class="scroll-rail-wrapper">
          <div class="scroll-rail scroll-container">
            {cat.items.map((item, itemIdx) => (
              <div class="portfolio-card cad-trigger" data-fullsrc={item.img.src} data-caption={item.name} data-index={itemIdx}>
                <div class="card-frame">
                  <Image 
                    src={item.img} 
                    alt={item.name} 
                    class="card-image-layer" 
                    widths={[320, 640, 900]}
                    sizes="(max-width: 768px) 320px, (max-width: 1024px) 50vw, 33vw"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="card-shield"></div>
                  <div class="cad-grid-layer"></div>
                </div>
                <div class="card-caption">
                  <h3>{item.name}</h3>
                </div>
              </div>
            ))}
          </div>
          <div class="custom-scrollbar-track mobile-only-indicator">
            <div class="custom-scrollbar-thumb"></div>
          </div>
        </div>
      </section>
    ))}
  </main>

  <div class="portfolio-spacer-gap"></div>

  <!-- Shared Reusable Footer Component -->
  <Footer />

  <!-- Lightbox Modal Structure -->
  <div id="lightbox-modal" class="lightbox-modal">
    <button class="lightbox-close" id="lightbox-close">&times; CLOSE</button>
    <button class="lightbox-arrow prev" id="lightbox-prev">&lt;</button>
    <button class="lightbox-arrow next" id="lightbox-next">&gt;</button>

    <div class="lightbox-content">
      <div id="lightbox-img-layer" class="lightbox-img-layer"></div>
      <div class="lightbox-shield"></div>
    </div>
    <p id="lightbox-caption" class="lightbox-caption"></p>
  </div>
</Layout>

<style>
  :global(html) {
    background-color: #111111;
    color: #ffffff;
    margin: 0;
    padding: 0;
    min-height: 100%;
    height: auto !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
  }

  :global(body) {
    background-color: #111111;
    color: #ffffff;
    margin: 0;
    padding: 0;
    min-height: 100vh;
    height: auto !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    -webkit-touch-callout: none !important;
    -webkit-user-select: none !important;
    user-select: none !important;
  }

  .scroll-container {
    overflow-x: auto !important;
    overflow-y: hidden !important;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x;
  }

  /* Desktop Explicit Scrollbar Styling */
  .scroll-rail::-webkit-scrollbar,
  .nav-track::-webkit-scrollbar {
    height: 10px !important;
    display: block !important;
  }

  .scroll-rail::-webkit-scrollbar-track,
  .nav-track::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
  }

  .scroll-rail::-webkit-scrollbar-thumb,
  .nav-track::-webkit-scrollbar-thumb {
    background: #00ffc8;
    border-radius: 4px;
    box-shadow: 0 0 8px rgba(0, 255, 200, 0.5);
  }

  .scroll-rail,
  .nav-track {
    scrollbar-width: thin !important;
    scrollbar-color: #00ffc8 rgba(255, 255, 255, 0.1) !important;
  }

 /* Fixed Navigation Position */
.portfolio-nav {
  position: fixed;
  top: 120px; /* Increased from 100px to push below main menu */
  left: 0;
  width: 100%;
  z-index: 100;
  padding: 12px 24px;
  background: rgba(17, 17, 17, 0.95);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  box-sizing: border-box;
}

  .nav-track {
    display: flex;
    flex-wrap: nowrap;
    gap: 28px;
    max-width: 1400px;
    margin: 0 auto;
    padding-bottom: 8px;
  }

  .nav-btn {
    position: relative;
    background: none;
    border: none;
    color: #ffffff;
    font-family: 'BankGothic', sans-serif, system-ui;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 0.4s ease, color 0.4s ease;
    padding: 6px 0 10px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-btn::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #00ffc8;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .nav-btn:hover, .nav-btn.active {
    opacity: 1;
    color: #00ffc8;
  }

  .nav-btn.active::after,
  .nav-btn:hover::after {
    transform: scaleX(1);
  }

  .nav-num {
    font-size: 0.8rem;
    color: #bf6363;
    font-weight: bold;
  }

  .nav-title {
    font-size: 0.85rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .portfolio-stage {
  padding-top: 250px; /* Increased from 170px to give content breathing room */
  min-height: auto;
  height: auto !important;
  overflow: visible !important;
  position: relative;
}

  .category-panel {
    display: none;
    padding: 20px 24px 30px;
  }

  .category-panel.active {
    display: block;
  }

  .panel-header {
    margin-bottom: 20px;
  }

  .panel-num {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .panel-title {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: clamp(1.8rem, 6vw, 2.8rem);
    text-transform: uppercase;
    margin: 4px 0 0;
    color: #ffffff;
    line-height: 1.1;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .scroll-rail-wrapper {
    position: relative;
    width: 100%;
  }

  .scroll-rail {
    display: flex;
    gap: 24px;
    padding-bottom: 20px;
    scroll-behavior: smooth;
    overflow-x: scroll !important;
  }

  .portfolio-card {
    flex: 0 0 auto;
    width: 320px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .portfolio-card {
      width: 440px;
    }
  }

  .card-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(255, 255, 255, 0.2);
    overflow: hidden;
    background-color: #000000;
  }

  .card-image-layer {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: grayscale(100%) contrast(110%);
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), filter 0.6s ease;
    display: block;
  }

  .card-caption h3 {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: 0.95rem;
    color: #ffffff;
    margin: 0;
    text-transform: uppercase;
  }

  .cad-grid-layer {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: radial-gradient(circle, rgba(0,255,200,0.08) 1px, transparent 1px);
    background-size: 18px 18px;
    opacity: 1;
    transition: opacity 0.4s ease;
    pointer-events: none;
    border: 1px solid rgba(0, 255, 200, 0.2);
  }

  .cad-trigger:hover .card-image-layer {
    transform: scale(1.04);
    filter: grayscale(0%) contrast(100%);
  }

  .portfolio-spacer-gap {
    height: 40px;
    background-color: #2a2f35;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Lightbox Styling Updates */
  .lightbox-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.94);
    backdrop-filter: blur(12px);
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 24px;
  }

  .lightbox-modal.active {
    display: flex;
  }

  .lightbox-close {
    position: absolute;
    top: 150px;
    right: 32px;
    background: none;
    border: 1px solid #00ffc8;
    color: #00ffc8;
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: 0.85rem;
    padding: 6px 14px;
    cursor: pointer;
    text-transform: uppercase;
    z-index: 1010;
  }

  .lightbox-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid #00ffc8;
    color: #00ffc8;
    font-size: 1.5rem;
    padding: 12px 18px;
    cursor: pointer;
    z-index: 1010;
    transition: background 0.3s ease;
  }

  .lightbox-arrow:hover {
    background: #00ffc8;
    color: #111111;
  }

  .lightbox-arrow.prev {
    left: 24px;
  }

  .lightbox-arrow.next {
    right: 24px;
  }

  .lightbox-content {
    position: relative;
    width: 85vw;
    height: 70vh;
    display: block;
    box-sizing: border-box;
  }

  .lightbox-img-layer {
    width: 100%;
    height: 100%;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    border: none !important;
  }

  .lightbox-caption {
    font-family: 'BankGothic', sans-serif, system-ui;
    color: #ffffff;
    font-size: 1.1rem;
    margin-top: 18px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-align: center;
  }
</style>

<script>
  let currentCategoryCards: HTMLElement[] = [];
  let currentActiveIndex = 0;

  const modal = document.getElementById('lightbox-modal');
  const modalImgLayer = document.getElementById('lightbox-img-layer') as HTMLElement;
  const modalCaption = document.getElementById('lightbox-caption');
  const modalClose = document.getElementById('lightbox-close');
  const modalPrev = document.getElementById('lightbox-prev');
  const modalNext = document.getElementById('lightbox-next');

  // Activate Category Panel
  const navBtns = document.querySelectorAll('.nav-btn');
  const panels = document.querySelectorAll('.category-panel');

  function activateCategory(catId: string) {
    const targetBtn = document.querySelector(`.nav-btn[data-category="${catId}"]`);
    const targetPanel = document.getElementById(`panel-${catId}`);

    if (targetBtn && targetPanel) {
      navBtns.forEach((b) => b.classList.remove('active'));
      panels.forEach((p) => p.classList.remove('active'));

      targetBtn.classList.add('active');
      targetPanel.classList.add('active');

      currentCategoryCards = Array.from(targetPanel.querySelectorAll('.portfolio-card'));
    }
  }

  const currentHash = window.location.hash.replace('#', '');
  if (currentHash) {
    activateCategory(currentHash);
  } else {
    activateCategory('commercial');
  }

  navBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetCat = btn.getAttribute('data-category');
      if (targetCat) {
        activateCategory(targetCat);
        history.replaceState(null, '', `#${targetCat}`);
      }
    });
  });

  // Enable Sideways Wheel Scroll for Image Category Tracks
  document.querySelectorAll('.scroll-rail').forEach((rail) => {
    rail.addEventListener('wheel', (e) => {
      const wheelEvent = e as WheelEvent;
      if (wheelEvent.deltaY !== 0) {
        e.preventDefault();
        rail.scrollLeft += wheelEvent.deltaY;
      }
    }, { passive: false });
  });

  // Lightbox Navigation Functions
  function updateLightboxImage(index: number) {
    if (!currentCategoryCards.length) return;
    if (index < 0) index = currentCategoryCards.length - 1;
    if (index >= currentCategoryCards.length) index = 0;

    currentActiveIndex = index;
    const card = currentCategoryCards[currentActiveIndex];
    const fullSrc = card.getAttribute('data-fullsrc');
    const caption = card.getAttribute('data-caption');

    if (modalImgLayer && modalCaption && fullSrc) {
      modalImgLayer.style.backgroundImage = `url('${fullSrc}')`;
      modalCaption.textContent = caption || '';
    }
  }

  // Open Lightbox
  document.querySelectorAll('.category-panel').forEach((panel) => {
    const cards = panel.querySelectorAll('.portfolio-card');
    cards.forEach((card, idx) => {
      card.addEventListener('click', () => {
        currentCategoryCards = Array.from(cards) as HTMLElement[];
        currentActiveIndex = idx;
        updateLightboxImage(currentActiveIndex);
        if (modal) {
          modal.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      });
    });
  });

  const closeModal = () => {
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }
  };

  if (modalClose) modalClose.addEventListener('click', closeModal);
  if (modalPrev) modalPrev.addEventListener('click', () => updateLightboxImage(currentActiveIndex - 1));
  if (modalNext) modalNext.addEventListener('click', () => updateLightboxImage(currentActiveIndex + 1));

  // Global Key Down Handler (Esc -> Home Page, Arrow Keys -> Next/Prev Image)
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (modal && modal.classList.contains('active')) {
        closeModal();
      } else {
        window.location.href = '/';
      }
    } else if (modal && modal.classList.contains('active')) {
      if (e.key === 'ArrowRight') {
        updateLightboxImage(currentActiveIndex + 1);
      } else if (e.key === 'ArrowLeft') {
        updateLightboxImage(currentActiveIndex - 1);
      }
    }
  });
</script>