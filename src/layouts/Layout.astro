---
/* src/layouts/Layout.astro */
import Header from '../components/Header.astro';
import Clock from '../components/Clock.astro';
import '../styles/global.css';
import heroImg from '../assets/res-eoa-1597.avif';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "Facet Architecture | Spatial Design Studio", 
  description = "Architectural practice specializing in commercial, residential, development, interior, and sustainable projects.",
  image = "/og-image.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);

const { pathname } = Astro.url;
const isHomePage = pathname === '/' || pathname === '';
---

<!doctype html>
<html lang="en">
  <head>

    <!-- Google Tag Manager (Lazy Loaded) -->
<script is:inline>
  (function() {
    var gtmId = 'GTM-NB7RZJ26';
    var loaded = false;

    function loadGTM() {
      if (loaded) return;
      loaded = true;

      // Initialize dataLayer
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });

      // Inject GTM script element
      var script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
      document.head.appendChild(script);

      // Clean up event listeners once loaded
      events.forEach(function(event) {
        window.removeEventListener(event, loadGTM, { passive: true });
      });
    }

    var events = ['touchstart', 'mouseover', 'wheel', 'scroll', 'keydown'];
    events.forEach(function(event) {
      window.addEventListener(event, loadGTM, { passive: true });
    });

    // Fallback timer: load GTM after 4 seconds if no user interaction occurs
    setTimeout(loadGTM, 4000);
  })();
</script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://facetarchitecture.co.za" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <link
      rel="preload"
      href="/fonts/BankGothic.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <link
      rel="preload"
      as="image"
      href={heroImg.src}
      type="image/avif"
      fetchpriority="high"
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-NB7RZJ26"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->

    <Header />

    {/* Render the clock at top-left for inner pages */}
    {!isHomePage && <Clock />}
    
    <main>
      <slot />
    </main>

    <script>
      document.addEventListener('contextmenu', (e) => e.preventDefault());
      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && (e.key === 's' || e.key === 'S' || e.key === 'u' || e.key === 'U')) {
          e.preventDefault();
        }
      });
      document.addEventListener('dragstart', (e) => {
        if (e.target instanceof HTMLImageElement || e.target instanceof HTMLVideoElement) {
          e.preventDefault();
        }
      });
    </script>
  </body>
</html>

<style is:global>
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    height: auto !important;
    overflow-x: hidden;
    overflow-y: auto !important;
  }

  *, *::before, *::after {
    -webkit-touch-callout: none !important;
    -webkit-user-select: none !important;
    -moz-user-select: none !important;
    -ms-user-select: none !important;
    user-select: none !important;
  }

  img, video {
    -webkit-user-drag: none !important;
    -khtml-user-drag: none !important;
    -moz-user-drag: none !important;
    -o-user-drag: none !important;
    user-drag: none !important;
  }

  /* Re-enable interaction for links, form inputs, buttons, and navigation elements */
  a, button, input, textarea, select, .portfolio-card, .cad-trigger,
  .site-header, .menu-box, .menu-box *, .menu-overlay, .menu-overlay * {
    pointer-events: auto !important;
  }
</style>