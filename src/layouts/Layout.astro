---
/* src/layouts/Layout.astro */
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import MenuOverlay from '../components/MenuOverlay.astro'; // <--- Added Import
import Clock from '../components/Clock.astro';
import '../styles/global.css';
import heroImg from '../assets/res-eoa-1597.avif';
import heroLogoImg from '../assets/facet-hero-logo.avif';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "Facet Architecture | Spatial Design Studio", 
  description = "Architectural practice specializing in commercial, residential, development, interior, and sustainable projects.",
  image = "/og-image.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);

const { pathname } = Astro.url;
const isHomePage = pathname === '/' || pathname === '';

const preloadedLogo = await getImage({
  src: heroLogoImg,
  format: 'avif',
  width: 280,
  quality: 80
});
---

<!doctype html>
<html lang="en-GB">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function() {
        var gtmId = 'GTM-NB7RZJ26';
        var loaded = false;

        function loadGTM() {
          if (loaded) return;
          loaded = true;

          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });

          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
          document.head.appendChild(script);

          events.forEach(function(event) {
            window.removeEventListener(event, loadGTM, { passive: true });
          });
        }

        var events = ['pointerdown', 'touchstart', 'scroll', 'keydown'];
        events.forEach(function(event) {
          window.addEventListener(event, loadGTM, { passive: true });
        });
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://facetarchitecture.co.za" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <link 
      rel="preload" 
      as="image" 
      href={preloadedLogo.src}
      type="image/avif" 
      fetchpriority="high"
    />

    <link
      rel="preload"
      href="/fonts/BankGothic.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <link
      rel="preload"
      as="image"
      href={heroImg.src}
      type="image/avif"
      fetchpriority="high"
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />
  </head>
  <body>
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-NB7RZJ26"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>

    <Header />
    <MenuOverlay /> <!-- <--- Renders menu overlay on all pages -->

    {!isHomePage && <Clock />}
    
    <main>
      <slot />
    </main>

    <script>
      // Consolidated Menu Trigger Listener
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;

        const trigger = target.closest('#menu-toggle, #hero-hamburger, .mobile-toggle, .hamburger-btn, .menu-trigger');
        
        if (trigger) {
          e.preventDefault();
          const overlay = document.getElementById('menu-overlay');
          
          if (overlay) {
            const isActive = overlay.classList.contains('active');
            if (isActive) {
              overlay.classList.remove('active');
              trigger.setAttribute('aria-expanded', 'false');
              document.body.classList.remove('menu-open');
              document.body.style.overflow = '';
            } else {
              overlay.classList.add('active');
              trigger.setAttribute('aria-expanded', 'true');
              document.body.classList.add('menu-open');
              document.body.style.overflow = 'hidden';
            }
          }
        }
      });

      // Protection Scripts
      document.addEventListener('contextmenu', (e) => e.preventDefault());
      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && (e.key === 's' || e.key === 'S' || e.key === 'u' || e.key === 'U')) {
          e.preventDefault();
        }
      });
      document.addEventListener('dragstart', (e) => {
        if (e.target instanceof HTMLImageElement || e.target instanceof HTMLVideoElement) {
          e.preventDefault();
        }
      });
    </script>
  </body>
</html>

<style is:global>
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    height: auto !important;
    overflow-x: hidden;
    overflow-y: auto !important;
  }

  *, *::before, *::after {
    -webkit-touch-callout: none !important;
    -webkit-user-select: none !important;
    -moz-user-select: none !important;
    -ms-user-select: none !important;
    user-select: none !important;
  }

  img, video {
    -webkit-user-drag: none !important;
    -khtml-user-drag: none !important;
    -moz-user-drag: none !important;
    -o-user-drag: none !important;
    user-drag: none !important;
  }

  a, button, input, textarea, select, .portfolio-card, .cad-trigger,
  .site-header, .menu-box, .menu-box *, .menu-overlay, .menu-overlay * {
    pointer-events: auto !important;
  }

  .menu-overlay.active {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    z-index: 2147483647 !important;
  }
</style>