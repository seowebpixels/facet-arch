---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "Facet Architecture | Spatial Design Studio", 
  description = "Architectural practice specializing in commercial, residential, development, interior, and sustainable projects.",
  image = "/og-image.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
---

<!doctype html>
<html lang="en" class="loading-lock">
  <head>
    <!-- Basic Meta Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Strict Global Preload & Scrollbar Suppression -->
    <style is:inline>
      html, 
      body {
        overflow-x: hidden;
        min-height: 100vh;
        position: relative;
      }

      /* Strict Scroll Lock Override for Preloader Phase */
      html.loading-lock, 
      body.loading-lock {
        overflow: hidden !important;
        overflow-y: hidden !important;
        height: 100vh !important;
        max-height: 100vh !important;
        position: fixed !important;
        width: 100% !important;
        touch-action: none !important;
        -ms-touch-action: none !important;
        overscroll-behavior: none !important;
      }

      /* Strip Webkit & Firefox Scrollbars entirely during lock */
      html.loading-lock::-webkit-scrollbar,
      body.loading-lock::-webkit-scrollbar,
      html.loading-lock *::-webkit-scrollbar {
        display: none !important;
        width: 0px !important;
        height: 0px !important;
        background: transparent !important;
      }

      html.loading-lock,
      body.loading-lock {
        scrollbar-width: none !important;
        -ms-overflow-style: none !important;
      }
    </style>

    <!-- Preload Custom Font (Bank Gothic) -->
    <link 
      rel="preload" 
      href="/fonts/BankGothic.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin="anonymous" 
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />
  </head>
  <body class="loading-lock">
    <main>
      <slot />
    </main>

    <!-- Global Anti-Copy Protection Script -->
    <script>
      // 1. Disable Right-Click Context Menu Site-Wide
      document.addEventListener('contextmenu', (e) => {
        e.preventDefault();
      });

      // 2. Intercept Keyboard Save & View Source Shortcuts (Ctrl+S, Cmd+S, Ctrl+U, Cmd+U)
      document.addEventListener('keydown', (e) => {
        if (
          (e.ctrlKey || e.metaKey) && 
          (e.key === 's' || e.key === 'S' || e.key === 'u' || e.key === 'U')
        ) {
          e.preventDefault();
        }
      });

      // 3. Block Image & Video Dragging
      document.addEventListener('dragstart', (e) => {
        if (e.target instanceof HTMLImageElement || e.target instanceof HTMLVideoElement) {
          e.preventDefault();
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* Disable Selection & Callouts Site-Wide */
  *, *::before, *::after {
    -webkit-touch-callout: none !important;
    -webkit-user-select: none !important;
    -moz-user-select: none !important;
    -ms-user-select: none !important;
    user-select: none !important;
  }

  /* Target all Images and Videos site-wide */
  img, video {
    -webkit-user-drag: none !important;
    -khtml-user-drag: none !important;
    -moz-user-drag: none !important;
    -o-user-drag: none !important;
    user-drag: none !important;
    pointer-events: none;
  }

  /* Restore interactive pointer events for links, buttons, interactive cards, and form controls */
  a, button, input, textarea, select, .portfolio-card, .cad-trigger {
    pointer-events: auto;
  }
</style>