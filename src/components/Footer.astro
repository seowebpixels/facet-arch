---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" style="width: 100%; background-color: #111418; color: #FFFFFF; padding: 60px 24px 40px; box-sizing: border-box;" role="contentinfo">
  <div style="max-width: 1280px; margin: 0 auto; display: flex; flex-direction: column; gap: 32px;">
    
    <!-- Accreditations Row -->
    <div class="accreditations-bar">
      <span class="accreditations-header">ACCREDITATIONS & AFFILIATIONS</span>
      <div class="accreditations-list">
        <span>SACAP</span>
        <span class="divider">|</span>
        <span>SAIA</span>
        <span class="divider">|</span>
        <span>SAIAT</span>
        <span class="divider">|</span>
        <span>LEED</span>
        <span class="divider">|</span>
        <span>EDGE</span>
      </div>
    </div>

    <!-- Copyright Base -->
    <div class="footer-base">
      <p class="footer-line copyright-line">&copy; {currentYear} FACET ARCHITECTURE</p>
      <p class="footer-line rights-line">ALL RIGHTS RESERVED</p>
      <p class="footer-line credits-line">
        DESIGNED BY&nbsp;<a 
          href="https://webdesignpros.co.za" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="wdp-link"
          aria-label="Designed by Web Design Pros (opens in a new tab)"
        >WEB DESIGN PROS</a>
      </p>
    </div>

  </div>
</footer>

<style is:global>
  .site-footer .accreditations-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .site-footer .accreditations-header {
    font-size: 11px;
    font-family: monospace;
    letter-spacing: 0.2em;
    color: #00FFC8;
    text-transform: uppercase;
    font-weight: 700;
  }

  .site-footer .accreditations-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    font-size: 12px;
    font-family: monospace;
    letter-spacing: 0.15em;
    color: #FFFFFF;
    font-weight: 600;
  }

  .site-footer .accreditations-list .divider {
    color: rgba(255, 255, 255, 0.3);
  }

  .site-footer .footer-base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    color: #FFFFFF !important;
    font-family: monospace;
    letter-spacing: 0.2em;
    gap: 16px;
    width: 100%;
  }

  .site-footer .footer-line {
    margin: 0;
    color: #FFFFFF !important;
  }

  .site-footer .wdp-link {
    display: inline-block;
    padding: 2px 0;
    color: #FFFFFF !important;
    font-weight: 400 !important;
    text-decoration: none !important;
    outline: none !important;
    transition: font-weight 0.15s ease, opacity 0.15s ease;
  }

  .site-footer .wdp-link:hover,
  .site-footer .wdp-link:focus-visible {
    color: #FFFFFF !important;
    font-weight: 700 !important;
    -webkit-text-stroke: 0.4px #FFFFFF;
    outline: none !important;
  }

  @media (max-width: 899px) {
    .site-footer .accreditations-bar {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 12px;
    }

    .site-footer .footer-base {
      flex-direction: column !important;
      align-items: center !important;
      text-align: center !important;
      gap: 8px !important;
    }

    .site-footer .footer-line {
      white-space: nowrap !important;
      line-height: 1.6 !important;
    }
  }
</style>