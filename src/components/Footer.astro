---
const currentYear = new Date().getFullYear();
---

<footer class="home-matched-footer">
  <div class="cta-section">
    <div class="cta-content">
      <div class="cta-text">
        <span class="cta-sub">NEXT STEPS</span>
        <h2 class="cta-heading">HAVE A PROJECT IN MIND?</h2>
      </div>
      <div class="cta-action">
        <a href="mailto:info&#64;facetarch&#46;com" class="cta-btn">INITIATE CONSULTATION &rarr;</a>
      </div>
    </div>
  </div>

  <div class="footer-divider"></div>

  <div class="footer-base">
    <p class="footer-line copyright-line">&copy; {currentYear} FACET ARCHITECTURE</p>
    <p class="footer-line rights-line">ALL RIGHTS RESERVED</p>
    <p class="footer-line credits-line">
      DESIGNED BY&nbsp;<a 
        href="https://webdesignpros.co.za" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="wdp-link"
      >WEB DESIGN PROS</a>
    </p>
  </div>
</footer>

<style>
  .home-matched-footer {
    background-color: #2e343b;
    color: #ffffff;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif !important;
    padding: 60px 24px 40px !important;
    box-sizing: border-box;
    width: 100%;
    position: relative !important;
    z-index: 10 !important;
    margin-top: 40px !important;
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  .cta-section {
    max-width: 1400px;
    margin: 0 auto;
    padding-bottom: 32px;
  }

  .cta-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .cta-sub {
    display: block;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif !important;
    font-size: 0.65rem;
    color: #ffffff !important;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 10px;
    font-weight: 500;
  }

  .cta-heading {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif !important;
    font-size: 1.3rem;
    color: #ffffff !important;
    font-weight: 400;
    letter-spacing: 2px;
    margin: 0;
    text-transform: uppercase;
  }

  .cta-btn {
    display: inline-block;
    padding: 10px 22px;
    border: 1px solid #ffffff !important;
    background-color: transparent;
    color: #ffffff !important;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif !important;
    font-size: 0.7rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  .cta-btn:hover {
    background-color: #ffffff !important;
    color: #000000 !important;
  }

  .footer-divider {
    max-width: 1400px;
    margin: 0 auto 24px;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.3);
  }

  .footer-base {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.65rem;
    color: #f8fafc !important;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }

  .footer-line {
    margin: 0;
  }

  .wdp-link {
    color: #ffffff !important;
    font-weight: 500;
    text-decoration: underline;
    transition: color 0.2s ease, font-weight 0.2s ease, text-shadow 0.2s ease;
  }

  .wdp-link:hover {
    color: #ffffff !important;
    font-weight: 700 !important;
    text-shadow: 0 0 1px #ffffff;
  }

  @media (max-width: 899px) {
    .cta-content {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 20px !important;
    }

    .cta-text {
      width: 100% !important;
    }

    .cta-heading {
      font-size: clamp(1rem, 4.8vw, 1.3rem) !important;
      white-space: nowrap !important;
      letter-spacing: 1.5px !important;
      line-height: 1.2 !important;
    }

    .cta-action {
      width: 100% !important;
    }

    .cta-btn {
      display: block !important;
      width: 100% !important;
      text-align: center !important;
      box-sizing: border-box !important;
      padding: 12px 16px !important;
      font-size: 0.7rem !important;
      letter-spacing: 2px !important;
    }

    .footer-base {
      flex-direction: column !important;
      align-items: center !important;
      text-align: center !important;
      gap: 8px !important;
    }

    .footer-line {
      white-space: nowrap !important;
      line-height: 1.6 !important;
    }

    .credits-line {
      margin-top: 0.5rem !important;
    }
  }
</style>