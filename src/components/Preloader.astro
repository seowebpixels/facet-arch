---
import { Image } from 'astro:assets';
import heroLogoImg from '../assets/facet-hero-logo.avif';
import heroImg from '../assets/house-one.png';
---

<div id="hero-stage" class="stage-container">
  <!-- Top Left Typography -->
  <h1 id="text-facet" class="title-text text-facet">FACET</h1>

  <!-- Logo Mark Container -->
  <div id="logo-mark" class="logo-wrapper">
    <Image 
      src={heroLogoImg} 
      alt="Facet Architecture Logo" 
      class="logo-img"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>

  <!-- Bottom Right Typography -->
  <h1 id="text-architecture" class="title-text text-architecture">ARCHITECTURE</h1>

  <!-- Center Expandable Hero Showcase -->
  <div id="hero-frame" class="hero-frame">
    <Image 
      src={heroImg} 
      alt="Facet Architecture Project Showcase" 
      class="hero-img"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  function initHeroAnimation() {
    const stage = document.getElementById('hero-stage');
    if (!stage) return;

    gsap.killTweensOf(['#logo-mark', '#text-facet', '#text-architecture', '#hero-frame']);

    // Calculate viewport center offsets for clean transforms
    const centerX = window.innerWidth / 2;
    const centerY = window.innerHeight / 2;

    // 1. Initial Setup via pure Transforms (prevents top-left bunching)
    gsap.set('#hero-frame', { scaleY: 0, transformOrigin: 'center center' });
    
    // Position FACET starting from center relative to its new 20px top anchor
gsap.set('#text-facet', { 
  x: () => centerX - 50 - (document.getElementById('text-facet')?.offsetWidth || 0) / 2,
  y: () => centerY - 20 - (document.getElementById('text-facet')?.offsetHeight || 0) / 2,
  opacity: 0 
});

// Position ARCHITECTURE starting from center relative to its new 20px bottom anchor
gsap.set('#text-architecture', { 
  x: () => -(centerX - 50 - (document.getElementById('text-architecture')?.offsetWidth || 0) / 2),
  y: () => -(centerY - 20 - (document.getElementById('text-architecture')?.offsetHeight || 0) / 2),
  opacity: 0 
});
    
    // Position LOGO starting from screen center relative to its top-right anchor
    gsap.set('#logo-mark', { 
      x: () => -(centerX - 30 - (document.getElementById('logo-mark')?.offsetWidth || 0) / 2),
      y: () => centerY - (-20) - (document.getElementById('logo-mark')?.offsetHeight || 0) / 2,
      scale: 3.2, 
      opacity: 1 
    });

    const tl = gsap.timeline({ defaults: { ease: 'power3.inOut' } });

    // 2. Animate transforms to 0 (snaps smoothly to exact CSS edge positions)
    tl.to('#logo-mark', {
      x: 0,
      y: 0,
      scale: 1,
      duration: 1.0
    }, 0.6)
    .to('#text-facet', {
      x: 0,
      y: 0,
      opacity: 1,
      duration: 1.0
    }, '<')
    .to('#text-architecture', {
      x: 0,
      y: 0,
      opacity: 1,
      duration: 1.0
    }, '<')
    .to('#hero-frame', {
      scaleY: 1,
      duration: 1.2,
      ease: 'power4.out'
    }, '-=0.6');
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initHeroAnimation();
  } else {
    document.addEventListener('DOMContentLoaded', initHeroAnimation);
  }
  document.addEventListener('astro:page-load', initHeroAnimation);
</script>

<style>
  .stage-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
  }

  /* FACET: Anchored 50px from top and left */
  .text-facet {
    position: absolute;
    top: 20px;
    left: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900; /* Extra bold */
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 20;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
  }

  /* ARCHITECTURE: Anchored 50px from bottom and right */
  .text-architecture {
    position: absolute;
    bottom: 20px;
    right: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900; /* Extra bold */
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 20;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
  }

  /* LOGO: Anchored top-right (30px from right, shifted 50px UP to -20px top) */
  .logo-wrapper {
    position: absolute;
    top: -20px;
    right: 30px;
    z-index: 30;
    transform-origin: center center;
  }

  .logo-img {
    height: 150px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  /* Central Frame */
  .hero-frame {
    position: absolute;
    top: 14%;
    left: 12%;
    width: 76vw;
    height: 72vh;
    z-index: 10;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    transform: scaleY(0);
    transform-origin: center center;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .text-facet {
      top: 25px;
      left: 20px;
      font-size: clamp(1.5rem, 5vw, 2.2rem);
    }
    .text-architecture {
      bottom: 25px;
      right: 20px;
      font-size: clamp(1.5rem, 5vw, 2.2rem);
    }
    .logo-wrapper {
      right: 15px;
      top: -10px;
    }
    .logo-img { height: 85px; }
    .hero-frame {
      top: 18%;
      left: 5%;
      width: 90vw;
      height: 64vh;
    }
  }
</style>