---
import { Image } from 'astro:assets';
import heroLogoImg from '../assets/facet-hero-logo.avif';
import heroImg from '../assets/house-one.png';
---

<div id="hero-stage" class="stage-container">
  <!-- Top Left Typography (Spreads from Center) -->
  <h1 id="text-facet" class="title-text text-facet">FACET</h1>

  <!-- Logo Mark Container -->
  <div id="logo-mark" class="logo-wrapper">
    <Image 
      src={heroLogoImg} 
      alt="Facet Architecture Logo" 
      class="logo-img"
      loading="eager"
    />
  </div>

  <!-- Bottom Right Typography (Spreads from Center) -->
  <h1 id="text-architecture" class="title-text text-architecture">ARCHITECTURE</h1>

  <!-- Center Expandable Hero Showcase -->
  <div id="hero-frame" class="hero-frame">
    <Image 
      src={heroImg} 
      alt="Facet Architecture Project Showcase" 
      class="hero-img"
      loading="eager"
    />
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  function initHeroAnimation() {
    const stage = document.getElementById('hero-stage');
    if (!stage) return;

    gsap.killTweensOf(['#logo-mark', '#text-facet', '#text-architecture', '#hero-frame']);

    // Initial setup state: Text and logo stacked centered
    gsap.set('#hero-frame', { scaleY: 0, transformOrigin: 'center center' });
    
    // Set FACET to start dead-center
    gsap.set('#text-facet', { 
      top: '50%', 
      left: '50%', 
      xPercent: -50, 
      yPercent: -50, 
      opacity: 0 
    });

    // Set ARCHITECTURE to start dead-center
    gsap.set('#text-architecture', { 
      bottom: '50%', 
      right: '50%', 
      xPercent: 50, 
      yPercent: 50, 
      opacity: 0 
    });
    
    // Set Logo to start dead-center enlarged
    gsap.set('#logo-mark', { 
      top: '50%', 
      right: '50%', 
      xPercent: 50, 
      yPercent: -50, 
      scale: 3.2, 
      opacity: 1 
    });

    const tl = gsap.timeline({ defaults: { ease: 'power3.inOut' } });

    // 2.0s Hold at Center -> Move Logo to Top-Right & Spread Text Outward to Corners
    tl.to('#logo-mark', {
      top: '0px',
      right: '30px',
      xPercent: 0,
      yPercent: 0,
      scale: 1,
      duration: 1.2
    }, 2.0)
    .to('#text-facet', {
      top: '0px',
      left: '30px',
      xPercent: 0,
      yPercent: 0,
      opacity: 1,
      duration: 1.2
    }, '<')
    .to('#text-architecture', {
      bottom: '0px',
      right: '30px',
      xPercent: 0,
      yPercent: 0,
      opacity: 1,
      duration: 1.2
    }, '<')
    .to('#hero-frame', {
      scaleY: 1,
      duration: 1.4,
      ease: 'power4.out'
    }, '-=0.8');
  }

  initHeroAnimation();
  document.addEventListener('astro:page-load', initHeroAnimation);
</script>

<style>
  .stage-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
  }

  /* Typography Rules (Strict Bank Gothic, Bold, Reduced by 15px) */
  .title-text {
    position: absolute;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 700;
    font-size: clamp(2.8rem, 4.2vw, 4rem);
    letter-spacing: 0.15em;
    color: var(--text-primary, #111111);
    margin: 0;
    z-index: 20;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Logo Container */
  .logo-wrapper {
    position: absolute;
    z-index: 30;
    transform-origin: center center;
  }

  .logo-img {
    height: 110px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  /* Central Frame */
  .hero-frame {
    position: absolute;
    top: 12%;
    left: 12%;
    width: 76vw;
    height: 76vh;
    z-index: 10;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .title-text {
      font-size: clamp(1.8rem, 6vw, 2.5rem);
    }
    .logo-img { height: 80px; }
    .hero-frame {
      top: 15%;
      left: 5%;
      width: 90vw;
      height: 70vh;
    }
  }
</style>