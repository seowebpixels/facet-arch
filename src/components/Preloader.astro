---
/* Preloader.astro */
import { Image } from 'astro:assets';
import heroLogoImg from '../assets/facet-hero-logo.avif';
import heroImg from '../assets/res-eoa-1597.avif';
---

<div id="hero-stage" class="stage-container">
  <!-- Top Left Typography -->
  <h1 id="text-facet" class="title-text text-facet">FACET</h1>

  <!-- Live Local Clock -->
  <div id="hero-clock" class="hero-clock">
    <span id="live-time">00:00:00</span>
    <span id="time-zone" class="time-zone">SAST</span>
  </div>

  <!-- 1. CENTERED PRELOADER LOGO (Visible instantly on CSS load) -->
  <div id="logo-center" class="logo-center-wrapper">
    <Image 
      src={heroLogoImg} 
      alt="Facet Architecture Logo" 
      class="logo-img-large"
      widths={[120, 240, 360]}
      sizes="(max-width: 768px) 120px, 200px"
      quality={80}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>

  <!-- 2. TOP-RIGHT DOCKED LOGO (Target position) -->
  <div id="logo-docked" class="logo-docked-wrapper">
    <Image 
      src={heroLogoImg} 
      alt="Facet Architecture Logo" 
      class="logo-img-small"
      widths={[120, 240, 360]}
      sizes="(max-width: 768px) 120px, 200px"
      quality={80}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>

  <!-- Bottom Right Typography -->
  <h1 id="text-architecture" class="title-text text-architecture">ARCHITECTURE</h1>

  <!-- Center Expandable Hero Showcase -->
  <div id="hero-frame" class="hero-frame">
    <Image 
      src={heroImg} 
      alt="Facet Architecture Project Showcase" 
      class="hero-img"
      widths={[360, 480, 720]}
      sizes="(max-width: 768px) 100vw, 720px"
      format="avif"
      quality={60}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  function releaseScrollLock() {
    document.documentElement.classList.remove('is-loading', 'no-scroll');
    document.body.classList.remove('is-loading', 'no-scroll');

    document.documentElement.style.overflow = '';
    document.body.style.overflow = '';

    const stage = document.getElementById('hero-stage');
    if (stage) {
      stage.style.pointerEvents = 'none';
    }
  }

  function updateHeroClock() {
    const clockEl = document.getElementById('live-time');
    const zoneEl = document.getElementById('time-zone');
    if (!clockEl) return;

    const now = new Date();
    clockEl.textContent = now.toTimeString().split(' ')[0];

    if (zoneEl) {
      const tzString = now.toLocaleDateString('en-US', { timeZoneName: 'short' });
      const shortTz = tzString.split(' ').pop() || '';
      zoneEl.textContent = shortTz;
    }
  }

  function initHeroAnimation() {
    const stage = document.getElementById('hero-stage');
    if (!stage) return;

    const logoCenter = document.getElementById('logo-center');
    const logoDocked = document.getElementById('logo-docked');
    const textFacet = document.getElementById('text-facet');
    const textArchitecture = document.getElementById('text-architecture');
    const clock = document.getElementById('hero-clock');
    const heroFrame = document.getElementById('hero-frame');

    if (!logoCenter || !logoDocked || !textFacet || !textArchitecture || !clock || !heroFrame) {
      releaseScrollLock();
      return;
    }

    window.scrollTo(0, 0);

    updateHeroClock();
    setInterval(updateHeroClock, 1000);

    gsap.killTweensOf([logoCenter, logoDocked, textFacet, textArchitecture, clock, heroFrame]);

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      gsap.set(logoCenter, { opacity: 0 });
      gsap.set(logoDocked, { opacity: 1 });
      gsap.set([textFacet, textArchitecture, clock], { opacity: 1, y: 0 });
      gsap.set(heroFrame, { scaleY: 1 });
      releaseScrollLock();
      return;
    }

    // Force strict initial states
    gsap.set(logoCenter, { opacity: 1, scale: 1 });
    gsap.set(logoDocked, { opacity: 0 });
    gsap.set([textFacet, clock], { opacity: 0, y: -20 });
    gsap.set(textArchitecture, { opacity: 0, y: 20 });
    gsap.set(heroFrame, { scaleY: 0, transformOrigin: 'center center' });

    const tl = gsap.timeline({ 
      defaults: { ease: 'power3.inOut' },
      onComplete: releaseScrollLock
    });

    tl
      // 1. HOLD LOGO DEAD-CENTER FOR EXACTLY 3 SECONDS
      .to(logoCenter, {
        duration: 3
      })
      // 2. REVEAL FACET, ARCHITECTURE & CLOCK
      .to([textFacet, textArchitecture, clock], {
        opacity: 1,
        y: 0,
        duration: 0.8,
        stagger: 0
      })
      // 3. FADE OUT CENTER LOGO / FADE IN TOP-RIGHT DOCKED LOGO
      .to(logoCenter, {
        opacity: 0,
        scale: 0.5,
        duration: 0.8
      }, '-=0.2')
      .to(logoDocked, {
        opacity: 1,
        duration: 0.8
      }, '<')
      // 4. EXPAND HERO IMAGE FRAME
      .to(heroFrame, {
        scaleY: 1,
        duration: 1.2,
        ease: 'power4.out'
      }, '-=0.4');
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initHeroAnimation();
  } else {
    document.addEventListener('DOMContentLoaded', initHeroAnimation);
  }
  document.addEventListener('astro:page-load', initHeroAnimation);
</script>

<style>
  .stage-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 10;
  }

  /* FACET: Anchored top and left (Hidden by default in CSS) */
  .text-facet {
    position: absolute;
    top: 20px;
    left: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 20;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
  }

  /* Live Local Clock Styling (Hidden by default in CSS) */
  .hero-clock {
    position: absolute;
    bottom: 25px;
    left: 50px;
    z-index: 20;
    font-family: monospace, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-primary, #111111);
    opacity: 0;
    display: flex;
    align-items: center;
  }

  .time-zone {
    margin-left: 1.25rem;
  }

  /* ARCHITECTURE: Anchored bottom and right (Hidden by default in CSS) */
  .text-architecture {
    position: absolute;
    bottom: 20px;
    right: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 20;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
  }

  /* 1. CENTER LOGO: Hardcoded CSS centering (ALWAYS visible on direct page hit) */
  .logo-center-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 320px;
    height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 999;
    opacity: 1;
  }

  .logo-img-large {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  /* 2. DOCKED LOGO: Exact Top Right Placement (Hidden initially in CSS) */
  .logo-docked-wrapper {
    position: absolute;
    top: 20px;
    right: 50px;
    width: 150px;
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 999;
    opacity: 0;
  }

  .logo-img-small {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  /* HERO FRAME: Collapsed vertically by default in CSS */
  .hero-frame {
    position: absolute;
    top: 14%;
    left: 12%;
    width: 76vw;
    height: 72vh;
    z-index: 10;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    transform: scaleY(0);
    transform-origin: center center;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Mobile Layout Adjustments */
  @media (max-width: 768px) {
    .logo-center-wrapper {
      width: 200px;
      height: 200px;
    }

    .logo-docked-wrapper {
      top: 20px;
      right: 15px;
      width: 85px;
      height: 85px;
    }

    .hero-frame {
      top: 180px;
      left: 0;
      width: 100vw;
      height: 44vh;
      box-shadow: none;
    }

    .text-facet {
      top: 190px;
      left: 15px;
      font-size: clamp(1.8rem, 6vw, 2.5rem);
    }

    .text-architecture {
      position: absolute;
      top: calc(180px + 44vh - 38px);
      bottom: auto;
      right: 15px;
      font-size: clamp(1.8rem, 6vw, 2.5rem);
    }

    .hero-clock {
      bottom: 105px;
      left: 15px;
      font-size: 0.85rem;
    }

    .time-zone {
      margin-left: 0.85rem;
    }

    .hero-img {
      object-fit: contain;
      object-position: center center;
    }
  }
</style>