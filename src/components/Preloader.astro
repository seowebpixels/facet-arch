---
import { Image } from 'astro:assets';
import heroLogoImg from '../assets/facet-hero-logo.avif';
import heroImg from '../assets/res-eoa-1597.avif';
---

<div id="hero-stage" class="stage-container">
  <!-- 1. HERO IMAGE SHOWCASE -->
  <div id="hero-frame" class="hero-frame" style="transform: scaleY(0); transform-origin: center center;">
    <Image 
      src={heroImg} 
      alt="Facet Architecture Project Showcase" 
      class="hero-img"
      widths={[360, 480, 720]}
      sizes="(max-width: 768px) 100vw, 720px"
      format="avif"
      quality={60}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>

  <!-- 2. TYPOGRAPHY & CLOCK LAYERS -->
  <h1 id="text-facet" class="title-text text-facet" style="opacity: 0; transform: translate(-80px, -40px);">FACET</h1>

  <div id="hero-clock" class="hero-clock" style="opacity: 0; transform: translateY(-20px);">
    <span id="live-time">00:00:00</span>
    <span id="time-zone" class="time-zone">SAST</span>
  </div>

  <h1 id="text-architecture" class="title-text text-architecture" style="opacity: 0; transform: translate(80px, 40px);">ARCHITECTURE</h1>

  <!-- 3. ANIMATING CENTER LOGO -->
  <div id="logo-center" class="logo-center-wrapper">
    <Image 
      src={heroLogoImg} 
      alt="Facet Architecture Logo" 
      class="logo-img-large"
      widths={[120, 240, 360]}
      sizes="(max-width: 768px) 120px, 200px"
      quality={80}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>
</div>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

<script is:inline>
  (function initPreloader() {
    function releaseScrollLock() {
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      var stage = document.getElementById('hero-stage');
      if (stage) stage.style.pointerEvents = 'none';
    }

    function updateClock() {
      var clockEl = document.getElementById('live-time');
      var zoneEl = document.getElementById('time-zone');
      if (!clockEl) return;
      var now = new Date();
      clockEl.textContent = now.toTimeString().split(' ')[0];
      if (zoneEl) {
        var tzString = now.toLocaleDateString('en-US', { timeZoneName: 'short' });
        zoneEl.textContent = tzString.split(' ').pop() || 'SAST';
      }
    }

    updateClock();
    setInterval(updateClock, 1000);

    // Strict Scroll Lock on Start
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';

    window.addEventListener('DOMContentLoaded', function() {
      var logoCenter = document.getElementById('logo-center');
      var textFacet = document.getElementById('text-facet');
      var textArchitecture = document.getElementById('text-architecture');
      var clock = document.getElementById('hero-clock');
      var heroFrame = document.getElementById('hero-frame');

      if (!logoCenter || !textFacet || !textArchitecture || !clock || !heroFrame) {
        releaseScrollLock();
        return;
      }

      var isMobile = window.innerWidth <= 768;

      // Pure CSS transform offset targets (Zero forced reflow reads)
      var targetX = isMobile ? 'calc(50vw - 60px)' : 'calc(50vw - 120px)';
      var targetY = isMobile ? '-calc(50vh - 40px)' : '-calc(50vh - 20px)';
      var targetScale = isMobile ? 0.45 : 0.5;

      var tl = gsap.timeline({
        defaults: { ease: 'power3.inOut' },
        onComplete: releaseScrollLock
      });

      tl
        // Phase 1: Preloader Hold (Reduced slightly to 2s for optimal mobile Speed Index)
        .to(logoCenter, {
          duration: 2
        })
        // Phase 2: Split Words FACET & ARCHITECTURE into Corners
        .to(textFacet, {
          opacity: 1,
          x: 0,
          y: 0,
          duration: 0.8,
          ease: 'power4.out'
        })
        .to(textArchitecture, {
          opacity: 1,
          x: 0,
          y: 0,
          duration: 0.8,
          ease: 'power4.out'
        }, '<')
        .to(clock, {
          opacity: 1,
          y: 0,
          duration: 0.6
        }, '-=0.4')
        // Phase 3: Glide Logo into top-right without reading offset geometry
        .to(logoCenter, {
          x: targetX,
          y: targetY,
          scale: targetScale,
          duration: 1,
          ease: 'power3.inOut'
        }, '-=0.4')
        // Phase 4: Expand Central Hero Image
        .to(heroFrame, {
          scaleY: 1,
          duration: 1,
          ease: 'power4.out'
        }, '-=0.5');
    });
  })();
</script>

<style>
  .stage-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 10;
  }

  .text-facet {
    position: absolute;
    top: 20px;
    left: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 40;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hero-clock {
    position: absolute;
    bottom: 25px;
    left: 50px;
    z-index: 40;
    font-family: monospace, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-primary, #111111);
    display: flex;
    align-items: center;
  }

  .time-zone {
    margin-left: 1.25rem;
  }

  .text-architecture {
    position: absolute;
    bottom: 20px;
    right: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 40;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .logo-center-wrapper {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 280px;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    pointer-events: none;
    transform-origin: center center;
    will-change: transform;
  }

  .logo-img-large {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .hero-frame {
    position: absolute;
    top: 14%;
    left: 12%;
    width: 76vw;
    height: 72vh;
    z-index: 20;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    will-change: transform;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .logo-center-wrapper {
      width: 180px;
      height: 180px;
    }

    .hero-frame {
      top: 240px;
      left: 6vw;
      width: 88vw;
      height: 34vh;
      box-shadow: none;
    }

    .text-facet {
      top: 190px;
      left: 15px;
      font-size: clamp(1.8rem, 6vw, 2.5rem);
    }

    .text-architecture {
      position: absolute;
      top: calc(240px + 34vh + 15px);
      bottom: auto;
      right: 15px;
      font-size: clamp(1.8rem, 6vw, 2.5rem);
    }

    .hero-clock {
      bottom: 105px;
      left: 15px;
      font-size: 0.85rem;
    }
  }
</style>