---
import { Image } from 'astro:assets';
import heroLogoImg from '../assets/facet-hero-logo.avif';
import heroImg from '../assets/res-eoa-1597.avif';
---

<div id="hero-stage" class="stage-container">
  <!-- Top Left Typography -->
  <h1 id="text-facet" class="title-text text-facet">FACET</h1>

  <!-- Live Local Clock (Positioned near bottom left) -->
  <div id="hero-clock" class="hero-clock">
    <span id="live-time">00:00:00</span>
    <span id="time-zone" class="time-zone">SAST</span>
  </div>

  <!-- Logo Mark Container -->
  <div id="logo-mark" class="logo-wrapper">
    <Image 
      src={heroLogoImg} 
      alt="Facet Architecture Logo" 
      class="logo-img"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>

  <!-- Bottom Right Typography -->
  <h1 id="text-architecture" class="title-text text-architecture">ARCHITECTURE</h1>

  <!-- Center Expandable Hero Showcase -->
  <div id="hero-frame" class="hero-frame">
    <Image 
      src={heroImg} 
      alt="Facet Architecture Project Showcase" 
      class="hero-img"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  // Prevent keyboard scrolling actions during lock phase
  const preventKeys = (e: KeyboardEvent) => {
    if (document.documentElement.classList.contains('is-loading')) {
      if (['ArrowUp', 'ArrowDown', 'Space', 'PageUp', 'PageDown', 'Home', 'End'].includes(e.code)) {
        e.preventDefault();
      }
    }
  };

  const applyScrollLock = () => {
    document.documentElement.classList.add('is-loading');
    document.body.classList.add('is-loading');
    window.scrollTo(0, 0);
    window.addEventListener('keydown', preventKeys, { passive: false });
  };

  function releaseScrollLock() {
    // 1. Remove lock class completely from root and body
    document.documentElement.classList.remove('is-loading');
    document.body.classList.remove('is-loading');

    // 2. Clear all inline override styles applied during loading
    document.documentElement.removeAttribute('style');
    document.body.removeAttribute('style');

    window.removeEventListener('keydown', preventKeys);

    // 3. Make stage pointer-events none so user can interact with the underlying content
    const stage = document.getElementById('hero-stage');
    if (stage) {
      stage.style.pointerEvents = 'none';
    }
  }

  // Live Local Time Updater
  function updateHeroClock() {
    const clockEl = document.getElementById('live-time');
    const zoneEl = document.getElementById('time-zone');
    if (!clockEl) return;

    const now = new Date();
    clockEl.textContent = now.toTimeString().split(' ')[0];

    if (zoneEl) {
      const tzString = now.toLocaleDateString('en-US', { timeZoneName: 'short' });
      const shortTz = tzString.split(' ').pop() || '';
      zoneEl.textContent = shortTz;
    }
  }

  function initHeroAnimation() {
    applyScrollLock();

    const stage = document.getElementById('hero-stage');
    if (!stage) return;

    const logo = document.getElementById('logo-mark');
    const textFacet = document.getElementById('text-facet');
    const textArchitecture = document.getElementById('text-architecture');
    const clock = document.getElementById('hero-clock');
    const heroFrame = document.getElementById('hero-frame');

    if (!logo || !textFacet || !textArchitecture || !clock || !heroFrame) return;

    window.scrollTo(0, 0);

    updateHeroClock();
    setInterval(updateHeroClock, 1000);

    gsap.killTweensOf([logo, textFacet, textArchitecture, clock, heroFrame]);

    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const isMobile = vw <= 768;

    const targetTop = isMobile ? -10 : -20;
    const targetRight = isMobile ? 15 : 30;

    const logoWidth = logo.offsetWidth || (isMobile ? 85 : 150);
    const logoHeight = logo.offsetHeight || (isMobile ? 85 : 150);

    const deltaX = (vw / 2) - targetRight - (logoWidth / 2);
    const deltaY = -((vh / 2) - targetTop - (logoHeight / 2));

    gsap.set(logo, { x: 0, y: 0, scale: 3.2, opacity: 1 });
    gsap.set([textFacet, clock], { opacity: 0, y: -20 });
    gsap.set(textArchitecture, { opacity: 0, y: 20 });
    gsap.set(heroFrame, { scaleY: 0, transformOrigin: 'center center' });

    const tl = gsap.timeline({ 
      defaults: { ease: 'power3.inOut' },
      onComplete: releaseScrollLock
    });

    tl
      // 1. Hold logo in center for 3 seconds
      .to(logo, {
        duration: 3
      })
      // 2. Reveal FACET, ARCHITECTURE & Live Clock
      .to([textFacet, textArchitecture, clock], {
        opacity: 1,
        y: 0,
        duration: 0.8,
        stagger: 0
      })
      // 3. Move logo to top right corner
      .to(logo, {
        x: deltaX,
        y: deltaY,
        scale: 1,
        duration: 1.2
      }, '-=0.2')
      // 4. Expand hero image
      .to(heroFrame, {
        scaleY: 1,
        duration: 1.2,
        ease: 'power4.out'
      }, '-=0.4');
  }

  // Execute initialization
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initHeroAnimation();
  } else {
    document.addEventListener('DOMContentLoaded', initHeroAnimation);
  }
  document.addEventListener('astro:page-load', initHeroAnimation);
</script>

<style>
  .stage-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 99;
  }

  .text-facet {
    position: absolute;
    top: 20px;
    left: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 20;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
  }

  .hero-clock {
    position: absolute;
    bottom: 25px;
    left: 50px;
    z-index: 20;
    font-family: monospace, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-primary, #111111);
    opacity: 0;
    display: flex;
    align-items: center;
  }

  .time-zone {
    margin-left: 1.25rem;
  }

  .text-architecture {
    position: absolute;
    bottom: 20px;
    right: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 20;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
  }

  .logo-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(3.2);
    transform-origin: center center;
    z-index: 30;
    will-change: transform;
  }

  .logo-img {
    height: 150px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  .hero-frame {
    position: absolute;
    top: 14%;
    left: 12%;
    width: 76vw;
    height: 72vh;
    z-index: 10;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    transform: scaleY(0);
    transform-origin: center center;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .hero-frame {
      top: 180px;
      left: 0;
      width: 100vw;
      height: 44vh;
      box-shadow: none;
    }

    .text-facet {
      top: 190px;
      left: 15px;
      font-size: clamp(1.8rem, 6vw, 2.5rem);
    }

    .text-architecture {
      position: absolute;
      top: calc(180px + 44vh - 38px);
      bottom: auto;
      right: 15px;
      font-size: clamp(1.8rem, 6vw, 2.5rem);
    }

    .hero-clock {
      bottom: 105px;
      left: 15px;
      font-size: 0.85rem;
    }

    .time-zone {
      margin-left: 0.85rem;
    }

    .logo-img { 
      height: 85px; 
    }

    .hero-img {
      object-fit: contain;
      object-position: center center;
    }
  }
</style>