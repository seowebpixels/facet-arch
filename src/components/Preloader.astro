---
import { Image } from 'astro:assets';
import heroLogoImg from '../assets/facet-hero-logo.avif';
import heroImg from '../assets/res-eoa-1597.avif';
---

<div id="hero-stage" class="stage-container">
  <div id="hero-frame" class="hero-frame" style="transform: scaleY(0); transform-origin: center center;">
    <Image 
      src={heroImg} 
      alt="Facet Architecture Project Showcase" 
      class="hero-img"
      widths={[360, 480, 720]}
      sizes="(max-width: 768px) 100vw, 720px"
      format="avif"
      quality={60}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>

  <h1 id="text-facet" class="title-text text-facet" style="opacity: 0; transform: translate(-80px, -40px);">FACET</h1>

  <div id="hero-clock" class="hero-clock" style="opacity: 0; transform: translateY(-20px);">
    <span id="live-time">00:00:00</span>
    <span id="time-zone" class="time-zone">SAST</span>
  </div>

  <h1 id="text-architecture" class="title-text text-architecture" style="opacity: 0; transform: translate(80px, 40px);">ARCHITECTURE</h1>

  <div id="logo-docked" class="logo-docked-wrapper">
    <div class="logo-placeholder"></div>
  </div>

  <div id="logo-center" class="logo-center-wrapper">
    <Image 
      src={heroLogoImg} 
      alt="Facet Architecture Logo" 
      class="logo-img-large"
      width={320}
      height={320}
      format="avif"
      quality={80}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>
</div>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

<script is:inline>
  (function initPreloader() {
    function releaseScrollLock() {
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      var stage = document.getElementById('hero-stage');
      if (stage) stage.style.pointerEvents = 'none';
    }

    function updateClock() {
      var clockEl = document.getElementById('live-time');
      var zoneEl = document.getElementById('time-zone');
      if (!clockEl) return;
      var now = new Date();
      clockEl.textContent = now.toTimeString().split(' ')[0];
      if (zoneEl) {
        var tzString = now.toLocaleDateString('en-US', { timeZoneName: 'short' });
        zoneEl.textContent = tzString.split(' ').pop() || 'SAST';
      }
    }

    updateClock();
    setInterval(updateClock, 1000);

    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';

    function runAnimation() {
      if (typeof gsap === 'undefined') {
        setTimeout(runAnimation, 30);
        return;
      }

      var logoCenter = document.getElementById('logo-center');
      var logoDocked = document.getElementById('logo-docked');
      var textFacet = document.getElementById('text-facet');
      var textArchitecture = document.getElementById('text-architecture');
      var clock = document.getElementById('hero-clock');
      var heroFrame = document.getElementById('hero-frame');

      if (!logoCenter || !logoDocked || !textFacet || !textArchitecture || !clock || !heroFrame) {
        releaseScrollLock();
        return;
      }

      var centerRect = logoCenter.getBoundingClientRect();
      var dockedRect = logoDocked.getBoundingClientRect();

      var deltaX = (dockedRect.left + dockedRect.width / 2) - (centerRect.left + centerRect.width / 2);
      var deltaY = (dockedRect.top + dockedRect.height / 2) - (centerRect.top + centerRect.height / 2);
      var targetScale = dockedRect.width / centerRect.width;

      var tl = gsap.timeline({
        defaults: { ease: 'power3.inOut' },
        onComplete: releaseScrollLock
      });

      tl
        .to(logoCenter, { duration: 1.0 })
        .to(textFacet, { opacity: 1, x: 0, y: 0, duration: 0.8, ease: 'power4.out' })
        .to(textArchitecture, { opacity: 1, x: 0, y: 0, duration: 0.8, ease: 'power4.out' }, '<')
        .to(clock, { opacity: 1, y: 0, duration: 0.6 }, '-=0.4')
        .to(logoCenter, { x: deltaX, y: deltaY, scale: targetScale, duration: 1, ease: 'power3.inOut' }, '-=0.3')
        .to(heroFrame, { scaleY: 1, duration: 1, ease: 'power4.out' }, '-=0.5');
    }

    requestAnimationFrame(function() {
      requestAnimationFrame(runAnimation);
    });
  })();
</script>

<style>
  .stage-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 10;
  }

  .text-facet {
    position: absolute;
    top: 20px;
    left: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 40;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hero-clock {
    position: absolute;
    bottom: 25px;
    left: 50px;
    z-index: 40;
    font-family: monospace, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-primary, #111111);
    display: flex;
    align-items: center;
  }

  .time-zone {
    margin-left: 1.25rem;
  }

  .text-architecture {
    position: absolute;
    bottom: 20px;
    right: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 40;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .logo-center-wrapper {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 280px;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    pointer-events: none;
    transform-origin: center center;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .logo-img-large {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .logo-docked-wrapper {
    position: absolute;
    top: -30px; 
    right: 40px; 
    width: 140px;
    height: 140px;
    z-index: 30;
    pointer-events: none;
    visibility: hidden; 
  }

  .logo-placeholder {
    width: 100%;
    height: 100%;
  }

  .hero-frame {
    position: absolute;
    top: 14%;
    left: 12%;
    width: 76vw;
    height: 72vh;
    z-index: 20;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .logo-center-wrapper {
      width: 180px;
      height: 180px;
    }

    .logo-docked-wrapper {
      top: -10px;
      right: 10px;
      width: 85px;
      height: 85px;
    }

    .hero-frame {
      top: 240px;
      left: 6vw;
      width: 88vw;
      height: 34vh;
      box-shadow: none;
    }

    .text-facet {
      top: 190px;
      left: 15px;
      font-size: clamp(1.8rem, 6vw, 2.5rem);
    }

    .text-architecture {
      position: absolute;
      top: calc(240px + 34vh + 15px);
      bottom: auto;
      right: 15px;
      font-size: clamp(1.8rem, 6vw, 2.5rem);
    }

    .hero-clock {
      bottom: 105px;
      left: 15px;
      font-size: 0.85rem;
    }
  }
</style>