---
import { Image } from 'astro:assets';
import heroLogoImg from '../assets/facet-hero-logo.avif';
import heroImg from '../assets/res-eoa-1597.avif';
---

<div id="hero-stage" class="stage-container">
  <div id="hero-frame" class="hero-frame">
    <Image 
      src={heroImg} 
      alt="Facet Architecture Project Showcase" 
      class="hero-img"
      widths={[360, 480, 720]}
      sizes="(max-width: 768px) 100vw, 720px"
      format="avif"
      quality={60}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>

  <!--
    The Hero image is painted from the beginning so Chrome can use the
    actual Hero as the LCP candidate. This cover preserves the exact
    visual preloader: the Hero is hidden behind an opaque concrete layer
    until the final centre-outward reveal.
  -->
  <div id="hero-cover" class="hero-cover" aria-hidden="true"></div>

  <h1 id="text-facet" class="title-text text-facet">FACET</h1>

  <div id="hero-clock" class="hero-clock">
    <span id="live-time">00:00:00</span>
    <span id="time-zone" class="time-zone">SAST</span>
  </div>

  <h1 id="text-architecture" class="title-text text-architecture">ARCHITECTURE</h1>

  <div id="logo-docked" class="logo-docked-wrapper">
    <div class="logo-placeholder"></div>
  </div>

  <div id="logo-center" class="logo-center-wrapper" role="img" aria-label="Facet Architecture Logo">
    <!--
      Canvas deliberately replaces the HTML <img> for the preloader logo.
      The AVIF is still loaded at high priority and drawn onto the canvas,
      but the canvas itself is not an LCP image candidate.
    -->
    <canvas
      id="logo-canvas"
      class="logo-canvas"
      width="560"
      height="560"
      data-logo-src={heroLogoImg.src}
      aria-hidden="true"
    ></canvas>
  </div>
</div>

<script is:inline defer src="/js/gsap.min.js"></script>

<script is:inline>
  (function initPreloader() {
    function releaseScrollLock() {
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      var stage = document.getElementById('hero-stage');
      if (stage) stage.style.pointerEvents = 'none';
    }

    function updateClock() {
      var clockEl = document.getElementById('live-time');
      var zoneEl = document.getElementById('time-zone');
      if (!clockEl) return;
      var now = new Date();
      clockEl.textContent = now.toTimeString().split(' ')[0];
      if (zoneEl) {
        var tzString = now.toLocaleDateString('en-US', { timeZoneName: 'short' });
        zoneEl.textContent = tzString.split(' ').pop() || 'SAST';
      }
    }

    updateClock();
    setInterval(updateClock, 1000);

    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';

    // Draw the AVIF logo into a canvas. This keeps the exact logo artwork
    // and its 3-second hold, while removing the logo <img> from LCP
    // candidacy.
    (function drawLogoCanvas() {
      var canvas = document.getElementById('logo-canvas');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      var src = canvas.getAttribute('data-logo-src');
      if (!ctx || !src) return;

      var logoImage = new window.Image();
      logoImage.decoding = 'async';
      logoImage.fetchPriority = 'high';
      logoImage.onload = function() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(logoImage, 0, 0, canvas.width, canvas.height);
      };
      logoImage.src = src;
    })();

    var hasRun = false;

    function runAnimation() {
      if (hasRun) return;
      
      if (typeof gsap === 'undefined') {
        setTimeout(runAnimation, 10);
        return;
      }

      hasRun = true;

      var logoCenter = document.getElementById('logo-center');
      var logoDocked = document.getElementById('logo-docked');
      var textFacet = document.getElementById('text-facet');
      var textArchitecture = document.getElementById('text-architecture');
      var clock = document.getElementById('hero-clock');
      var heroFrame = document.getElementById('hero-frame');
      var heroCover = document.getElementById('hero-cover');

      if (!logoCenter || !heroCover || !logoDocked || !textFacet || !textArchitecture || !clock || !heroFrame) {
        releaseScrollLock();
        return;
      }

      var isMobile = window.innerWidth <= 768;

      var centerRect = logoCenter.getBoundingClientRect();
      var dockedRect = logoDocked.getBoundingClientRect();

      var deltaX = (dockedRect.left + dockedRect.width / 2) - (centerRect.left + centerRect.width / 2);
      var deltaY = (dockedRect.top + dockedRect.height / 2) - (centerRect.top + centerRect.height / 2);
      var targetScale = dockedRect.width / centerRect.width;

      // The Hero is already fully painted underneath the cover.
      // The cover provides the exact original visual state without hiding
      // the Hero image from Chrome's LCP measurement.
      gsap.set(heroFrame, { scaleY: 1, opacity: 1 });
      gsap.set(heroCover, { scaleY: 1, opacity: 1, transformOrigin: '50% 50%' });

      // Initial state for text & clock handled by GSAP
      gsap.set(textFacet, { opacity: 0, x: -80, y: -40 });
      gsap.set(textArchitecture, { opacity: 0, x: 80, y: 40 });
      gsap.set(clock, { opacity: 0, y: -20 });

      var tl = gsap.timeline({
        defaults: { ease: 'power3.inOut' },
        onComplete: releaseScrollLock
      });

      var durLogo = isMobile ? 0.45 : 0.8;
      var durText = isMobile ? 0.35 : 0.55;
      var durFrame = isMobile ? 0.45 : 0.75;

      // delay: 3 holds the center hero logo for 3 seconds before transition starts
      tl.to(logoCenter, { 
        x: deltaX, 
        y: deltaY, 
        scale: targetScale, 
        duration: durLogo, 
        delay: 3, 
        ease: 'power3.inOut' 
      })
      .to(textFacet, { opacity: 1, x: 0, y: 0, duration: durText, ease: 'power4.out' }, '-=0.3')
      .to(textArchitecture, { opacity: 1, x: 0, y: 0, duration: durText, ease: 'power4.out' }, '<')
      .to(clock, { opacity: 1, y: 0, duration: isMobile ? 0.25 : 0.4 }, '-=0.2')
      .to(heroCover, {
        scaleY: 0,
        duration: durFrame,
        ease: 'power4.out',
        onComplete: function() {
          heroCover.style.visibility = 'hidden';
        }
      }, '-=0.3');
    }

    // Extended failsafe to allow for full 3s logo hold time
    setTimeout(function() {
      if (!hasRun) runAnimation();
    }, 4500);

    if (document.readyState === 'interactive' || document.readyState === 'complete') {
      requestAnimationFrame(runAnimation);
    } else {
      document.addEventListener('DOMContentLoaded', function() {
        requestAnimationFrame(runAnimation);
      });
    }
  })();
</script>

<style>
  .stage-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 10;
  }

  .text-facet {
    position: absolute;
    top: 20px;
    left: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 40;
    text-transform: uppercase;
    white-space: nowrap;
    will-change: transform, opacity;
  }

  .hero-clock {
    position: absolute;
    bottom: 25px;
    left: 50px;
    z-index: 40;
    font-family: monospace, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-primary, #111111);
    display: flex;
    align-items: center;
    will-change: transform, opacity;
  }

  .time-zone {
    margin-left: 1.25rem;
  }

  .text-architecture {
    position: absolute;
    bottom: 20px;
    right: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 40;
    text-transform: uppercase;
    white-space: nowrap;
    will-change: transform, opacity;
  }

  .logo-center-wrapper {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 280px;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    pointer-events: none;
    transform-origin: center center;
    will-change: transform;
  }

  .logo-img-large {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }


  .logo-docked-wrapper {
    position: absolute;
    top: -30px; 
    right: 40px; 
    width: 140px;
    height: 140px;
    z-index: 30;
    pointer-events: none;
    visibility: hidden; 
  }

  .logo-placeholder {
    width: 100%;
    height: 100%;
  }

  .hero-frame {
    position: absolute;
    top: 14%;
    left: 12%;
    width: 76vw;
    height: 72vh;
    z-index: 20;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    opacity: 1;
    transform: scaleY(1);
    transform-origin: center center;
    will-change: auto;
    backface-visibility: hidden;
  }

  /*
    Opaque cover keeps the Hero visually hidden during the 3-second logo
    sequence while the real Hero image remains painted underneath.
    It is the cover, not the Hero, that performs the centre-outward reveal.
  */
  .hero-cover {
    position: absolute;
    top: 14%;
    left: 12%;
    width: 76vw;
    height: 72vh;
    z-index: 25;
    background-color: var(--bg-concrete, #BEBEBE);
    transform: scaleY(1);
    transform-origin: center center;
    will-change: transform;
    pointer-events: none;
  }

  .logo-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .logo-center-wrapper {
      width: 180px;
      height: 180px;
    }

    .logo-docked-wrapper {
      top: -10px;
      right: 10px;
      width: 85px;
      height: 85px;
    }

    .hero-frame,
    .hero-cover {
      top: 240px;
      left: 6vw;
      width: 88vw;
      height: 34vh;
    }

    .hero-frame {
      box-shadow: none;
    }

    .text-facet {
      top: 190px;
      left: 15px;
      font-size: clamp(1.8rem, 6vw, 2.5rem);
    }

    .text-architecture {
      position: absolute;
      top: calc(240px + 34vh + 15px);
      bottom: auto;
      right: 15px;
      font-size: clamp(1.8rem, 6vw, 2.5rem);
    }

    .hero-clock {
      bottom: 105px;
      left: 15px;
      font-size: 0.85rem;
    }
  }
</style>