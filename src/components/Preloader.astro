---
/* Preloader.astro */
import { Image } from 'astro:assets';
import heroLogoImg from '../assets/facet-hero-logo.avif';
import heroImg from '../assets/res-eoa-1597.avif';
---

<!-- PRELOADER OVERLAY: Pinned on top of everything -->
<div id="preloader-overlay" class="preloader-overlay">
  <div class="preloader-logo-wrapper">
    <Image 
      src={heroLogoImg} 
      alt="Facet Architecture Logo" 
      class="preloader-logo"
      widths={[120, 240, 360]}
      sizes="200px"
      quality={80}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>
</div>

<!-- MAIN HERO STAGE -->
<div id="hero-stage" class="stage-container">
  <h1 id="text-facet" class="title-text text-facet">FACET</h1>

  <div id="hero-clock" class="hero-clock">
    <span id="live-time">00:00:00</span>
    <span id="time-zone" class="time-zone">SAST</span>
  </div>

  <div id="logo-docked" class="logo-docked-wrapper">
    <Image 
      src={heroLogoImg} 
      alt="Facet Architecture Logo" 
      class="logo-img-small"
      widths={[120, 240, 360]}
      sizes="(max-width: 768px) 120px, 200px"
      quality={80}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>

  <h1 id="text-architecture" class="title-text text-architecture">ARCHITECTURE</h1>

  <div id="hero-frame" class="hero-frame">
    <Image 
      src={heroImg} 
      alt="Facet Architecture Project Showcase" 
      class="hero-img"
      widths={[360, 480, 720]}
      sizes="(max-width: 768px) 100vw, 720px"
      format="avif"
      quality={60}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>
</div>

<script is:inline>
  // Pure inline execution - no Astro bundler delay
  (function() {
    function updateClock() {
      var clockEl = document.getElementById('live-time');
      var zoneEl = document.getElementById('time-zone');
      if (!clockEl) return;
      var now = new Date();
      clockEl.textContent = now.toTimeString().split(' ')[0];
      if (zoneEl) {
        var tzString = now.toLocaleDateString('en-US', { timeZoneName: 'short' });
        zoneEl.textContent = tzString.split(' ').pop() || 'SAST';
      }
    }
    updateClock();
    setInterval(updateClock, 1000);

    // Lock scroll initially
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';

    // Hold screen overlay for 3 seconds, then reveal page seamlessly
    setTimeout(function() {
      var overlay = document.getElementById('preloader-overlay');
      var stage = document.getElementById('hero-stage');
      
      if (overlay) {
        overlay.classList.add('fade-out');
      }
      if (stage) {
        stage.classList.add('is-active');
      }

      // Unlock scroll after fade completes
      setTimeout(function() {
        if (overlay) overlay.style.display = 'none';
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
      }, 1000);
    }, 3000);
  })();
</script>

<style>
  /* 1. OVERLAY LAYER: Covers entire viewport for 3s */
  .preloader-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 1s ease-in-out, visibility 1s ease-in-out;
  }

  .preloader-overlay.fade-out {
    opacity: 0;
    visibility: hidden;
  }

  .preloader-logo-wrapper {
    width: 280px;
    height: 280px;
  }

  .preloader-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* 2. MAIN HERO STAGE */
  .stage-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 10;
  }

  /* Elements animate smoothly via CSS classes once .is-active is appended */
  .text-facet, .text-architecture, .hero-clock, .logo-docked-wrapper {
    opacity: 0;
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  .text-facet {
    position: absolute;
    top: 20px;
    left: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 20;
    text-transform: uppercase;
    transform: translateY(-20px);
  }

  .hero-clock {
    position: absolute;
    bottom: 25px;
    left: 50px;
    z-index: 20;
    font-family: monospace, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-primary, #111111);
    display: flex;
    align-items: center;
    transform: translateY(-20px);
  }

  .time-zone {
    margin-left: 1.25rem;
  }

  .text-architecture {
    position: absolute;
    bottom: 20px;
    right: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 20;
    text-transform: uppercase;
    transform: translateY(20px);
  }

  .logo-docked-wrapper {
    position: absolute;
    top: 20px;
    right: 50px;
    width: 150px;
    height: 150px;
    z-index: 30;
  }

  .logo-img-small {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hero-frame {
    position: absolute;
    top: 14%;
    left: 12%;
    width: 76vw;
    height: 72vh;
    z-index: 10;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    transform: scaleY(0);
    transform-origin: center center;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ACTIVE REVEAL STATE (Triggers after 3s hold) */
  .stage-container.is-active .text-facet,
  .stage-container.is-active .text-architecture,
  .stage-container.is-active .hero-clock,
  .stage-container.is-active .logo-docked-wrapper {
    opacity: 1;
    transform: translateY(0);
  }

  .stage-container.is-active .hero-frame {
    transform: scaleY(1);
  }

  /* Mobile Adjustments */
  @media (max-width: 768px) {
    .preloader-logo-wrapper {
      width: 180px;
      height: 180px;
    }

    .logo-docked-wrapper {
      top: 20px;
      right: 15px;
      width: 85px;
      height: 85px;
    }

    .hero-frame {
      top: 180px;
      left: 0;
      width: 100vw;
      height: 44vh;
      box-shadow: none;
    }

    .text-facet {
      top: 190px;
      left: 15px;
      font-size: clamp(1.8rem, 6vw, 2.5rem);
    }

    .text-architecture {
      position: absolute;
      top: calc(180px + 44vh - 38px);
      bottom: auto;
      right: 15px;
      font-size: clamp(1.8rem, 6vw, 2.5rem);
    }

    .hero-clock {
      bottom: 105px;
      left: 15px;
      font-size: 0.85rem;
    }
  }
</style>