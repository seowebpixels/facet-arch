---
import { Image } from 'astro:assets';
import heroLogoImg from '../assets/facet-hero-logo.avif';
import heroImg from '../assets/house-one.png';
---

<div id="hero-stage" class="stage-container">
  <!-- Top Left Typography -->
  <h1 id="text-facet" class="title-text text-facet">FACET</h1>

  <!-- Target Anchor for Logo in Top Right (Invisible Target) -->
  <div id="logo-target" class="logo-target-anchor"></div>

  <!-- Logo Mark Container (Starts Dead Center in CSS) -->
  <div id="logo-mark" class="logo-wrapper">
    <Image 
      src={heroLogoImg} 
      alt="Facet Architecture Logo" 
      class="logo-img"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>

  <!-- Bottom Right Typography -->
  <h1 id="text-architecture" class="title-text text-architecture">ARCHITECTURE</h1>

  <!-- Center Expandable Hero Showcase -->
  <div id="hero-frame" class="hero-frame">
    <Image 
      src={heroImg} 
      alt="Facet Architecture Project Showcase" 
      class="hero-img"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  function initHeroAnimation() {
    const stage = document.getElementById('hero-stage');
    if (!stage) return;

    const logo = document.getElementById('logo-mark');
    const target = document.getElementById('logo-target');
    const textFacet = document.getElementById('text-facet');
    const textArchitecture = document.getElementById('text-architecture');
    const heroFrame = document.getElementById('hero-frame');

    if (!logo || !target || !textFacet || !textArchitecture || !heroFrame) return;

    gsap.killTweensOf([logo, textFacet, textArchitecture, heroFrame]);

    // Calculate exact pixel offset from current dead center to target top-right anchor
    const logoRect = logo.getBoundingClientRect();
    const targetRect = target.getBoundingClientRect();

    const deltaX = targetRect.left - logoRect.left;
    const deltaY = targetRect.top - logoRect.top;

    // Set initial GSAP states
    gsap.set(logo, { 
      x: 0, 
      y: 0, 
      scale: 3.2, 
      opacity: 1 
    });
    gsap.set(textFacet, { opacity: 0, y: -20 });
    gsap.set(textArchitecture, { opacity: 0, y: 20 });
    gsap.set(heroFrame, { scaleY: 0, transformOrigin: 'center center' });

    const tl = gsap.timeline({ defaults: { ease: 'power3.inOut' } });

    tl
      // 1. Hold in dead center for 3 seconds
      .to(logo, {
        duration: 3
      })
      // 2. Animate directly to top-right target anchor
      .to(logo, {
        x: deltaX,
        y: deltaY,
        scale: 1,
        duration: 1.2
      })
      // 3. Reveal FACET & ARCHITECTURE simultaneously
      .to([textFacet, textArchitecture], {
        opacity: 1,
        y: 0,
        duration: 1.0,
        stagger: 0
      }, '<')
      // 4. Reveal hero image frame
      .to(heroFrame, {
        scaleY: 1,
        duration: 1.2,
        ease: 'power4.out'
      }, '-=0.4');
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initHeroAnimation();
  } else {
    document.addEventListener('DOMContentLoaded', initHeroAnimation);
  }
  document.addEventListener('astro:page-load', initHeroAnimation);
</script>

<style>
  .stage-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
  }

  /* FACET: Anchored top and left */
  .text-facet {
    position: absolute;
    top: 20px;
    left: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 20;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
  }

  /* ARCHITECTURE: Anchored bottom and right */
  .text-architecture {
    position: absolute;
    bottom: 20px;
    right: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 20;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
  }

  /* Target slot in Top-Right Corner where logo lands */
  .logo-target-anchor {
    position: absolute;
    top: -20px;
    right: 30px;
    width: 150px;
    height: 150px;
    pointer-events: none;
    visibility: hidden;
    z-index: 1;
  }

  /* LOGO: Absolutely centered in CSS by default */
  .logo-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(3.2);
    transform-origin: center center;
    z-index: 30;
    will-change: transform;
  }

  .logo-img {
    height: 150px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  /* Central Frame */
  .hero-frame {
    position: absolute;
    top: 14%;
    left: 12%;
    width: 76vw;
    height: 72vh;
    z-index: 10;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    transform: scaleY(0);
    transform-origin: center center;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .text-facet {
      top: 25px;
      left: 20px;
      font-size: clamp(1.5rem, 5vw, 2.2rem);
    }
    .text-architecture {
      bottom: 25px;
      right: 20px;
      font-size: clamp(1.5rem, 5vw, 2.2rem);
    }
    .logo-target-anchor {
      right: 15px;
      top: -10px;
      width: 85px;
      height: 85px;
    }
    .logo-img { 
      height: 85px; 
    }
    .hero-frame {
      top: 18%;
      left: 5%;
      width: 90vw;
      height: 64vh;
    }
  }
</style>