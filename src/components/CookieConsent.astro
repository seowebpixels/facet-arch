---
---

<!-- COOKIE BANNER -->
<div id="cookie-banner" class="fa-cookie-banner">
  <h2 class="banner-title">YOUR PRIVACY</h2>
  <p class="banner-text">
    Welcome to Facet Architecture! We respect your privacy and your right to control how we collect and use your personal data. Please read our&nbsp;<a
      href="/privacy-policy"
      class="cyan-link"
    >Privacy Policy</a>&nbsp;to learn about our privacy practices or click&nbsp;<button
      id="btn-banner-pref"
      type="button"
      class="cyan-btn"
    >Your preferences</button>&nbsp;to exercise control over your data.
  </p>

  <div class="banner-actions">
    <button id="btn-accept" type="button" class="btn primary-btn">I understand</button>
    <button id="btn-open-modal" type="button" class="btn secondary-btn">Your preferences</button>
    <button id="btn-reject" type="button" class="btn secondary-btn">Reject All</button>
  </div>
</div>

<!-- PREFERENCE CENTER MODAL -->
<div id="pref-modal" class="fa-pref-modal-overlay">
  <div class="pref-modal-container">
    <!-- Sidebar -->
    <div class="modal-sidebar">
      <div class="sidebar-brand">FACET ARCHITECTURE</div>
      <button type="button" class="sidebar-tab active">Consents</button>
    </div>

    <!-- Main Content Area -->
    <div class="modal-content">
      <div class="modal-header">
        <h2>YOUR PRIVACY</h2>
        <button id="btn-close-modal" type="button" class="close-btn" aria-label="Close Modal">&times;</button>
      </div>

      <p class="modal-intro">
        We collect and use data—including, where applicable, your personal data—for the purposes listed below. Please confirm whether or not that's ok with you by moving the sliders. For more information on our privacy practices, please visit our&nbsp;<a href="/privacy-policy" class="cyan-link">Privacy Policy</a>.
      </p>

      <div class="categories-list">
        <!-- Essential Services -->
        <div class="category-block">
          <div class="category-header">
            <h3>Essential Services</h3>
            <span class="badge-active">Always Active</span>
          </div>
          <p class="category-desc">
            Collection and processing of data required for essential site functionality, security, authentication, and saving privacy choices.
          </p>
          <details class="cookie-details">
            <summary class="cookie-toggle-link">Cookies &rarr;</summary>
            <ul class="cookie-list">
              <li><strong>fa_consent_preferences</strong> (Facet Architecture) - Stores user privacy preferences.</li>
              <li><strong>__cf_bm / cf_clearance</strong> (Netlify / Cloudflare) - Manages web security and bot management.</li>
            </ul>
          </details>
        </div>

        <!-- Analytics -->
        <div class="category-block">
          <div class="category-header">
            <h3>Analytics</h3>
            <label class="switch">
              <input type="checkbox" id="toggle-analytics" />
              <span class="slider"></span>
            </label>
          </div>
          <p class="category-desc">
            General business analytics, including traffic measurement, user activity patterns, and site load performance.
          </p>
          <details class="cookie-details">
            <summary class="cookie-toggle-link">Cookies &rarr;</summary>
            <ul class="cookie-list">
              <li><strong>_ga / _ga_*</strong> (Google Analytics 4) - Used to distinguish unique visitors.</li>
              <li><strong>_gid</strong> (Google Analytics) - Stores page session identifiers.</li>
            </ul>
          </details>
        </div>

        <!-- Behavioral Advertising -->
        <div class="category-block">
          <div class="category-header">
            <h3>Behavioral Advertising</h3>
            <label class="switch">
              <input type="checkbox" id="toggle-marketing" />
              <span class="slider"></span>
            </label>
          </div>
          <p class="category-desc">
            Personalized advertising and retargeting campaigns based on user interaction profiles across platforms.
          </p>
          <details class="cookie-details">
            <summary class="cookie-toggle-link">Cookies &rarr;</summary>
            <ul class="cookie-list">
              <li><strong>_fbp</strong> (Meta Pixel) - Tracks cross-platform user sessions for audience targeting.</li>
              <li><strong>_gcl_au</strong> (Google Ads) - Measures ad click conversion performance.</li>
            </ul>
          </details>
        </div>
      </div>

      <div class="modal-footer">
        <button id="btn-save-pref" type="button" class="btn save-btn">Save Preferences</button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const COOKIE_KEY = 'fa_consent_preferences_v5';

    window.openCookieModal = function() {
      const modal = document.getElementById('pref-modal');
      if (modal) modal.style.setProperty('display', 'flex', 'important');
    };

    function run() {
      const banner = document.getElementById('cookie-banner');
      const modal = document.getElementById('pref-modal');

      if (banner && banner.parentNode !== document.body) document.body.appendChild(banner);
      if (modal && modal.parentNode !== document.body) document.body.appendChild(modal);

      const btnAccept = document.getElementById('btn-accept');
      const btnReject = document.getElementById('btn-reject');
      const btnOpenModal = document.getElementById('btn-open-modal');
      const btnBannerPref = document.getElementById('btn-banner-pref');
      const btnCloseModal = document.getElementById('btn-close-modal');
      const btnSavePref = document.getElementById('btn-save-pref');

      const toggleAnalytics = document.getElementById('toggle-analytics');
      const toggleMarketing = document.getElementById('toggle-marketing');

      function save(prefs) {
        try { localStorage.setItem(COOKIE_KEY, JSON.stringify(prefs)); } catch (e) {}
        if (banner) banner.style.setProperty('display', 'none', 'important');
        if (modal) modal.style.setProperty('display', 'none', 'important');
      }

      let saved = null;
      try { saved = JSON.parse(localStorage.getItem(COOKIE_KEY)); } catch (e) {}

      if (saved && banner) {
        banner.style.setProperty('display', 'none', 'important');
      } else if (banner) {
        banner.style.setProperty('display', 'block', 'important');
      }

      btnAccept?.addEventListener('click', () => save({ essential: true, analytics: true, marketing: true }));
      btnReject?.addEventListener('click', () => save({ essential: true, analytics: false, marketing: false }));
      btnOpenModal?.addEventListener('click', window.openCookieModal);
      btnBannerPref?.addEventListener('click', window.openCookieModal);
      btnCloseModal?.addEventListener('click', () => { if (modal) modal.style.setProperty('display', 'none', 'important'); });

      btnSavePref?.addEventListener('click', () => {
        save({
          essential: true,
          analytics: toggleAnalytics ? toggleAnalytics.checked : false,
          marketing: toggleMarketing ? toggleMarketing.checked : false,
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }
  })();
</script>

<style is:global>
  :root {
    --accent-cyan: #00ffc8;
  }

  /* LINKS & HIGHLIGHTS */
  .cyan-link,
  a.cyan-link,
  a.cyan-link:hover,
  a.cyan-link:visited {
    color: var(--accent-cyan) !important;
    text-decoration: none !important;
    border-bottom: none !important;
  }

  .cyan-btn {
    background: none !important;
    border: none !important;
    padding: 0 !important;
    cursor: pointer !important;
    color: var(--accent-cyan) !important;
    font-weight: 700 !important;
    font-family: inherit !important;
    font-size: inherit !important;
  }

  /* COOKIE BANNER (Center Aligned on Mobile / Bottom-Left on Desktop) */
  .fa-cookie-banner {
    display: block !important;
    position: fixed !important;
    bottom: 1.5rem !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    width: 420px !important;
    max-width: calc(100vw - 2rem) !important;
    background-color: #000000 !important;
    color: #ffffff !important;
    padding: 1.8rem !important;
    border-radius: 16px !important;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7) !important;
    z-index: 2147483647 !important;
    font-family: system-ui, -apple-system, sans-serif !important;
    box-sizing: border-box !important;
  }

  .fa-cookie-banner .banner-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0 0 1rem 0;
    color: #ffffff;
    letter-spacing: 0.05em;
  }

  .fa-cookie-banner .banner-text {
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
    color: #cccccc;
  }

  .fa-cookie-banner .banner-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* BUTTONS */
  .fa-cookie-banner .btn,
  .fa-pref-modal-overlay .btn {
    width: 100%;
    padding: 0.85rem;
    border-radius: 30px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    border: none;
    transition: background-color 0.2s ease;
  }

  .fa-cookie-banner .primary-btn {
    background-color: #444444;
    color: #ffffff;
  }

  .fa-cookie-banner .secondary-btn {
    background-color: #222222;
    color: #ffffff;
  }

  /* PREFERENCE CENTER MODAL OVERLAY */
  .fa-pref-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    z-index: 2147483647 !important;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    backdrop-filter: blur(4px);
    box-sizing: border-box;
  }

  .fa-pref-modal-overlay .pref-modal-container {
    display: flex;
    width: 100%;
    max-width: 900px;
    height: 85vh;
    max-height: 650px;
    background: #ffffff;
    color: #111111;
    border-radius: 12px;
    overflow: hidden;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .fa-pref-modal-overlay .modal-sidebar {
    width: 220px;
    background: #f7f7f7;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    border-right: 1px solid #e5e5e5;
    flex-shrink: 0;
  }

  .fa-pref-modal-overlay .sidebar-brand {
    font-family: 'Nesobrite', 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    line-height: 1.3;
  }

  .fa-pref-modal-overlay .sidebar-tab.active {
    background: #e9e9e9;
    border: none;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    text-align: left;
    font-weight: 700;
    margin-top: 1.5rem;
  }

  .fa-pref-modal-overlay .modal-content {
    flex: 1;
    padding: 2rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  .fa-pref-modal-overlay .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .fa-pref-modal-overlay .modal-header h2 {
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0;
  }

  .fa-pref-modal-overlay .close-btn {
    background: none;
    border: none;
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
    color: #111111;
  }

  .fa-pref-modal-overlay .modal-intro {
    font-size: 0.88rem;
    color: #555555;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .fa-pref-modal-overlay .categories-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .fa-pref-modal-overlay .category-block {
    border-top: 1px solid #eeeeee;
    padding-top: 1rem;
  }

  .fa-pref-modal-overlay .category-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .fa-pref-modal-overlay .category-header h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .fa-pref-modal-overlay .badge-active {
    font-size: 0.8rem;
    font-weight: 700;
    color: #00875a;
  }

  .fa-pref-modal-overlay .category-desc {
    font-size: 0.85rem;
    color: #666666;
    margin: 0.5rem 0 0.75rem 0;
    line-height: 1.4;
  }

  .fa-pref-modal-overlay .cookie-toggle-link {
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    color: #111111;
  }

  .fa-pref-modal-overlay .cookie-list {
    margin: 0.5rem 0 0 1rem;
    padding: 0;
    font-size: 0.8rem;
    color: #555555;
  }

  /* TOGGLE SWITCHES */
  .fa-pref-modal-overlay .switch {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 24px;
  }

  .fa-pref-modal-overlay .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .fa-pref-modal-overlay .slider {
    position: absolute;
    cursor: pointer;
    inset: 0;
    background-color: #ccc;
    transition: .3s;
    border-radius: 24px;
  }

  .fa-pref-modal-overlay .slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: .3s;
    border-radius: 50%;
  }

  .fa-pref-modal-overlay input:checked + .slider {
    background-color: #00875a;
  }

  .fa-pref-modal-overlay input:checked + .slider:before {
    transform: translateX(20px);
  }

  .fa-pref-modal-overlay .modal-footer {
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .fa-pref-modal-overlay .save-btn {
    background-color: #7f56d9;
    color: #ffffff;
    width: auto;
    padding: 0.75rem 2rem;
  }

  /* DESKTOP POSITIONING */
  @media (min-width: 769px) {
    .fa-cookie-banner {
      left: 2rem !important;
      transform: none !important;
    }
  }

  /* MOBILE RESPONSIVE FIXES */
  @media (max-width: 768px) {
    .fa-pref-modal-overlay {
      padding: 0.75rem !important;
    }

    .fa-pref-modal-overlay .pref-modal-container {
      flex-direction: column !important;
      height: 92vh !important;
      max-height: none !important;
    }

    .fa-pref-modal-overlay .modal-sidebar {
      width: 100% !important;
      border-right: none !important;
      border-bottom: 1px solid #e5e5e5 !important;
      padding: 1rem 1.25rem !important;
      box-sizing: border-box !important;
      flex-direction: row !important;
      align-items: center !important;
      justify-content: space-between !important;
    }

    .fa-pref-modal-overlay .sidebar-tab.active {
      margin-top: 0 !important;
      padding: 0.4rem 0.8rem !important;
      font-size: 0.8rem !important;
    }

    .fa-pref-modal-overlay .modal-content {
      padding: 1.25rem !important;
    }

    .fa-pref-modal-overlay .save-btn {
      width: 100% !important;
    }
  }
</style>