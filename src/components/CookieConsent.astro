---
---

<!-- COOKIE BANNER (Bottom-Left Corner) -->
<div id="cookie-banner" class="fa-cookie-banner">
  <h2 class="banner-title">Your Privacy</h2>
  <p class="banner-text">
    Welcome to Facet Architecture! We respect your privacy and your right to control how we collect and use your personal data. Please read our <a href="/privacy-policy" class="highlight-link">Privacy Policy</a> to learn about our privacy practices or click <button id="btn-banner-pref" class="text-btn highlight-text">Your preferences</button> to exercise control over your data.
  </p>

  <div class="banner-actions">
    <button id="btn-accept" class="btn primary-btn">I understand</button>
    <button id="btn-open-modal" class="btn secondary-btn">Your preferences</button>
    <button id="btn-reject" class="btn secondary-btn">Reject All</button>
  </div>
</div>

<!-- PREFERENCE CENTER MODAL -->
<div id="pref-modal" class="pref-modal-overlay">
  <div class="pref-modal-container">
    <div class="modal-sidebar">
      <div class="sidebar-brand">FACET ARCHITECTURE</div>
      <button class="sidebar-tab active">Consents</button>
      <div class="sidebar-footer">
        <a href="/privacy-policy" class="highlight-link">Privacy Policy</a>
      </div>
    </div>

    <div class="modal-content">
      <div class="modal-header">
        <h2>Your Privacy</h2>
        <button id="btn-close-modal" class="close-btn">&times;</button>
      </div>

      <p class="modal-intro">
        We collect and use data—including, where applicable, your personal data—for the purposes listed below. Please confirm whether or not that's ok with you by moving the sliders. For more information on our privacy practices, please visit our <a href="/privacy-policy" class="highlight-link">Privacy Policy</a>.
      </p>

      <div class="consent-categories">
        <!-- Essential Services -->
        <div class="category-block">
          <div class="category-header">
            <h3>Essential Services</h3>
            <span class="badge-active">Always Active</span>
          </div>
          <p class="category-desc">
            Collection and processing of data required for essential site functionality, security, authentication, and saving privacy choices.
          </p>
          <details class="cookie-details">
            <summary class="cookie-toggle-link">Cookies &rarr;</summary>
            <ul class="cookie-list">
              <li><strong>fa_consent_preferences</strong> (Facet Architecture) - Stores user privacy preferences.</li>
              <li><strong>__cf_bm / cf_clearance</strong> (Netlify / Cloudflare) - Manages web security and bot management.</li>
            </ul>
          </details>
        </div>

        <!-- Analytics -->
        <div class="category-block">
          <div class="category-header">
            <h3>Analytics</h3>
            <label class="switch">
              <input type="checkbox" id="toggle-analytics" />
              <span class="slider"></span>
            </label>
          </div>
          <p class="category-desc">
            General business analytics, including traffic measurement, user activity patterns, and site load performance.
          </p>
          <details class="cookie-details">
            <summary class="cookie-toggle-link">Cookies &rarr;</summary>
            <ul class="cookie-list">
              <li><strong>_ga / _ga_*</strong> (Google Analytics 4) - Used to distinguish unique visitors.</li>
              <li><strong>_gid</strong> (Google Analytics) - Stores page session identifiers.</li>
            </ul>
          </details>
        </div>

        <!-- Behavioral Advertising -->
        <div class="category-block">
          <div class="category-header">
            <h3>Behavioral Advertising</h3>
            <label class="switch">
              <input type="checkbox" id="toggle-marketing" />
              <span class="slider"></span>
            </label>
          </div>
          <p class="category-desc">
            Personalized advertising and retargeting campaigns based on user interaction profiles across platforms.
          </p>
          <details class="cookie-details">
            <summary class="cookie-toggle-link">Cookies &rarr;</summary>
            <ul class="cookie-list">
              <li><strong>_fbp</strong> (Meta Pixel) - Tracks cross-platform user sessions for audience targeting.</li>
              <li><strong>_gcl_au</strong> (Google Ads) - Measures ad click conversion performance.</li>
            </ul>
          </details>
        </div>
      </div>

      <div class="modal-footer">
        <button id="btn-save-pref" class="btn save-btn">Save Preferences</button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const COOKIE_KEY = 'fa_consent_preferences';

    // Global modal opener accessible from HomeFooter
    window.openCookieModal = function() {
      const modal = document.getElementById('pref-modal');
      if (modal) modal.style.display = 'flex';
    };

    function setupConsent() {
      const banner = document.getElementById('cookie-banner');
      const modal = document.getElementById('pref-modal');

      const btnAccept = document.getElementById('btn-accept');
      const btnReject = document.getElementById('btn-reject');
      const btnOpenModal = document.getElementById('btn-open-modal');
      const btnBannerPref = document.getElementById('btn-banner-pref');
      const btnCloseModal = document.getElementById('btn-close-modal');
      const btnSavePref = document.getElementById('btn-save-pref');

      const toggleAnalytics = document.getElementById('toggle-analytics');
      const toggleMarketing = document.getElementById('toggle-marketing');

      function savePreferences(prefs) {
        try { localStorage.setItem(COOKIE_KEY, JSON.stringify(prefs)); } catch (e) {}
        if (banner) banner.classList.add('fa-hidden');
        if (modal) modal.style.display = 'none';
      }

      // Hide banner only if user explicitly saved choices previously
      let saved = null;
      try { saved = JSON.parse(localStorage.getItem(COOKIE_KEY)); } catch (e) {}

      if (saved && banner) {
        banner.classList.add('fa-hidden');
      } else if (banner) {
        banner.classList.remove('fa-hidden');
      }

      btnAccept?.addEventListener('click', function() {
        savePreferences({ essential: true, analytics: true, marketing: true });
      });

      btnReject?.addEventListener('click', function() {
        savePreferences({ essential: true, analytics: false, marketing: false });
      });

      btnOpenModal?.addEventListener('click', window.openCookieModal);
      btnBannerPref?.addEventListener('click', window.openCookieModal);

      btnCloseModal?.addEventListener('click', function() {
        if (modal) modal.style.display = 'none';
      });

      btnSavePref?.addEventListener('click', function() {
        savePreferences({
          essential: true,
          analytics: toggleAnalytics ? toggleAnalytics.checked : false,
          marketing: toggleMarketing ? toggleMarketing.checked : false,
        });
      });
    }

    if (document.readyState === 'interactive' || document.readyState === 'complete') {
      setupConsent();
    } else {
      document.addEventListener('DOMContentLoaded', setupConsent);
    }
  })();
</script>

<style>
  :root {
    --accent-cyan: #00ffc8;
  }

  .highlight-link {
    color: var(--accent-cyan) !important;
    /* text-decoration: underline; -- REMOVED */
  }

  .highlight-text {
    color: var(--accent-cyan) !important;
    font-weight: 700;
  }

  .text-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-size: inherit;
    font-family: inherit;
  }

  /* COOKIE BANNER */
  .fa-cookie-banner {
    display: block !important;
    position: fixed !important;
    bottom: 2rem !important;
    left: 2rem !important;
    width: clamp(300px, 90vw, 420px) !important;
    background-color: #000000 !important;
    color: #ffffff !important;
    padding: 1.8rem !important;
    border-radius: 16px !important;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4) !important;
    z-index: 99999 !important;
    font-family: system-ui, -apple-system, sans-serif !important;
  }

  .fa-cookie-banner.fa-hidden {
    display: none !important;
  }

  .banner-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0 0 1rem 0;
    color: #ffffff;
  }

  .banner-text {
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
    color: #cccccc;
  }

  .banner-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .btn {
    width: 100%;
    padding: 0.85rem;
    border-radius: 30px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
  }

  .primary-btn {
    background-color: #444444;
    color: #ffffff;
  }

  .primary-btn:hover {
    background-color: #555555;
  }

  .secondary-btn {
    background-color: #222222;
    color: #ffffff;
  }

  .secondary-btn:hover {
    background-color: #333333;
  }

  /* PREFERENCE CENTER MODAL */
  .pref-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    z-index: 100000;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    backdrop-filter: blur(4px);
  }

  .pref-modal-container {
    display: flex;
    width: 100%;
    max-width: 900px;
    height: 85vh;
    max-height: 650px;
    background: #ffffff;
    color: #111111;
    border-radius: 12px;
    overflow: hidden;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .modal-sidebar {
    width: 220px;
    background: #f7f7f7;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid #e5e5e5;
  }

  .sidebar-brand {
    font-family: 'Nesobrite', sans-serif;
    font-weight: 900;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
  }

  .sidebar-tab.active {
    background: #e9e9e9;
    border: none;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    text-align: left;
    font-weight: 700;
    margin-top: 2rem;
  }

  .modal-content {
    flex: 1;
    padding: 2rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .modal-header h2 {
    font-size: 1.8rem;
    font-weight: 800;
    margin: 0;
  }

  .close-btn {
    background: none;
    border: none;
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
  }

  .modal-intro {
    font-size: 0.9rem;
    color: #555555;
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .category-block {
    border-top: 1px solid #eeeeee;
    padding: 1.25rem 0;
  }

  .category-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .category-header h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .badge-active {
    font-size: 0.8rem;
    font-weight: 700;
    color: #00875a;
  }

  .category-desc {
    font-size: 0.85rem;
    color: #666666;
    margin: 0.5rem 0 0.75rem 0;
    line-height: 1.4;
  }

  .cookie-toggle-link {
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    color: #111111;
  }

  .cookie-list {
    margin: 0.5rem 0 0 1rem;
    padding: 0;
    font-size: 0.8rem;
    color: #555555;
  }

  /* TOGGLE SWITCHES */
  .switch {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 24px;
  }

  .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .slider {
    position: absolute;
    cursor: pointer;
    inset: 0;
    background-color: #ccc;
    transition: .3s;
    border-radius: 24px;
  }

  .slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: .3s;
    border-radius: 50%;
  }

  input:checked + .slider {
    background-color: #00875a;
  }

  input:checked + .slider:before {
    transform: translateX(20px);
  }

  .modal-footer {
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .save-btn {
    background-color: #7f56d9;
    color: #ffffff;
    width: auto;
    padding: 0.75rem 2rem;
  }

  @media (max-width: 768px) {
    .fa-cookie-banner {
      bottom: 1rem !important;
      left: 1rem !important;
      right: 1rem !important;
      width: auto !important;
    }

    .pref-modal-container {
      flex-direction: column;
      height: 90vh;
    }

    .modal-sidebar {
      width: 100%;
      height: auto;
      border-right: none;
      border-bottom: 1px solid #e5e5e5;
      padding: 1rem;
    }
  }
</style>