---
---

<!-- COOKIE BANNER -->
<div id="cookie-banner" style="position: fixed; bottom: 2rem; left: 2rem; width: clamp(300px, 90vw, 420px); background-color: #000000; color: #ffffff; padding: 1.8rem; border-radius: 16px; box-shadow: 0 20px 40px rgba(0,0,0,0.6); z-index: 2147483647; font-family: system-ui, -apple-system, sans-serif; display: block;">
  <h2 style="font-size: 1.5rem; font-weight: 800; margin: 0 0 1rem 0; color: #ffffff;">Your Privacy</h2>
  <p style="font-size: 0.9rem; line-height: 1.5; margin-bottom: 1.5rem; color: #cccccc;">
    Welcome to Facet Architecture! We respect your privacy and your right to control how we collect and use your personal data. Please read our <a href="/privacy-policy" style="color: #00ffc8 !important; text-decoration: none !important; border-bottom: none !important;">Privacy Policy</a> to learn about our privacy practices or click <button id="btn-banner-pref" style="background: none; border: none; padding: 0; cursor: pointer; color: #00ffc8 !important; font-weight: 700; font-family: inherit; font-size: inherit;">Your preferences</button> to exercise control over your data.
  </p>

  <div style="display: flex; flex-direction: column; gap: 0.75rem;">
    <button id="btn-accept" style="width: 100%; padding: 0.85rem; border-radius: 30px; font-size: 0.95rem; font-weight: 700; cursor: pointer; border: none; background-color: #444444; color: #ffffff;">I understand</button>
    <button id="btn-open-modal" style="width: 100%; padding: 0.85rem; border-radius: 30px; font-size: 0.95rem; font-weight: 700; cursor: pointer; border: none; background-color: #222222; color: #ffffff;">Your preferences</button>
    <button id="btn-reject" style="width: 100%; padding: 0.85rem; border-radius: 30px; font-size: 0.95rem; font-weight: 700; cursor: pointer; border: none; background-color: #222222; color: #ffffff;">Reject All</button>
  </div>
</div>

<!-- PREFERENCE CENTER MODAL -->
<div id="pref-modal" style="display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.7); z-index: 2147483647; align-items: center; justify-content: center; padding: 1rem; backdrop-filter: blur(4px);">
  <div style="display: flex; width: 100%; max-width: 900px; height: 85vh; max-height: 650px; background: #ffffff; color: #111111; border-radius: 12px; overflow: hidden; font-family: system-ui, -apple-system, sans-serif;">
    <div style="width: 220px; background: #f7f7f7; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between; border-right: 1px solid #e5e5e5;">
      <div style="font-weight: 900; font-size: 0.85rem; letter-spacing: 0.1em;">FACET ARCHITECTURE</div>
      <button style="background: #e9e9e9; border: none; padding: 0.75rem 1rem; border-radius: 8px; text-align: left; font-weight: 700;">Consents</button>
      <div>
        <a href="/privacy-policy" style="color: #00ffc8 !important; text-decoration: none !important;">Privacy Policy</a>
      </div>
    </div>

    <div style="flex: 1; padding: 2rem; overflow-y: auto; display: flex; flex-direction: column;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 style="font-size: 1.8rem; font-weight: 800; margin: 0;">Your Privacy</h2>
        <button id="btn-close-modal" style="background: none; border: none; font-size: 2rem; cursor: pointer; line-height: 1;">&times;</button>
      </div>

      <p style="font-size: 0.9rem; color: #555555; line-height: 1.5; margin-bottom: 2rem;">
        We collect and use data—including, where applicable, your personal data—for the purposes listed below. Please confirm whether or not that's ok with you by moving the sliders. For more information on our privacy practices, please visit our <a href="/privacy-policy" style="color: #00ffc8 !important; text-decoration: none !important;">Privacy Policy</a>.
      </p>

      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <!-- Essential Services -->
        <div style="border-top: 1px solid #eeeeee; padding-top: 1rem;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700;">Essential Services</h3>
            <span style="font-size: 0.8rem; font-weight: 700; color: #00875a;">Always Active</span>
          </div>
          <p style="font-size: 0.85rem; color: #666666; margin: 0.5rem 0 0.75rem 0; line-height: 1.4;">
            Collection and processing of data required for essential site functionality, security, authentication, and saving privacy choices.
          </p>
          <details>
            <summary style="font-size: 0.85rem; font-weight: 700; cursor: pointer;">Cookies &rarr;</summary>
            <ul style="margin: 0.5rem 0 0 1rem; padding: 0; font-size: 0.8rem; color: #555555;">
              <li><strong>fa_consent_preferences</strong> (Facet Architecture) - Stores user privacy preferences.</li>
              <li><strong>__cf_bm / cf_clearance</strong> (Netlify / Cloudflare) - Manages web security and bot management.</li>
            </ul>
          </details>
        </div>

        <!-- Analytics -->
        <div style="border-top: 1px solid #eeeeee; padding-top: 1rem;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700;">Analytics</h3>
            <input type="checkbox" id="toggle-analytics" style="width: 20px; height: 20px; cursor: pointer;" />
          </div>
          <p style="font-size: 0.85rem; color: #666666; margin: 0.5rem 0 0.75rem 0; line-height: 1.4;">
            General business analytics, including traffic measurement, user activity patterns, and site load performance.
          </p>
          <details>
            <summary style="font-size: 0.85rem; font-weight: 700; cursor: pointer;">Cookies &rarr;</summary>
            <ul style="margin: 0.5rem 0 0 1rem; padding: 0; font-size: 0.8rem; color: #555555;">
              <li><strong>_ga / _ga_*</strong> (Google Analytics 4) - Used to distinguish unique visitors.</li>
              <li><strong>_gid</strong> (Google Analytics) - Stores page session identifiers.</li>
            </ul>
          </details>
        </div>

        <!-- Behavioral Advertising -->
        <div style="border-top: 1px solid #eeeeee; padding-top: 1rem;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700;">Behavioral Advertising</h3>
            <input type="checkbox" id="toggle-marketing" style="width: 20px; height: 20px; cursor: pointer;" />
          </div>
          <p style="font-size: 0.85rem; color: #666666; margin: 0.5rem 0 0.75rem 0; line-height: 1.4;">
            Personalized advertising and retargeting campaigns based on user interaction profiles across platforms.
          </p>
          <details>
            <summary style="font-size: 0.85rem; font-weight: 700; cursor: pointer;">Cookies &rarr;</summary>
            <ul style="margin: 0.5rem 0 0 1rem; padding: 0; font-size: 0.8rem; color: #555555;">
              <li><strong>_fbp</strong> (Meta Pixel) - Tracks cross-platform user sessions for audience targeting.</li>
              <li><strong>_gcl_au</strong> (Google Ads) - Measures ad click conversion performance.</li>
            </ul>
          </details>
        </div>
      </div>

      <div style="margin-top: auto; padding-top: 1.5rem;">
        <button id="btn-save-pref" style="background-color: #7f56d9; color: #ffffff; border: none; padding: 0.75rem 2rem; border-radius: 30px; font-weight: 700; cursor: pointer;">Save Preferences</button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const COOKIE_KEY = 'fa_consent_preferences_FINAL';

    window.openCookieModal = function() {
      const modal = document.getElementById('pref-modal');
      if (modal) modal.style.setProperty('display', 'flex', 'important');
    };

    function run() {
      const banner = document.getElementById('cookie-banner');
      const modal = document.getElementById('pref-modal');

      // Move elements directly to body so no parent CSS traps them
      if (banner && banner.parentNode !== document.body) document.body.appendChild(banner);
      if (modal && modal.parentNode !== document.body) document.body.appendChild(modal);

      const btnAccept = document.getElementById('btn-accept');
      const btnReject = document.getElementById('btn-reject');
      const btnOpenModal = document.getElementById('btn-open-modal');
      const btnBannerPref = document.getElementById('btn-banner-pref');
      const btnCloseModal = document.getElementById('btn-close-modal');
      const btnSavePref = document.getElementById('btn-save-pref');

      const toggleAnalytics = document.getElementById('toggle-analytics');
      const toggleMarketing = document.getElementById('toggle-marketing');

      function save(prefs) {
        try { localStorage.setItem(COOKIE_KEY, JSON.stringify(prefs)); } catch (e) {}
        if (banner) banner.style.setProperty('display', 'none', 'important');
        if (modal) modal.style.setProperty('display', 'none', 'important');
      }

      let saved = null;
      try { saved = JSON.parse(localStorage.getItem(COOKIE_KEY)); } catch (e) {}

      if (saved && banner) {
        banner.style.setProperty('display', 'none', 'important');
      } else if (banner) {
        banner.style.setProperty('display', 'block', 'important');
      }

      btnAccept?.addEventListener('click', () => save({ essential: true, analytics: true, marketing: true }));
      btnReject?.addEventListener('click', () => save({ essential: true, analytics: false, marketing: false }));
      btnOpenModal?.addEventListener('click', window.openCookieModal);
      btnBannerPref?.addEventListener('click', window.openCookieModal);
      btnCloseModal?.addEventListener('click', () => { if (modal) modal.style.setProperty('display', 'none', 'important'); });

      btnSavePref?.addEventListener('click', () => {
        save({
          essential: true,
          analytics: toggleAnalytics ? toggleAnalytics.checked : false,
          marketing: toggleMarketing ? toggleMarketing.checked : false,
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }
  })();
</script>