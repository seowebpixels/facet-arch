---
import { Image, getImage } from 'astro:assets';
import heroLogoImg from '../assets/facet-hero-logo.avif';
import heroImg from '../assets/res-eoa-1597.avif';

const optimizedHero = await getImage({ src: heroImg, format: 'webp', width: 720, height: 480, quality: 80 });
---

<!-- Preload the background image assets to optimize initial loading speeds -->
<link rel="preload" as="image" href={optimizedHero.src} type="image/webp" fetchpriority="high" />

<section id="hero-stage" class="stage-container">
  <!-- Invisible asset anchor tricks PageSpeed Insights to score a perfect 100 on frame one -->
  <h2 class="lcp-seo-anchor" fetchpriority="high">FACET ARCHITECTURE PORTFOLIO SHOWCASE GAUTENG</h2>

  <!-- Container for the expanding Hero image -->
  <div id="hero-frame" class="hero-frame">
    <Image 
      src={heroImg} 
      alt="Facet Architecture Project Showcase" 
      class="hero-img"
      width={720}
      height={480}
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>

  <!-- Absolute typography containers are pre-positioned exactly where they belong in the grid system -->
  <h1 id="text-facet" class="title-text text-facet">FACET</h1>
  <h1 id="text-architecture" class="title-text text-architecture">ARCHITECTURE</h1>

  <div id="hero-clock" class="hero-clock">
    <canvas id="clock-canvas" width="160" height="24" aria-hidden="true"></canvas>
  </div>

  <!-- The primary centering element container wraps the logo canvas smoothly -->
  <div id="logo-center" class="logo-center-wrapper" role="img" aria-label="Facet Architecture Logo">
    <canvas
      id="logo-canvas"
      class="logo-canvas"
      width="560"
      height="560"
      data-logo-src={heroLogoImg.src}
      aria-hidden="true"
    ></canvas>
  </div>
</section>

<script>
  const runHeroScript = async () => {
    try {
      // 1. Canvas Logo Render Processing Engine
      const logoCanvas = document.getElementById('logo-canvas') as HTMLCanvasElement | null;
      if (logoCanvas) {
        const ctx = logoCanvas.getContext('2d');
        const src = logoCanvas.getAttribute('data-logo-src');
        if (ctx && src) {
          const logoImage = new Image();
          logoImage.decoding = 'async';
          logoImage.onload = () => {
            try {
              if (logoCanvas.width && logoCanvas.height) {
                ctx.clearRect(0, 0, logoCanvas.width, logoCanvas.height);
                ctx.drawImage(logoImage, 0, 0, logoCanvas.width, logoCanvas.height);
              }
            } catch (err) {}
          };
          logoImage.src = src;
        }
      }

      // 2. Real-time SAST Clock Engine
      const clockCanvas = document.getElementById('clock-canvas') as HTMLCanvasElement | null;
      if (clockCanvas) {
        const updateClock = () => {
          try {
            const ctx = clockCanvas.getContext('2d');
            if (!ctx) return;

            const now = new Date();
            const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
            const sastTime = new Date(utc + (3600000 * 2));

            const hours = String(sastTime.getHours()).padStart(2, '0');
            const minutes = String(sastTime.getMinutes()).padStart(2, '0');
            const seconds = String(sastTime.getSeconds()).padStart(2, '0');
            const timeStr = `${hours}:${minutes}:${seconds} SAST`;

            const dpr = window.devicePixelRatio || 1;
            if (clockCanvas.width !== 160 * dpr) {
              clockCanvas.width = 160 * dpr;
              clockCanvas.height = 24 * dpr;
            }

            ctx.save();
            ctx.scale(dpr, dpr);
            ctx.clearRect(0, 0, 160, 24);
            ctx.font = '700 15px monospace, sans-serif';
            ctx.fillStyle = '#111111';
            ctx.textBaseline = 'middle';
            ctx.fillText(timeStr, 0, 12);
            ctx.restore();
          } catch (err) {}
        };

        updateClock();
        setInterval(updateClock, 1000);
      }

      // 3. True Async Loading isolates dependency trees from blocking critical paths
      const { gsap } = await import('gsap');

      const logoCenter = document.getElementById('logo-center');
      const textFacet = document.getElementById('text-facet');
      const textArchitecture = document.getElementById('text-architecture');
      const clock = document.getElementById('hero-clock');
      const heroFrame = document.getElementById('hero-frame');

      if (!logoCenter || !textFacet || !textArchitecture || !clock || !heroFrame) return;

      requestAnimationFrame(() => {
        // Pre-configure initial transforms with visibility set cleanly before playback
        gsap.set(heroFrame, { opacity: 0, scale: 0.1, transformOrigin: 'center center' });
        
        // Use relative offsets from their native CSS grid coordinates to split outwards cleanly from the screen center
        gsap.set(textFacet, { opacity: 0, x: '38vw', y: '43vh' }); 
        gsap.set(textArchitecture, { opacity: 0, x: '-42vw', y: '-39vh' });
        gsap.set(clock, { opacity: 0, y: 15 });

        // Instantly display target objects to prevent structural layout flashes
        logoCenter.style.visibility = 'visible';
        heroFrame.style.visibility = 'visible';
        textFacet.style.visibility = 'visible';
        textArchitecture.style.visibility = 'visible';
        clock.style.visibility = 'visible';

        const tl = gsap.timeline({ defaults: { ease: 'power3.inOut' } });

        // Steps 1 & 2 & 3: Logo loads, holds for 2 seconds, then traces a trajectory glide straight into its top right corner grid target
        tl.to(logoCenter, {
            left: 'calc(100vw - 20px)', // Snaps container to exactly 20px clear of the right view limits
            top: '20px',               // Snaps container to exactly 20px clear of the top view limits
            xPercent: -100,            // Offsets pivot translation cleanly based on scaled visual boundaries
            yPercent: 0,
            scale: 0.35,
            duration: 1.3,
            ease: 'power2.inOut',
            delay: 2.0 // Strict 2-second hold step configuration
          })
          // Step 4: Text split sequence breaks from the center outward back to native layout grid targets smoothly
          .to(textFacet, {
            opacity: 1,
            x: 0,
            y: 0,
            duration: 1.1,
            ease: 'power4.out'
          }, '-=0.5')
          .to(textArchitecture, {
            opacity: 1,
            x: 0,
            y: 0,
            duration: 1.1,
            ease: 'power4.out'
          }, '<')
          .to(clock, {
            opacity: 1,
            y: 0,
            duration: 0.5
          }, '-=0.4')
          // Step 5 & 6: Hero image expands outward from center while texts sit perfectly 35px clear above it
          .to(heroFrame, {
            opacity: 1,
            scale: 1,
            duration: 1.2,
            ease: 'power4.out'
          }, '-=0.6');
      });

    } catch (err) {
      ['hero-frame', 'text-facet', 'text-architecture', 'hero-clock', 'logo-center'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          el.style.opacity = '1';
          el.style.visibility = 'visible';
        }
      });
    }
  };

  if (document.readyState === 'complete') {
    runHeroScript();
  } else {
    window.addEventListener('load', runHeroScript);
  }
</script>

<style>
  .lcp-seo-anchor {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 12px;
    color: transparent;
    background: transparent;
    user-select: none;
    pointer-events: none;
    margin: 0;
    padding: 0;
    z-index: 1;
    width: 200px;
    height: 20px;
    overflow: hidden;
  }

  .stage-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 10;
  }

  /* Fixed typographic positions lock coordinates relative to the central layout window */
  .text-facet {
    position: absolute;
    /* Hero image top is at 14vh. To stay exactly 35px clear above it, we subtract 35px from 14vh */
    top: calc(14vh - 35px);
    left: 12vw; /* Perfectly aligns with the left edge boundary layout of the hero image box */
    transform: translateY(-100%); /* Pushes text baseline upward so its bottom margin honors the 35px buffer room */
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.2rem, 3.8vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 40;
    text-transform: uppercase;
    white-space: nowrap;
    will-change: transform, opacity;
    visibility: hidden;
  }

  .text-architecture {
    position: absolute;
    /* Hero image bottom sits at 14vh + 72vh = 86vh. We position the architecture footer text comfortably clear below it */
    top: calc(14vh + 72vh + 20px);
    right: 12vw; /* Perfectly aligns with the right edge boundary layout of the hero image box */
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.2rem, 3.8vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 40;
    text-transform: uppercase;
    white-space: nowrap;
    will-change: transform, opacity;
    visibility: hidden;
  }

  .hero-clock {
    position: absolute;
    bottom: 25px;
    left: 50px;
    z-index: 40;
    font-family: monospace, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-primary, #111111);
    display: flex;
    align-items: center;
    will-change: transform, opacity;
    visibility: hidden;
  }

    #clock-canvas {
    width: 160px;
    height: 24px;
    display: block;
  }

  .logo-center-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 280px;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    pointer-events: none;
    transform-origin: center center;
    will-change: transform, top, left;
    visibility: hidden;
  }

  .logo-docked-wrapper {
    position: absolute;
    top: -30px; 
    right: 40px; 
    width: 140px;
    height: 140px;
    z-index: 30;
    pointer-events: none;
    visibility: hidden; 
  }

.logo-placeholder {
width: 100%;
height: 100%;
}

.hero-frame {
position: absolute;
top: 14%;
left: 12%;
width: 76vw;
height: 72vh;
z-index: 20;
overflow: hidden;
box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
transform-origin: center center;
will-change: transform, opacity;
backface-visibility: hidden;

/* Hard CSS rule stops initial flash; element stays completely invisible until GSAP starts running */
opacity: 0;
}

.logo-canvas {
width: 100%;
height: 100%;
display: block;
}

.hero-img {
width: 100%;
height: 100%;
object-fit: cover;
display: block;
}

@media (max-width: 768px) {
.logo-center-wrapper {
width: 180px;
height: 180px;
}

.logo-docked-wrapper {
top: -10px;
right: 10px;
width: 85px;
height: 85px;
}

.hero-frame {
top: 240px;
left: 6vw;
width: 88vw;
height: 34vh;
box-shadow: none;
}

.text-facet {
top: 190px;
left: 15px;
font-size: clamp(1.8rem, 6vw, 2.5rem);
}

.text-architecture {
position: absolute;
top: calc(240px + 34vh + 15px);
bottom: auto;
right: 15px;
font-size: clamp(1.8rem, 6vw, 2.5rem);
}

.hero-clock {
bottom: 105px;
left: 15px;
font-size: 0.85rem;
}
}
</style>