---
import { Image, getImage } from 'astro:assets';
import heroLogoImg from '../assets/facet-logo-white.avif';

// Import showcase images
import resHeroImg from '../assets/res-eoa-1597.avif'; // Primary Intro Frame (LCP target)
import resDavidImg from '../assets/res-david.avif';  // Fullscreen Ken Burns Slide 1 (High Res replacement)
import resBlannImg from '../assets/res-blann.avif';  // Slide 2
import ascotManorImg from '../assets/dev-kubu.avif'; // Slide 3
import intStarckImg from '../assets/int-starck.avif';// Slide 4

const backgroundSlides = [resDavidImg, resBlannImg, ascotManorImg, intStarckImg];

// Mobile LCP Target Optimization for Primary Intro Frame
const optimisedHero = await getImage({ 
  src: resHeroImg, 
  format: 'avif', 
  width: 640, 
  height: 360, 
  quality: 75 
});

// Canvas Logo Source
const optimisedLogo = await getImage({
  src: heroLogoImg,
  format: 'webp',
  width: 560,
  height: 560,
  quality: 75
});
---

<!-- Single critical LCP preload target -->
<link rel="preload" as="image" href={optimisedHero.src} type="image/avif" fetchpriority="high" />

<section id="hero-stage" class="stage-container">
  <h2 class="lcp-seo-anchor">FACET ARCHITECTURE PORTFOLIO SHOWCASE GAUTENG</h2>

  <div id="hero-text-container" class="hero-text-container">
    <h1 id="text-facet" class="title-text text-facet">FACET</h1>
    <h1 id="text-architecture" class="title-text text-architecture">ARCHITECTURE</h1>
  </div>

  <!-- Fullscreen Container for Ken Burns Slides -->
  <div id="fullscreen-bg" class="fullscreen-bg">
    {backgroundSlides.map((img, index) => (
      <Image 
        src={img} 
        alt={`Facet Architecture Showcase Slide ${index + 1}`} 
        class={`hero-img slide-img ${index === 0 ? 'active' : ''}`}
        widths={[360, 640, 1080, 1920]}
        sizes="100vw"
        format="avif"
        quality={72}
        loading={index === 0 ? "eager" : "lazy"}
        fetchpriority={index === 0 ? "high" : "low"}
        decoding="async"
      />
    ))}
  </div>

  <div id="hero-frame" class="hero-frame">
    <!-- Initial Intro Focal Frame (Primary LCP Element) -->
    <Image 
      src={resHeroImg} 
      alt="Facet Architecture Initial Hero" 
      class="hero-img intro-frame-img"
      widths={[360, 640, 1080]}
      sizes="(max-width: 768px) 100vw, 76vw"
      format="avif"
      quality={75}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div id="hero-clock" class="hero-clock">
    <canvas id="clock-canvas" width="160" height="24" aria-hidden="true"></canvas>
  </div>

  <div id="logo-center" class="logo-center-wrapper" role="img" aria-label="Facet Architecture Logo">
    <canvas
      id="logo-canvas"
      class="logo-canvas"
      width="430"
      height="430"
      data-logo-src={optimisedLogo.src}
      aria-hidden="true"
    ></canvas>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function initHero() {
    gsap.config({ force3D: true });

    // 1. Canvas Logo Render Engine
    const logoCanvas = document.getElementById('logo-canvas') as HTMLCanvasElement | null;
    if (logoCanvas) {
      const ctx = logoCanvas.getContext('2d');
      const src = logoCanvas.getAttribute('data-logo-src');
      if (ctx && src) {
        const dpr = window.devicePixelRatio || 1;
        const displaySize = window.innerWidth <= 768 ? 280 : 430;
        
        logoCanvas.width = displaySize * dpr;
        logoCanvas.height = displaySize * dpr;

        const logoImage = new Image();
        logoImage.onload = () => {
          ctx.save();
          ctx.scale(dpr, dpr);
          ctx.imageSmoothingEnabled = true;
          ctx.imageSmoothingQuality = 'high';
          ctx.clearRect(0, 0, displaySize, displaySize);
          ctx.drawImage(logoImage, 0, 0, displaySize, displaySize);
          ctx.restore();
        };
        logoImage.src = src;
      }
    }

    // 2. Real-time SAST Clock
    const clockCanvas = document.getElementById('clock-canvas') as HTMLCanvasElement | null;
    if (clockCanvas) {
      const updateClock = () => {
        const ctx = clockCanvas.getContext('2d');
        if (!ctx) return;

        const now = new Date();
        const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
        const sastTime = new Date(utc + (3600000 * 2));

        const hours = String(sastTime.getHours()).padStart(2, '0');
        const minutes = String(sastTime.getMinutes()).padStart(2, '0');
        const seconds = String(sastTime.getSeconds()).padStart(2, '0');
        const timeStr = `${hours}:${minutes}:${seconds} SAST`;

        const dpr = window.devicePixelRatio || 1;
        if (clockCanvas.width !== 160 * dpr) {
          clockCanvas.width = 160 * dpr;
          clockCanvas.height = 24 * dpr;
        }

        ctx.save();
        ctx.scale(dpr, dpr);
        ctx.clearRect(0, 0, 160, 24);
        ctx.font = '700 15px monospace, sans-serif';
        ctx.fillStyle = '#111111';
        ctx.textBaseline = 'middle';
        ctx.fillText(timeStr, 0, 12);
        ctx.restore();
      };

      updateClock();
      setInterval(updateClock, 1000);
    }

    // 3. Smooth Fullscreen Ken Burns Carousel
    function startKenBurnsCarousel() {
      const fullscreenBg = document.getElementById('fullscreen-bg');
      const heroFrame = document.getElementById('hero-frame');
      const slides = document.querySelectorAll('.slide-img');

      if (!fullscreenBg || !heroFrame || slides.length === 0) return;

      gsap.to(fullscreenBg, {
        opacity: 1,
        duration: 1.5,
        ease: 'power2.inOut'
      });

      gsap.to(heroFrame, {
        opacity: 0,
        duration: 1.2,
        ease: 'power2.inOut'
      });

      let current = 0;
      
      const directions = [
        { xStart: -25, xEnd: 25, scaleStart: 1.05, scaleEnd: 1.18 },
        { xStart: 25, xEnd: -25, scaleStart: 1.18, scaleEnd: 1.05 },
        { xStart: -20, xEnd: 20, scaleStart: 1.08, scaleEnd: 1.20 },
        { xStart: 20, xEnd: -20, scaleStart: 1.15, scaleEnd: 1.05 }
      ];

      gsap.fromTo(slides[0], 
        { x: directions[0].xStart, scale: directions[0].scaleStart },
        { x: directions[0].xEnd, scale: directions[0].scaleEnd, duration: 7.5, ease: 'none', force3D: true }
      );

      setInterval(() => {
        const next = (current + 1) % slides.length;
        const dir = directions[next % directions.length];

        gsap.set(slides[next], { 
          opacity: 0, 
          x: dir.xStart, 
          scale: dir.scaleStart, 
          zIndex: 2 
        });
        gsap.set(slides[current], { zIndex: 1 });

        gsap.to(slides[next], {
          opacity: 1,
          duration: 2.0,
          ease: 'power2.inOut',
          force3D: true
        });

        gsap.to(slides[next], {
          x: dir.xEnd,
          scale: dir.scaleEnd,
          duration: 7.5,
          ease: 'none',
          force3D: true
        });

        gsap.to(slides[current], {
          opacity: 0,
          duration: 2.0,
          ease: 'power2.inOut',
          force3D: true
        });

        current = next;
      }, 5800);
    }

    // 4. Primary GSAP Intro Sequence
    const logoCenter = document.getElementById('logo-center');
    const heroTextContainer = document.getElementById('hero-text-container');
    const clock = document.getElementById('hero-clock');
    const heroFrame = document.getElementById('hero-frame');

    if (!logoCenter || !heroTextContainer || !clock || !heroFrame) return;

    const isMobile = window.innerWidth <= 768;

    if (isMobile) {
      gsap.set(heroTextContainer, {
        top: '50%',
        left: '50%',
        xPercent: -50,
        yPercent: -50,
        opacity: 0
      });

      gsap.set(logoCenter, { 
        top: '50%', 
        left: '50%', 
        xPercent: -50, 
        yPercent: -50, 
        scale: 0.75,
        opacity: 1 
      });

      gsap.set(heroFrame, { opacity: 0, scale: 0.1, transformOrigin: 'center center' });
      gsap.set(clock, { opacity: 0, y: 15 });

      logoCenter.style.visibility = 'visible';
      heroFrame.style.visibility = 'visible';
      heroTextContainer.style.visibility = 'visible';
      clock.style.visibility = 'visible';

      const tl = gsap.timeline({ 
        defaults: { ease: 'power3.inOut' },
        onComplete: startKenBurnsCarousel
      });

      tl
        .to(heroTextContainer, {
          opacity: 1,
          duration: 0.8,
          delay: 0.8
        })
        .to(heroTextContainer, {
          top: '105px',
          left: '15px',
          xPercent: 0,
          yPercent: 0,
          duration: 1.2,
          ease: 'power3.inOut'
        })
        .to(logoCenter, {
          top: '130px',
          left: '125vw',
          xPercent: 0,
          yPercent: -50,
          scale: 0.32,
          opacity: 0,
          duration: 1.2
        }, '<')
        .to(clock, {
          opacity: 1,
          y: 0,
          duration: 0.5
        }, '-=0.4')
        .to(heroFrame, {
          opacity: 1,
          scale: 1,
          duration: 1.2,
          ease: 'power4.out'
        }, '-=0.6');

    } else {
      gsap.set(heroTextContainer, {
        top: '50%',
        left: '50%',
        xPercent: -50,
        yPercent: -50,
        opacity: 0
      });

      gsap.set(logoCenter, {
        top: '50%',
        left: '50%',
        xPercent: -50,
        yPercent: -50,
        scale: 1,
        opacity: 1
      });

      gsap.set(heroFrame, { opacity: 0, scale: 0.1, transformOrigin: 'center center' });
      gsap.set(clock, { opacity: 0, y: 15 });

      logoCenter.style.visibility = 'visible';
      heroFrame.style.visibility = 'visible';
      heroTextContainer.style.visibility = 'visible';
      clock.style.visibility = 'visible';

      const tl = gsap.timeline({ 
        defaults: { ease: 'power3.inOut' },
        onComplete: startKenBurnsCarousel 
      });

      tl
        .to(heroTextContainer, {
          opacity: 1,
          duration: 0.8,
          delay: 0.8
        })
        .to(heroTextContainer, {
          top: '130px',
          left: '30px',
          xPercent: 0,
          yPercent: 0,
          duration: 1.2,
          ease: 'power3.inOut'
        })
        .to(logoCenter, {
          top: '130px',
          left: '120vw',
          xPercent: 0,
          x: 0,
          yPercent: 0,
          y: 0,
          scale: 0.55,
          opacity: 0,
          transformOrigin: 'top left',
          duration: 1.2,
          ease: 'power2.inOut'
        }, '<')
        .to(clock, {
          opacity: 1,
          y: 0,
          duration: 0.5
        }, '-=0.4')
        .to(heroFrame, {
          opacity: 1,
          scale: 1,
          duration: 1.2,
          ease: 'power4.out'
        }, '-=0.6');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>

<style>
  .lcp-seo-anchor {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 12px;
    color: transparent;
    background: transparent;
    user-select: none;
    pointer-events: none;
    margin: 0;
    padding: 0;
    z-index: 1;
    width: 200px;
    height: 20px;
    overflow: hidden;
  }

  .stage-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 10;
  }

  .fullscreen-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 5;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-text-container {
    position: absolute;
    z-index: 999999;
    display: flex;
    flex-direction: row;
    gap: 12px;
    white-space: nowrap;
    will-change: transform, top, left, opacity;
    visibility: hidden;
    pointer-events: none;
  }

  .text-facet,
  .text-architecture {
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(1.2rem, 3.8vw, 4.1rem);
    letter-spacing: 0.10em;
    color: #111111;
    margin: 0;
    line-height: 1;
    text-transform: uppercase;
  }

  .hero-clock {
    position: absolute;
    bottom: 25px;
    left: 50px;
    z-index: 40;
    font-family: monospace, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-primary, #111111);
    display: flex;
    align-items: center;
    will-change: transform, opacity;
    visibility: hidden;
  }

  #clock-canvas {
    width: 160px;
    height: 24px;
    display: block;
  }

  .logo-center-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 430px;
    height: 430px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    pointer-events: none;
    will-change: transform, top, left, opacity;
    visibility: hidden;
  }

  .hero-frame {
    position: absolute;
    top: 22%;
    left: 12%;
    width: 76vw;
    height: 65vh;
    z-index: 20;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    transform-origin: center center;
    will-change: transform, opacity;
    backface-visibility: hidden;
    opacity: 0;
  }

  .logo-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .intro-frame-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide-img {
    position: absolute;
    top: -5%;
    left: -5%;
    width: 110vw;
    height: 110vh;
    object-fit: cover;
    display: block;
    opacity: 0;
    will-change: transform, opacity;
    backface-visibility: hidden;
    transform-style: preserve-3d;
  }

  .slide-img.active {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .logo-center-wrapper {
      width: 280px;
      height: 280px;
    }

    .hero-frame {
      top: 190px;
      left: 0;
      width: 100vw;
      height: 45vh;
      box-shadow: none;
      border-radius: 0;
    }

    .hero-text-container {
      gap: 6px;
    }

    .text-facet,
    .text-architecture {
      font-size: clamp(1.05rem, 4.1vw, 1.5rem) !important;
      font-weight: 900;
      color: #111111;
      line-height: 1;
    }

    .hero-clock {
      bottom: 20px;
      left: 15px;
      font-size: 0.85rem;
    }
  }
</style>