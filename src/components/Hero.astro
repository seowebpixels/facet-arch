---
import { getImage } from 'astro:assets';

import resHeroImg from '../assets/res-eoa-1597-v2.avif';
import resDavidImg from '../assets/res-david.avif';
import resBlannImg from '../assets/res-blann.avif';
import ascotManorImg from '../assets/dev-ascot-manor.avif';
import intStarckImg from '../assets/int-starck.avif';

const heroMobile = await getImage({ src: resHeroImg, format: 'avif', width: 480, quality: 55 });
const heroDesktop = await getImage({ src: resHeroImg, format: 'avif', width: 1440, quality: 85 });

const slide1Mobile = await getImage({ src: resDavidImg, format: 'avif', width: 480, quality: 60 });
const slide1Desktop = await getImage({ src: resDavidImg, format: 'avif', width: 1440, quality: 85 });

const slide2Mobile = await getImage({ src: resBlannImg, format: 'avif', width: 480, quality: 60 });
const slide2Desktop = await getImage({ src: resBlannImg, format: 'avif', width: 1440, quality: 85 });

const slide3Mobile = await getImage({ src: ascotManorImg, format: 'avif', width: 480, quality: 60 });
const slide3Desktop = await getImage({ src: ascotManorImg, format: 'avif', width: 1440, quality: 85 });

const slide4Mobile = await getImage({ src: intStarckImg, format: 'avif', width: 480, quality: 60 });
const slide4Desktop = await getImage({ src: intStarckImg, format: 'avif', width: 1440, quality: 85 });
---

<section id="hero-stage" class="stage-container">
  <!-- Title Element -->
  <div id="hero-text-container" class="hero-text-container animate-title">
    <h1 class="title-text">FACET ARCHITECTURE</h1>
  </div>

  <!-- Center Intro Logo (Inline Vector SVG) -->
  <div id="logo-center" class="logo-wrapper animate-logo">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" class="site-logo" aria-label="Facet Architecture Logo">
      <g fill="none" stroke="#FFFFFF" stroke-width="1.5" opacity="0.85">
        <circle cx="310" cy="500" r="220" stroke-dasharray="6,6" />
        <circle cx="680" cy="500" r="150" stroke-dasharray="6,6" />
        <line x1="310" y1="200" x2="310" y2="800" stroke-dasharray="8,8" />
        <line x1="100" y1="500" x2="900" y2="500" stroke-dasharray="8,8" />
        <path d="M 310 230 L 310 210 M 300 220 L 310 210 L 320 220" />
        <path d="M 870 500 L 890 500 M 880 490 L 890 500 L 880 510" />
      </g>
      <g fill="#CCCCCC">
        <path d="M 310 280 A 220 220 0 1 0 310 720 A 170 170 0 1 1 310 280 Z" />
        <circle cx="310" cy="500" r="45" fill="#FFFFFF" />
        <circle cx="440" cy="500" r="90" />
        <circle cx="720" cy="500" r="90" />
      </g>
      <text x="500" y="760" font-family="'Nesobrite', 'Bank Gothic', sans-serif" font-weight="900" font-size="38" fill="#FFFFFF" letter-spacing="0.25em" text-anchor="middle">FACET ARCHITECTURE</text>
    </svg>
  </div>

  <main>
    <div 
      id="fullscreen-bg" 
      class="fullscreen-bg"
      data-slides-mobile={JSON.stringify([slide1Mobile.src, slide2Mobile.src, slide3Mobile.src, slide4Mobile.src])}
      data-slides-desktop={JSON.stringify([slide1Desktop.src, slide2Desktop.src, slide3Desktop.src, slide4Desktop.src])}
    ></div>

    <!-- Hero Showcase Frame -->
    <div id="hero-frame" class="hero-frame animate-frame">
      <picture>
        <source media="(max-width: 768px)" srcset={heroMobile.src} type="image/avif" />
        <source media="(min-width: 769px)" srcset={heroDesktop.src} type="image/avif" />
        <img 
          src={heroDesktop.src} 
          alt="Facet Architecture Showcase" 
          class="intro-frame-img"
          loading="eager"
          decoding="async"
          width={heroDesktop.attributes.width}
          height={heroDesktop.attributes.height}
        />
      </picture>
    </div>
  </main>

  <div class="hero-clock">
    <span id="sast-clock-display">00:00:00 SAST</span>
  </div>
</section>

<script is:inline>
  if ('scrollRestoration' in history) {
    history.scrollRestoration = 'manual';
  }
  window.scrollTo(0, 0);

  // Totally non-blocking initialization loop
  window.addEventListener('load', () => {
    window.scrollTo(0, 0);

    const runDeferredTasks = () => {
      // Clock
      const clockEl = document.getElementById('sast-clock-display');
      if (clockEl) {
        const updateClock = () => {
          const now = new Date();
          const sastTime = new Date(now.getTime() + (now.getTimezoneOffset() * 60000) + 7200000);
          clockEl.textContent = `${String(sastTime.getHours()).padStart(2, '0')}:${String(sastTime.getMinutes()).padStart(2, '0')}:${String(sastTime.getSeconds()).padStart(2, '0')} SAST`;
        };
        updateClock();
        setInterval(updateClock, 1000);
      }

      // Slide Loader
      const bg = document.getElementById('fullscreen-bg');
      const heroFrame = document.getElementById('hero-frame');

      setTimeout(() => {
        if (heroFrame) {
          heroFrame.style.opacity = '0';
          setTimeout(() => { heroFrame.style.display = 'none'; }, 1000);
        }

        if (!bg) return;
        const isMobile = window.matchMedia('(max-width: 768px)').matches;
        const slidesAttr = isMobile 
          ? bg.getAttribute('data-slides-mobile') 
          : bg.getAttribute('data-slides-desktop');

        if (!slidesAttr) return;

        const urls = JSON.parse(slidesAttr);
        const fragment = document.createDocumentFragment();
        
        urls.forEach((url, idx) => {
          const img = document.createElement('img');
          img.src = url;
          img.alt = `Slide ${idx + 1}`;
          img.className = 'slide-img';
          fragment.appendChild(img);
        });

        bg.appendChild(fragment);
        const slides = bg.querySelectorAll('.slide-img');
        if (slides.length === 0) return;

        slides[0].style.opacity = '1';

        let current = 0;
        setInterval(() => {
          const next = (current + 1) % slides.length;
          slides[next].style.opacity = '1';
          slides[current].style.opacity = '0';
          current = next;
        }, 5500);

      }, 4500);
    };

    if ('requestIdleCallback' in window) {
      requestIdleCallback(runDeferredTasks, { timeout: 2000 });
    } else {
      setTimeout(runDeferredTasks, 200);
    }
  });
</script>

<style>
  .stage-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 10;
  }

  .fullscreen-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 5;
    overflow: hidden;
    pointer-events: none;
  }

  :global(.slide-img) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.8s ease-in-out;
    will-change: opacity;
  }

  .logo-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate3d(-50%, -60%, 0);
    width: min(350px, 60vw);
    height: min(350px, 60vw);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    pointer-events: none;
    opacity: 1;
    will-change: transform, opacity;
  }

  .animate-logo {
    animation: shootLogo 1.2s cubic-bezier(0.77, 0, 0.175, 1) 2.2s forwards;
  }

  @keyframes shootLogo {
    0% {
      transform: translate3d(-50%, -60%, 0);
      opacity: 1;
    }
    100% {
      transform: translate3d(-50%, -200vh, 0);
      opacity: 0;
    }
  }

  .site-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .hero-text-container {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 30;
    opacity: 0;
    pointer-events: none;
    transform: translate3d(calc(50vw - 50%), calc(50vh + 100px), 0);
    will-change: transform, opacity;
  }

  .animate-title {
    animation: revealAndMoveTitle 2.0s cubic-bezier(0.77, 0, 0.175, 1) 1.2s forwards;
  }

  @keyframes revealAndMoveTitle {
    0% {
      opacity: 0;
      transform: translate3d(calc(50vw - 50%), calc(50vh + 100px), 0);
    }
    30% {
      opacity: 1;
      transform: translate3d(calc(50vw - 50%), calc(50vh + 100px), 0);
    }
    100% {
      opacity: 1;
      transform: translate3d(12vw, 135px, 0);
    }
  }

  .title-text {
    font-family: 'Nesobrite', 'Bank Gothic', sans-serif !important;
    font-weight: 900 !important;
    font-size: clamp(1.2rem, 2.5vw, 2.8rem) !important;
    letter-spacing: 0.10em !important;
    color: #111111 !important;
    margin: 0 !important;
    line-height: 1 !important;
    text-transform: uppercase !important;
    white-space: nowrap;
  }

  .hero-frame {
    position: absolute;
    top: 22%;
    left: 12vw;
    width: 76vw;
    height: 65vh;
    z-index: 20;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    opacity: 0;
    will-change: opacity;
    transition: opacity 1s ease-in-out;
  }

  .animate-frame {
    animation: revealFrame 1s ease-in-out 2.4s forwards;
  }

  @keyframes revealFrame {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  .intro-frame-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-clock {
    position: absolute;
    bottom: 25px;
    left: 50px;
    z-index: 40;
    font-family: monospace, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-primary, #111111);
  }

  @media (max-width: 768px) {
    @keyframes revealAndMoveTitle {
      0% {
        opacity: 0;
        transform: translate3d(calc(50vw - 50%), calc(50vh + 100px), 0);
      }
      30% {
        opacity: 1;
        transform: translate3d(calc(50vw - 50%), calc(50vh + 100px), 0);
      }
      100% {
        opacity: 1;
        transform: translate3d(20px, 100px, 0);
      }
    }

    .hero-frame {
      top: 150px;
      left: 0;
      width: 100vw;
      height: 50vh;
      box-shadow: none;
    }

    .hero-clock {
      bottom: 20px;
      left: 15px;
    }
  }
</style>