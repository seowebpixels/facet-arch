---
import { getImage } from 'astro:assets';
import heroLogoImg from '../assets/facet-logo-white.avif';

import resHeroImg from '../assets/res-eoa-1597-v2.avif';
import resDavidImg from '../assets/res-david.avif';
import resBlannImg from '../assets/kb-res-blann.avif';
import ascotManorImg from '../assets/dev-ascot-manor.avif';
import intStarckImg from '../assets/int-starck.avif';

// Pre-render image optimizations for Mobile & Desktop
const heroMobile = await getImage({ src: resHeroImg, format: 'avif', width: 768, quality: 85 });
const heroDesktop = await getImage({ src: resHeroImg, format: 'avif', width: 1440, quality: 90 });

const slide1Mobile = await getImage({ src: resDavidImg, format: 'avif', width: 768, quality: 85 });
const slide1Desktop = await getImage({ src: resDavidImg, format: 'avif', width: 1440, quality: 90 });

const slide2Mobile = await getImage({ src: resBlannImg, format: 'avif', width: 768, quality: 85 });
const slide2Desktop = await getImage({ src: resBlannImg, format: 'avif', width: 1440, quality: 90 });

const slide3Mobile = await getImage({ src: ascotManorImg, format: 'avif', width: 768, quality: 85 });
const slide3Desktop = await getImage({ src: ascotManorImg, format: 'avif', width: 1440, quality: 90 });

const slide4Mobile = await getImage({ src: intStarckImg, format: 'avif', width: 768, quality: 85 });
const slide4Desktop = await getImage({ src: intStarckImg, format: 'avif', width: 1440, quality: 90 });

const logoImg = await getImage({ src: heroLogoImg, format: 'avif', width: 350, height: 350, quality: 90 });

// Slide sources for dynamic loading
const mobileSlideSrcs = [slide1Mobile.src, slide2Mobile.src, slide3Mobile.src, slide4Mobile.src];
const desktopSlideSrcs = [slide1Desktop.src, slide2Desktop.src, slide3Desktop.src, slide4Desktop.src];
---

<!-- CRITICAL LCP PRELOAD FOR LOGO -->
<link rel="preload" as="image" href={logoImg.src} type="image/avif" fetchpriority="high" />

<section id="hero-stage" class="stage-container">
  <!-- Central Intro Group: Holds Logo and Text together in exact lockstep -->
  <div id="hero-intro-group" class="hero-intro-group">
    <div id="logo-center" class="logo-wrapper">
      <img 
        src={logoImg.src} 
        alt="Facet Architecture Logo" 
        class="site-logo"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="350"
        height="350"
      />
    </div>

    <div id="hero-text-container" class="hero-text-container">
      <h1 class="title-text">FACET ARCHITECTURE</h1>
    </div>
  </div>

  <main class="hero-main">
    <!-- Ken Burns / Background Slide Showcase -->
    <div 
      id="fullscreen-bg" 
      class="fullscreen-bg"
      data-slides-mobile={JSON.stringify(mobileSlideSrcs)}
      data-slides-desktop={JSON.stringify(desktopSlideSrcs)}
    ></div>

    <!-- Initial Hero Frame Image -->
    <div id="hero-frame" class="hero-frame">
      <picture>
        <source media="(max-width: 768px)" srcset={heroMobile.src} type="image/avif" />
        <source media="(min-width: 769px)" srcset={heroDesktop.src} type="image/avif" />
        <img 
          src={heroDesktop.src} 
          alt="Facet Architecture Showcase" 
          class="intro-frame-img"
          loading="eager"
          decoding="async"
        />
      </picture>
    </div>
  </main>

  <div class="hero-clock">
    <span id="sast-clock-display">00:00:00 SAST</span>
  </div>
</section>

<script is:inline>
  // Real-time SAST Clock
  const clockEl = document.getElementById('sast-clock-display');
  if (clockEl) {
    const updateClock = () => {
      const now = new Date();
      const sastTime = new Date(now.getTime() + (now.getTimezoneOffset() * 60000) + 7200000);
      clockEl.textContent = `${String(sastTime.getHours()).padStart(2, '0')}:${String(sastTime.getMinutes()).padStart(2, '0')}:${String(sastTime.getSeconds()).padStart(2, '0')} SAST`;
    };
    updateClock();
    setInterval(updateClock, 1000);
  }

  window.addEventListener('DOMContentLoaded', () => {
    const logoCenter = document.getElementById('logo-center');
    const heroText = document.getElementById('hero-text-container');
    const heroFrame = document.getElementById('hero-frame');
    const bg = document.getElementById('fullscreen-bg');

    // STEP 1: Logo loads first (visible by default). Hold 2.5s.
    setTimeout(() => {
      // Reveal FACET ARCHITECTURE text directly below logo
      if (heroText) heroText.classList.add('show-text');

      // STEP 2: Both hold for 1.0s (at 3.5s total time)
      setTimeout(() => {
        // Logo moves gracefully off top screen
        if (logoCenter) logoCenter.classList.add('hide-logo');

        // FA Title moves to persistent slot near header/top screen
        if (heroText) heroText.classList.add('move-to-top');

        // Hero frame image loads
        if (heroFrame) heroFrame.classList.add('show-hero-frame');

        // STEP 3: Transition to background Ken Burns showcase
        setTimeout(() => {
          if (heroFrame) {
            heroFrame.classList.remove('show-hero-frame');
            setTimeout(() => { heroFrame.style.display = 'none'; }, 1000);
          }

          if (!bg) return;
          const isMobile = window.matchMedia('(max-width: 768px)').matches;
          const slidesAttr = isMobile 
            ? bg.getAttribute('data-slides-mobile') 
            : bg.getAttribute('data-slides-desktop');

          if (!slidesAttr) return;

          let urls = [];
          try {
            urls = JSON.parse(slidesAttr);
          } catch (e) {
            console.error('Failed to parse slide URLs:', e);
            return;
          }

          const fragment = document.createDocumentFragment();
          
          urls.forEach((url, idx) => {
            const img = document.createElement('img');
            img.src = url;
            img.alt = `Slide ${idx + 1}`;
            img.className = 'slide-img';
            fragment.appendChild(img);
          });

          bg.appendChild(fragment);
          const slides = bg.querySelectorAll('.slide-img');
          if (slides.length === 0) return;

          // Display initial slide crisp & static
          slides[0].style.opacity = '1';

          let current = 0;
          setInterval(() => {
            const next = (current + 1) % slides.length;
            slides[next].style.opacity = '1';
            slides[current].style.opacity = '0';
            current = next;
          }, 5500);

        }, 3000);

      }, 1000); // 1.0s hold for both logo + text

    }, 2500); // 2.5s hold for logo
  });
</script>

<style>
  .stage-container {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 10;
  }

  .hero-main {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 15;
  }

  .fullscreen-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 5;
    overflow: hidden;
    pointer-events: none;
  }

  /* Ken Burns static image containment - Eliminates software zoom/blurring */
  :global(.slide-img) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transform: none !important; /* Disabled aggressive zooming to keep crisp resolution */
    transition: opacity 1.8s ease-in-out;
    will-change: opacity;
  }

  /* INTRO GROUP (Center Alignment) */
  .hero-intro-group {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate3d(-50%, -50%, 0);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 100; /* Highest priority to remain visible over hero image */
    pointer-events: none;
    width: 100%;
  }

  /* Center Intro Logo */
  .logo-wrapper {
    width: min(320px, 55vw);
    height: min(320px, 55vw);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition: transform 1.2s cubic-bezier(0.77, 0, 0.175, 1), opacity 0.8s ease-in-out;
  }

  .logo-wrapper.hide-logo {
    transform: translate3d(0, -180vh, 0);
    opacity: 0;
  }

  .site-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* FACET ARCHITECTURE Text Styling */
  .hero-text-container {
    margin-top: 15px;
    opacity: 0;
    transform: translate3d(0, 0, 0);
    transition: opacity 0.8s ease-in-out, transform 1.2s cubic-bezier(0.77, 0, 0.175, 1);
  }

  .hero-text-container.show-text {
    opacity: 1;
  }

  /* Move FA text directly under header navigation */
  .hero-text-container.move-to-top {
    position: fixed;
    top: 100px;
    left: 50%;
    transform: translate3d(-50%, 0, 0);
    margin-top: 0;
    z-index: 120;
  }

  .title-text {
    font-family: 'Nesobrite', 'Bank Gothic', sans-serif !important;
    font-weight: 900 !important;
    font-size: clamp(1.1rem, 2.2vw, 2.4rem) !important;
    letter-spacing: 0.12em !important;
    color: #111111 !important;
    margin: 0 !important;
    line-height: 1 !important;
    text-transform: uppercase !important;
    white-space: nowrap;
    text-align: center;
  }

  /* HERO SHOWCASE FRAME */
  .hero-frame {
    position: absolute;
    top: 54%;
    left: 50%;
    transform: translate3d(-50%, -50%, 0);
    width: 70vw;
    max-width: 1100px;
    height: 52vh;
    z-index: 20;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }

  .hero-frame.show-hero-frame {
    opacity: 1;
  }

  .intro-frame-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .hero-clock {
    position: absolute;
    bottom: 25px;
    left: 50px;
    z-index: 100;
    font-family: monospace, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-primary, #111111);
  }

  /* MOBILE RESPONSIVE ADJUSTMENTS */
  @media (max-width: 768px) {
    .hero-text-container.move-to-top {
      top: 115px; /* Clear header menu bar and match hero.png reference */
      left: 50%;
      transform: translate3d(-50%, 0, 0);
    }

    .hero-frame {
      width: 86vw;
      height: 42vh; /* Adjusted aspect ratio to eliminate vertical over-expansion */
      top: 56%;
    }

    .hero-clock {
      bottom: 20px;
      left: 20px;
    }
  }
</style>