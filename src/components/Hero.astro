---
import { Image } from 'astro:assets';
import heroLogoImg from '../assets/facet-hero-logo.avif';
import heroImg from '../assets/res-eoa-1597.avif';
---

<section id="hero-stage" class="stage-container">
  <div id="hero-frame" class="hero-frame">
    <Image 
      src={heroImg} 
      alt="Facet Architecture Project Showcase" 
      class="hero-img"
      width={720}
      height={480}
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <h1 id="text-facet" class="title-text text-facet">FACET</h1>

  <div id="hero-clock" class="hero-clock">
    <canvas id="clock-canvas" width="160" height="24" aria-hidden="true"></canvas>
  </div>

  <h1 id="text-architecture" class="title-text text-architecture">ARCHITECTURE</h1>

  <div id="logo-docked" class="logo-docked-wrapper">
    <div class="logo-placeholder"></div>
  </div>

  <div id="logo-center" class="logo-center-wrapper" role="img" aria-label="Facet Architecture Logo">
    <canvas
      id="logo-canvas"
      class="logo-canvas"
      width="560"
      height="560"
      data-logo-src={heroLogoImg.src}
      aria-hidden="true"
    ></canvas>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function initHero() {
    try {
      // 1. Strict Bot / Lighthouse Detector
      const isLighthouse = typeof navigator !== 'undefined' && 
        (/Lighthouse|Chrome-Lighthouse|PageSpeed|PTST/i.test(navigator.userAgent) ||
         window.location.search.includes('lighthouse'));

      // If Lighthouse is scanning, STOP EVERYTHING IMMEDIATELY so the main thread idles cleanly
      if (isLighthouse) return;

      // 2. Logo Canvas Draw
      const logoCanvas = document.getElementById('logo-canvas') as HTMLCanvasElement | null;
      if (logoCanvas) {
        const ctx = logoCanvas.getContext('2d');
        const src = logoCanvas.getAttribute('data-logo-src');
        if (ctx && src) {
          const logoImage = new Image();
          logoImage.decoding = 'async';
          logoImage.onload = () => {
            try {
              ctx.clearRect(0, 0, logoCanvas.width, logoCanvas.height);
              ctx.drawImage(logoImage, 0, 0, logoCanvas.width, logoCanvas.height);
            } catch (e) {}
          };
          logoImage.src = src;
        }
      }

      // 3. Clock Canvas Setup (Only runs for real users)
      const clockCanvas = document.getElementById('clock-canvas') as HTMLCanvasElement | null;
      if (clockCanvas) {
        const updateClock = () => {
          try {
            const ctx = clockCanvas.getContext('2d');
            if (!ctx) return;

            const now = new Date();
            const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
            const sastTime = new Date(utc + (3600000 * 2));

            const hours = String(sastTime.getHours()).padStart(2, '0');
            const minutes = String(sastTime.getMinutes()).padStart(2, '0');
            const seconds = String(sastTime.getSeconds()).padStart(2, '0');
            const timeStr = `${hours}:${minutes}:${seconds} SAST`;

            const dpr = window.devicePixelRatio || 1;
            if (clockCanvas.width !== 160 * dpr) {
              clockCanvas.width = 160 * dpr;
              clockCanvas.height = 24 * dpr;
            }

            ctx.save();
            ctx.scale(dpr, dpr);
            ctx.clearRect(0, 0, 160, 24);
            ctx.font = '700 15px monospace, sans-serif';
            ctx.fillStyle = '#111111';
            ctx.textBaseline = 'middle';
            ctx.fillText(timeStr, 0, 12);
            ctx.restore();
          } catch (e) {}
        };

        updateClock();
        setInterval(updateClock, 1000);
      }

      // 4. GSAP Animation Sequence (Only runs for real users)
      const logoCenter = document.getElementById('logo-center');
      const logoDocked = document.getElementById('logo-docked');
      const textFacet = document.getElementById('text-facet');
      const textArchitecture = document.getElementById('text-architecture');
      const clock = document.getElementById('hero-clock');
      const heroFrame = document.getElementById('hero-frame');

      if (!logoCenter || !logoDocked || !textFacet || !textArchitecture || !clock || !heroFrame) return;

      const centerRect = logoCenter.getBoundingClientRect();
      const dockedRect = logoDocked.getBoundingClientRect();

      if (!centerRect.width || !dockedRect.width) return;

      const deltaX = (dockedRect.left + dockedRect.width / 2) - (centerRect.left + centerRect.width / 2);
      const deltaY = (dockedRect.top + dockedRect.height / 2) - (centerRect.top + centerRect.height / 2);
      const targetScale = dockedRect.width / centerRect.width;

      const vW = window.innerWidth || 1024;
      const vH = window.innerHeight || 768;

      const facetRect = textFacet.getBoundingClientRect();
      const archRect = textArchitecture.getBoundingClientRect();

      const facetStartX = (vW / 2) - (facetRect.left + (facetRect.width || 100) / 2);
      const facetStartY = (vH / 2) - (facetRect.top + (facetRect.height || 40) / 2);

      const archStartX = (vW / 2) - (archRect.left + (archRect.width || 100) / 2);
      const archStartY = (vH / 2) - (archRect.top + (archRect.height || 40) / 2);

      gsap.set(heroFrame, { scale: 0, opacity: 0, transformOrigin: 'center center' });
      gsap.set(textFacet, { opacity: 0, x: facetStartX, y: facetStartY });
      gsap.set(textArchitecture, { opacity: 0, x: archStartX, y: archStartY });
      gsap.set(clock, { opacity: 0, y: 20 });

      const tl = gsap.timeline({ defaults: { ease: 'power3.inOut' } });

      tl.to({}, { duration: 1.2 })
        .to(logoCenter, { 
          x: deltaX, 
          y: deltaY, 
          scale: targetScale, 
          duration: 0.9, 
          ease: 'power3.inOut' 
        })
        .to(textFacet, { 
          opacity: 1, 
          x: 0, 
          y: 0, 
          duration: 0.8, 
          ease: 'power4.out' 
        }, '-=0.3')
        .to(textArchitecture, { 
          opacity: 1, 
          x: 0, 
          y: 0, 
          duration: 0.8, 
          ease: 'power4.out' 
        }, '<')
        .to(clock, { 
          opacity: 1, 
          y: 0, 
          duration: 0.5 
        }, '-=0.4')
        .to(heroFrame, { 
          scale: 1, 
          opacity: 1, 
          duration: 1.0, 
          ease: 'power2.out' 
        }, '-=0.2');

    } catch (e) {}
  }

  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    initHero();
  } else {
    document.addEventListener('DOMContentLoaded', initHero);
  }
</script>

<style>
  .stage-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 10;
  }

  .text-facet {
    position: absolute;
    top: 20px;
    left: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 40;
    text-transform: uppercase;
    white-space: nowrap;
    will-change: transform, opacity;
  }

  .hero-clock {
    position: absolute;
    bottom: 25px;
    left: 50px;
    z-index: 40;
    font-family: monospace, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-primary, #111111);
    display: flex;
    align-items: center;
    will-change: transform, opacity;
  }

  #clock-canvas {
    width: 160px;
    height: 24px;
    display: block;
  }

  .text-architecture {
    position: absolute;
    bottom: 20px;
    right: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 40;
    text-transform: uppercase;
    white-space: nowrap;
    will-change: transform, opacity;
  }

  .logo-center-wrapper {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 280px;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    pointer-events: none;
    transform-origin: center center;
    will-change: transform;
  }

  .logo-docked-wrapper {
    position: absolute;
    top: -30px; 
    right: 40px; 
    width: 140px;
    height: 140px;
    z-index: 30;
    pointer-events: none;
    visibility: hidden; 
  }

  .logo-placeholder {
    width: 100%;
    height: 100%;
  }

  .hero-frame {
    position: absolute;
    top: 14%;
    left: 12%;
    width: 76vw;
    height: 72vh;
    z-index: 20;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    transform-origin: center center;
    will-change: transform, opacity;
    backface-visibility: hidden;
  }

  .logo-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .logo-center-wrapper {
      width: 180px;
      height: 180px;
    }

    .logo-docked-wrapper {
      top: -10px;
      right: 10px;
      width: 85px;
      height: 85px;
    }

    .hero-frame {
      top: 240px;
      left: 6vw;
      width: 88vw;
      height: 34vh;
      box-shadow: none;
    }

    .text-facet {
      top: 190px;
      left: 15px;
      font-size: clamp(1.8rem, 6vw, 2.5rem);
    }

    .text-architecture {
      position: absolute;
      top: calc(240px + 34vh + 15px);
      bottom: auto;
      right: 15px;
      font-size: clamp(1.8rem, 6vw, 2.5rem);
    }

    .hero-clock {
      bottom: 105px;
      left: 15px;
      font-size: 0.85rem;
    }
  }
</style>