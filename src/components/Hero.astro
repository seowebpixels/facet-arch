---
import { getImage } from 'astro:assets';
import heroLogoImg from '../assets/facet-logo-white.avif';

// Import showcase images
import resHeroImg from '../assets/res-eoa-1597-v2.avif'; // Initial Frame Image
import resDavidImg from '../assets/res-david.avif';  // Slide 1
import resBlannImg from '../assets/res-blann.avif';  // Slide 2
import ascotManorImg from '../assets/dev-ascot-manor.avif'; // Slide 3
import intStarckImg from '../assets/int-starck.avif';// Slide 4

// --- HIGH QUALITY INITIAL HERO ASSETS ---
const heroMobile = await getImage({ src: resHeroImg, format: 'avif', width: 800, quality: 90 });
const heroDesktop = await getImage({ src: resHeroImg, format: 'avif', width: 1440, quality: 90 });

// --- DEFERRED SLIDES ---
const slide1 = await getImage({ src: resDavidImg, format: 'avif', width: 1440, quality: 90 });
const slide2 = await getImage({ src: resBlannImg, format: 'avif', width: 1440, quality: 90 });
const slide3 = await getImage({ src: ascotManorImg, format: 'avif', width: 1440, quality: 90 });
const slide4 = await getImage({ src: intStarckImg, format: 'avif', width: 1440, quality: 90 });

// Logo setting
const logoImg = await getImage({ src: heroLogoImg, format: 'avif', width: 350, height: 350, quality: 95 });
---

<!-- Direct LCP Preloads for initial frame and slide1 candidate -->
<link 
  rel="preload" 
  as="image" 
  href={heroMobile.src} 
  media="(max-width: 768px)"
  type="image/avif" 
  fetchpriority="high" 
/>
<link 
  rel="preload" 
  as="image" 
  href={heroDesktop.src} 
  media="(min-width: 769px)"
  type="image/avif" 
  fetchpriority="high" 
/>
<link 
  rel="preload" 
  as="image" 
  href={slide1.src} 
  type="image/avif" 
  fetchpriority="high" 
/>

<section id="hero-stage" class="stage-container">
  <h2 class="lcp-seo-anchor">FACET ARCHITECTURE PORTFOLIO SHOWCASE GAUTENG</h2>

  <div id="hero-text-container" class="hero-text-container">
    <h1 id="text-facet" class="title-text text-facet">FACET</h1>
    <h1 id="text-architecture" class="title-text text-architecture">ARCHITECTURE</h1>
  </div>

  <!-- Fullscreen Carousel Background: Slide 1 rendered in HTML so browser preload scanner discovers LCP image -->
  <div 
    id="fullscreen-bg" 
    class="fullscreen-bg"
    data-slides={JSON.stringify([slide2.src, slide3.src, slide4.src])}
  >
    <img 
      src={slide1.src} 
      alt="Facet Architecture Showcase Slide 1" 
      class="hero-img slide-img active" 
      decoding="async"
      fetchpriority="high"
      loading="eager"
    />
  </div>

  <div id="hero-frame" class="hero-frame">
    <picture>
      <source media="(max-width: 768px)" srcset={heroMobile.src} type="image/avif" />
      <source media="(min-width: 769px)" srcset={heroDesktop.src} type="image/avif" />
      <img 
        src={heroMobile.src} 
        alt="Facet Architecture Initial Hero" 
        class="hero-img intro-frame-img"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="750"
        height="500"
      />
    </picture>
  </div>

  <div id="hero-clock" class="hero-clock">
    <canvas id="clock-canvas" width="160" height="24" aria-hidden="true"></canvas>
  </div>

  <div id="logo-center" class="logo-center-wrapper" role="img" aria-label="Facet Architecture Logo">
    <img 
      src={logoImg.src} 
      alt="Facet Architecture Logo" 
      class="site-logo"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      width="350"
      height="350"
    />
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function initHero() {
    gsap.config({ force3D: true });

    // SAST Clock
    const clockCanvas = document.getElementById('clock-canvas') as HTMLCanvasElement | null;
    if (clockCanvas) {
      const updateClock = () => {
        const ctx = clockCanvas.getContext('2d');
        if (!ctx) return;

        const now = new Date();
        const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
        const sastTime = new Date(utc + (3600000 * 2));

        const hours = String(sastTime.getHours()).padStart(2, '0');
        const minutes = String(sastTime.getMinutes()).padStart(2, '0');
        const seconds = String(sastTime.getSeconds()).padStart(2, '0');
        const timeStr = `${hours}:${minutes}:${seconds} SAST`;

        const dpr = window.devicePixelRatio || 1;
        const targetWidth = 160 * dpr;
        const targetHeight = 24 * dpr;

        if (clockCanvas.width !== targetWidth) {
          clockCanvas.width = targetWidth;
          clockCanvas.height = targetHeight;
        }

        ctx.save();
        ctx.scale(dpr, dpr);
        ctx.clearRect(0, 0, 160, 24);
        ctx.font = '700 15px monospace, sans-serif';
        ctx.fillStyle = '#111111';
        ctx.textBaseline = 'middle';
        ctx.fillText(timeStr, 0, 12);
        ctx.restore();
      };

      updateClock();
      setInterval(updateClock, 1000);
    }

    // Dynamic Ken Burns Carousel Sequence
    function startKenBurnsCarousel() {
      const fullscreenBg = document.getElementById('fullscreen-bg');
      const heroFrame = document.getElementById('hero-frame');

      if (!fullscreenBg || !heroFrame) return;

      const slideUrlsRaw = fullscreenBg.getAttribute('data-slides');
      if (!slideUrlsRaw) return;

      const remainingSlideUrls: string[] = JSON.parse(slideUrlsRaw);

      // Append remaining deferred slides dynamically
      const fragment = document.createDocumentFragment();
      remainingSlideUrls.forEach((url, idx) => {
        const img = document.createElement('img');
        img.src = url;
        img.alt = `Facet Architecture Showcase Slide ${idx + 2}`;
        img.className = 'hero-img slide-img';
        img.decoding = 'async';
        fragment.appendChild(img);
      });

      fullscreenBg.appendChild(fragment);

      const slides = fullscreenBg.querySelectorAll<HTMLImageElement>('.slide-img');
      if (slides.length === 0) return;

      slides.forEach((s, i) => {
        gsap.set(s, {
          position: 'absolute',
          top: 0,
          left: 0,
          width: '100vw',
          height: '100vh',
          objectFit: 'cover',
          opacity: i === 0 ? 1 : 0
        });
      });

      gsap.to(fullscreenBg, { opacity: 1, duration: 1.2, ease: 'power2.inOut' });
      gsap.to(heroFrame, { opacity: 0, duration: 1.0, ease: 'power2.inOut' });

      let current = 0;
      const directions = [
        { xStart: -25, xEnd: 25, scaleStart: 1.05, scaleEnd: 1.18 },
        { xStart: 25, xEnd: -25, scaleStart: 1.18, scaleEnd: 1.05 },
        { xStart: -20, xEnd: 20, scaleStart: 1.08, scaleEnd: 1.20 },
        { xStart: 20, xEnd: -20, scaleStart: 1.15, scaleEnd: 1.05 }
      ];

      gsap.fromTo(slides[0], 
        { x: directions[0].xStart, scale: directions[0].scaleStart },
        { x: directions[0].xEnd, scale: directions[0].scaleEnd, duration: 7.5, ease: 'none', force3D: true }
      );

      setInterval(() => {
        const next = (current + 1) % slides.length;
        const dir = directions[next % directions.length];

        gsap.set(slides[next], { opacity: 0, x: dir.xStart, scale: dir.scaleStart, zIndex: 2 });
        gsap.set(slides[current], { zIndex: 1 });

        gsap.to(slides[next], { opacity: 1, duration: 1.8, ease: 'power2.inOut', force3D: true });
        gsap.to(slides[next], { x: dir.xEnd, scale: dir.scaleEnd, duration: 7.5, ease: 'none', force3D: true });
        gsap.to(slides[current], { opacity: 0, duration: 1.8, ease: 'power2.inOut', force3D: true });

        current = next;
      }, 5800);
    }

    const isMobile = window.matchMedia('(max-width: 768px)').matches;

    if (isMobile) {
      setTimeout(startKenBurnsCarousel, 2500);
    } else {
      const logoCenter = document.getElementById('logo-center');
      const heroTextContainer = document.getElementById('hero-text-container');
      const clock = document.getElementById('hero-clock');
      const heroFrame = document.getElementById('hero-frame');

      if (!logoCenter || !heroTextContainer || !clock || !heroFrame) return;

      gsap.set(heroTextContainer, { top: '50%', left: '50%', xPercent: -50, yPercent: -50, opacity: 0 });
      gsap.set(logoCenter, { top: '50%', left: '50%', xPercent: -50, yPercent: -50, scale: 1, opacity: 1 });
      gsap.set(heroFrame, { opacity: 0, scale: 0.1, transformOrigin: 'center center' });
      gsap.set(clock, { opacity: 0, y: 15 });

      const tl = gsap.timeline({ 
        defaults: { ease: 'power3.inOut' },
        onComplete: startKenBurnsCarousel 
      });

      tl
        .to(heroTextContainer, { opacity: 1, duration: 0.6, delay: 0.4 })
        .to(heroTextContainer, { top: '130px', left: '30px', xPercent: 0, yPercent: 0, duration: 1.0 })
        .to(logoCenter, { top: '130px', left: '120vw', xPercent: 0, scale: 0.55, opacity: 0, duration: 1.0 }, '<')
        .to(clock, { opacity: 1, y: 0, duration: 0.4 }, '-=0.3')
        .to(heroFrame, { opacity: 1, scale: 1, duration: 1.0, ease: 'power4.out' }, '-=0.5');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>

<style>
  .lcp-seo-anchor {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 12px;
    color: transparent;
    background: transparent;
    user-select: none;
    pointer-events: none;
    margin: 0;
    padding: 0;
    z-index: 1;
    width: 200px;
    height: 20px;
    overflow: hidden;
  }

  .stage-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 10;
  }

  .fullscreen-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 5;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-text-container {
    position: absolute;
    z-index: 999999;
    display: flex;
    flex-direction: row;
    gap: 12px;
    white-space: nowrap;
    will-change: transform, top, left, opacity;
    pointer-events: none;
  }

  .text-facet,
  .text-architecture {
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(1.2rem, 3.8vw, 4.1rem);
    letter-spacing: 0.10em;
    color: #111111;
    margin: 0;
    line-height: 1;
    text-transform: uppercase;
  }

  .hero-clock {
    position: absolute;
    bottom: 25px;
    left: 50px;
    z-index: 40;
    font-family: monospace, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-primary, #111111);
    display: flex;
    align-items: center;
    will-change: transform, opacity;
  }

  #clock-canvas {
    width: 160px;
    height: 24px;
    display: block;
  }

  .logo-center-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 450px;
    height: 450px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    pointer-events: none;
    will-change: transform, top, left, opacity;
  }

  .site-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .hero-frame {
    position: absolute;
    top: 22%;
    left: 12%;
    width: 76vw;
    height: 65vh;
    z-index: 20;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    transform-origin: center center;
    will-change: transform, opacity;
    opacity: 1;
  }

  .intro-frame-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* CRITICAL: Strict full-viewport sizing for dynamic slide images */
  :global(.slide-img) {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    object-fit: cover !important;
    display: block !important;
    opacity: 0;
    will-change: transform, opacity;
  }

  :global(.slide-img.active) {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .logo-center-wrapper {
      display: none !important;
    }

    .hero-frame {
      top: 190px;
      left: 0;
      width: 100vw;
      height: 45vh;
      box-shadow: none;
      border-radius: 0;
      opacity: 1;
    }

    .hero-text-container {
      top: 105px;
      left: 15px;
      gap: 6px;
      opacity: 1 !important;
    }

    .text-facet,
    .text-architecture {
      font-size: clamp(1.05rem, 4.1vw, 1.5rem) !important;
      font-weight: 900;
      color: #111111;
      line-height: 1;
    }

    .hero-clock {
      bottom: 20px;
      left: 15px;
      font-size: 0.85rem;
      opacity: 1 !important;
    }
  }
</style>