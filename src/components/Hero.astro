---
import { getImage } from 'astro:assets';
import heroLogoImg from '../assets/facet-logo-white.avif';

import resHeroImg from '../assets/res-eoa-1597-v2.avif';
import resDavidImg from '../assets/res-david.avif';
import resBlannImg from '../assets/kb-res-blann.avif';
import ascotManorImg from '../assets/dev-ascot-manor.avif';
import intStarckImg from '../assets/int-starck.avif';

// Pre-render image optimizations
const heroMobile = await getImage({ src: resHeroImg, format: 'avif', width: 768, quality: 85 });
const heroDesktop = await getImage({ src: resHeroImg, format: 'avif', width: 1440, quality: 90 });

const slide1Mobile = await getImage({ src: resDavidImg, format: 'avif', width: 768, quality: 85 });
const slide1Desktop = await getImage({ src: resDavidImg, format: 'avif', width: 1440, quality: 90 });

const slide2Mobile = await getImage({ src: resBlannImg, format: 'avif', width: 768, quality: 85 });
const slide2Desktop = await getImage({ src: resBlannImg, format: 'avif', width: 1440, quality: 90 });

const slide3Mobile = await getImage({ src: ascotManorImg, format: 'avif', width: 768, quality: 85 });
const slide3Desktop = await getImage({ src: ascotManorImg, format: 'avif', width: 1440, quality: 90 });

const slide4Mobile = await getImage({ src: intStarckImg, format: 'avif', width: 768, quality: 85 });
const slide4Desktop = await getImage({ src: intStarckImg, format: 'avif', width: 1440, quality: 90 });

const logoImg = await getImage({ src: heroLogoImg, format: 'avif', width: 850, height: 850, quality: 90 });

const mobileSlideSrcs = [slide1Mobile.src, slide2Mobile.src, slide3Mobile.src, slide4Mobile.src];
const desktopSlideSrcs = [slide1Desktop.src, slide2Desktop.src, slide3Desktop.src, slide4Desktop.src];
---

<link rel="preload" as="image" href={logoImg.src} type="image/avif" fetchpriority="high" />

<section id="hero-stage" class="stage-container">

  <!-- Persistent Header Title Anchor (Never Disappears) -->
  <header class="brand-header">
    <h1 id="brand-title-text" class="brand-title-text center-stage">FACET ARCHITECTURE</h1>
  </header>

  <!-- Preloader Overlay Layer -->
  <div id="preloader-overlay" class="preloader-overlay">
    <div id="loading-stage" class="loading-stage">
      <!-- Centered Logo -->
      <div id="logo-preloader-wrapper" class="logo-preloader-wrapper">
        <img 
          id="preloader-logo-img"
          src={logoImg.src} 
          alt="Facet Architecture Logo" 
          class="preloader-logo"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </div>

  <main class="hero-main">
    <div 
      id="fullscreen-bg" 
      class="fullscreen-bg"
      data-slides-mobile={JSON.stringify(mobileSlideSrcs)}
      data-slides-desktop={JSON.stringify(desktopSlideSrcs)}
    ></div>

    <div id="hero-frame" class="hero-frame">
      <picture>
        <source media="(max-width: 768px)" srcset={heroMobile.src} type="image/avif" />
        <source media="(min-width: 769px)" srcset={heroDesktop.src} type="image/avif" />
        <img 
          src={heroDesktop.src} 
          alt="Facet Architecture Showcase" 
          class="intro-frame-img"
          loading="eager"
          decoding="async"
        />
      </picture>
    </div>
  </main>

  <div class="hero-clock">
    <span id="sast-clock-display">00:00:00 SAST</span>
  </div>
</section>

<script is:inline>
  // SAST Clock
  const clockEl = document.getElementById('sast-clock-display');
  if (clockEl) {
    const updateClock = () => {
      const now = new Date();
      const sastTime = new Date(now.getTime() + (now.getTimezoneOffset() * 60000) + 7200000);
      clockEl.textContent = `${String(sastTime.getHours()).padStart(2, '0')}:${String(sastTime.getMinutes()).padStart(2, '0')}:${String(sastTime.getSeconds()).padStart(2, '0')} SAST`;
    };
    updateClock();
    setInterval(updateClock, 1000);
  }

  window.addEventListener('DOMContentLoaded', () => {
    const preloaderOverlay = document.getElementById('preloader-overlay');
    const logoWrapper = document.getElementById('logo-preloader-wrapper');
    const brandText = document.getElementById('brand-title-text');
    const heroFrame = document.getElementById('hero-frame');
    const bg = document.getElementById('fullscreen-bg');

    if (!logoWrapper || !brandText) return;

    // STEP 1: Fade in Logo in Center
    setTimeout(() => {
      logoWrapper.classList.add('fade-in');

      // STEP 2: Fade in Text below logo
      setTimeout(() => {
        brandText.classList.add('show-text');

        // STEP 3: Hold together, then gracefully animate logo vertical exit & dock text
        setTimeout(() => {
          // Gracefully slide logo straight up and off screen
          logoWrapper.classList.add('exit-up');

          // Smoothly dock brand text to top-left header position (remains permanently visible)
          brandText.classList.remove('center-stage');
          brandText.classList.add('docked');

          // Dismiss preloader overlay background
          if (preloaderOverlay) preloaderOverlay.classList.add('dismiss-preloader');

          // STEP 4: Reveal Hero Frame Image
          setTimeout(() => {
            if (heroFrame) heroFrame.classList.add('show-hero-frame');

            // STEP 5: Background Slide Showcase Loop
            setTimeout(() => {
              if (heroFrame) {
                heroFrame.classList.remove('show-hero-frame');
                setTimeout(() => { heroFrame.style.display = 'none'; }, 1000);
              }

              if (!bg) return;
              const isMobile = window.matchMedia('(max-width: 768px)').matches;
              const slidesAttr = isMobile 
                ? bg.getAttribute('data-slides-mobile') 
                : bg.getAttribute('data-slides-desktop');

              if (!slidesAttr) return;

              let urls = [];
              try { urls = JSON.parse(slidesAttr); } catch (e) { return; }

              const fragment = document.createDocumentFragment();
              urls.forEach((url, idx) => {
                const img = document.createElement('img');
                img.src = url;
                img.alt = `Slide ${idx + 1}`;
                img.className = 'slide-img';
                fragment.appendChild(img);
              });

              bg.appendChild(fragment);
              const slides = bg.querySelectorAll('.slide-img');
              if (slides.length === 0) return;

              slides[0].style.opacity = '1';
              let current = 0;
              setInterval(() => {
                const next = (current + 1) % slides.length;
                slides[next].style.opacity = '1';
                slides[current].style.opacity = '0';
                current = next;
              }, 5500);

            }, 3000);

          }, 800);

        }, 1500);

      }, 1500);

    }, 200);
  });
</script>

<style>
  .stage-container {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 10;
  }

  /* PERSISTENT BRAND HEADER */
  .brand-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 350;
    pointer-events: none;
  }

  /* BRAND TITLE TEXT (Transitions cleanly from Center to Top Left) */
  .brand-title-text {
    position: fixed;
    font-family: 'Nesobrite', 'Bank Gothic', sans-serif !important;
    font-weight: 900 !important;
    letter-spacing: 0.12em !important;
    color: #000000 !important;
    margin: 0 !important;
    line-height: 1 !important;
    text-transform: uppercase !important;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.6s ease, transform 1.4s cubic-bezier(0.25, 1, 0.5, 1), top 1.4s cubic-bezier(0.25, 1, 0.5, 1), left 1.4s cubic-bezier(0.25, 1, 0.5, 1), font-size 1.4s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform, opacity, top, left;
  }

  .brand-title-text.show-text {
    opacity: 1;
  }

  /* CENTER STAGE PRELOADER POSITION */
  .brand-title-text.center-stage {
    top: 50%;
    left: 50%;
    transform: translate(-50%, 220px);
    font-size: clamp(1.4rem, 2.5vw, 2.25rem) !important;
  }

  /* DOCKED TOP-LEFT PERMANENT POSITION */
  .brand-title-text.docked {
    top: 2rem;
    left: 2rem;
    transform: translate(0, 0);
    font-size: clamp(1.1rem, 1.8vw, 1.5rem) !important;
  }

  /* PRELOADER OVERLAY */
  .preloader-overlay {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: var(--bg-concrete, #BEBEBE);
    z-index: 300;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.8s ease-in-out, visibility 0.8s ease-in-out;
    pointer-events: auto;
  }

  .preloader-overlay.dismiss-preloader {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .loading-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  /* LOGO PRELOADER WRAPPER */
  .logo-preloader-wrapper {
    width: clamp(300px, 45vw, 750px);
    height: auto;
    opacity: 0;
    transform: scale(0.95) translateY(0);
    transition: opacity 0.8s ease, transform 0.8s ease;
    will-change: transform, opacity;
  }

  .logo-preloader-wrapper.fade-in {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  /* GRACEFUL SLOW VERTICAL EXIT UPWARDS */
  .logo-preloader-wrapper.exit-up {
    opacity: 0;
    transform: translateY(-130vh) scale(0.95);
    transition: transform 2.2s cubic-bezier(0.25, 1, 0.5, 1), opacity 1.8s ease-out;
  }

  .preloader-logo {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  /* MAIN STAGE */
  .hero-main {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 15;
  }

  .fullscreen-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 5;
    overflow: hidden;
    pointer-events: none;
  }

  :global(.slide-img) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 1.8s ease-in-out;
    will-change: opacity;
  }

  /* DESKTOP HERO SHOWCASE FRAME */
  .hero-frame {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 72vw;
    max-width: 1100px;
    height: 52vh;
    z-index: 20;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }

  .hero-frame.show-hero-frame {
    opacity: 1;
  }

  .intro-frame-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .hero-clock {
    position: absolute;
    bottom: 25px;
    left: 28px;
    z-index: 200;
    font-family: monospace, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #000000;
    text-shadow: 0 1px 3px rgba(255, 255, 255, 0.5);
  }

  /* MOBILE HERO SHOWCASE FRAME (Edge-to-Edge Centered Banner) */
  @media (max-width: 768px) {
    .brand-title-text.center-stage {
      transform: translate(-50%, 150px);
      font-size: 1.1rem !important;
    }

    .brand-title-text.docked {
      top: 1rem;
      left: 1rem;
      font-size: 0.95rem !important;
    }

    .hero-frame {
      width: 100%;
      max-width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      top: 50%;
      left: 0;
      right: 0;
      transform: translateY(-50%);
      box-shadow: none;
    }

    .intro-frame-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .hero-clock {
      bottom: 20px;
      left: 16px;
    }
  }
</style>