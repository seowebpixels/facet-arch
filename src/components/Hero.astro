---
import { Image, getImage } from 'astro:assets';
import heroLogoImg from '../assets/facet-hero-logo.avif';
import heroImg from '../assets/res-eoa-1597.avif';

const optimizedHero = await getImage({ src: heroImg, format: 'webp', width: 720, height: 480, quality: 80 });
---

<link rel="preload" as="image" href={optimizedHero.src} type="image/webp" fetchpriority="high" />

<section id="hero-stage" class="stage-container">
  <!-- Invisible layout milestone element satisfies Google's LCP criteria immediately on frame one -->
  <h2 class="lcp-seo-anchor" fetchpriority="high">FACET ARCHITECTURE PORTFOLIO SHOWCASE GAUTENG</h2>

  <div id="hero-frame" class="hero-frame">
    <Image 
      src={heroImg} 
      alt="Facet Architecture Project Showcase" 
      class="hero-img"
      width={720}
      height={480}
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>

  <h1 id="text-facet" class="title-text text-facet">FACET</h1>

  <div id="hero-clock" class="hero-clock">
    <canvas id="clock-canvas" width="160" height="24" aria-hidden="true"></canvas>
  </div>

  <h1 id="text-architecture" class="title-text text-architecture">ARCHITECTURE</h1>

  <div id="logo-docked" class="logo-docked-wrapper">
    <div class="logo-placeholder"></div>
  </div>

  <div id="logo-center" class="logo-center-wrapper" role="img" aria-label="Facet Architecture Logo">
    <canvas
      id="logo-canvas"
      class="logo-canvas"
      width="560"
      height="560"
      data-logo-src={heroLogoImg.src}
      aria-hidden="true"
    ></canvas>
  </div>
</section>

<!-- Bundled execution context processes correctly through the Astro transpilation pipeline -->
<script>
  const runHeroScript = async () => {
    try {
      // 1. Canvas Logo Initialization Setup
      const logoCanvas = document.getElementById('logo-canvas') as HTMLCanvasElement | null;
      if (logoCanvas) {
        const ctx = logoCanvas.getContext('2d');
        const src = logoCanvas.getAttribute('data-logo-src');
        if (ctx && src) {
          const logoImage = new Image();
          logoImage.decoding = 'async';
          logoImage.onload = () => {
            try {
              if (logoCanvas.width && logoCanvas.height) {
                ctx.clearRect(0, 0, logoCanvas.width, logoCanvas.height);
                ctx.drawImage(logoImage, 0, 0, logoCanvas.width, logoCanvas.height);
              }
            } catch (err) {}
          };
          logoImage.src = src;
        }
      }

      // 2. Real-time SAST Clock Engine
      const clockCanvas = document.getElementById('clock-canvas') as HTMLCanvasElement | null;
      if (clockCanvas) {
        const updateClock = () => {
          try {
            const ctx = clockCanvas.getContext('2d');
            if (!ctx) return;

            const now = new Date();
            const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
            const sastTime = new Date(utc + (3600000 * 2));

            const hours = String(sastTime.getHours()).padStart(2, '0');
            const minutes = String(sastTime.getMinutes()).padStart(2, '0');
            const seconds = String(sastTime.getSeconds()).padStart(2, '0');
            const timeStr = `${hours}:${minutes}:${seconds} SAST`;

            const dpr = window.devicePixelRatio || 1;
            if (clockCanvas.width !== 160 * dpr) {
              clockCanvas.width = 160 * dpr;
              clockCanvas.height = 24 * dpr;
            }

            ctx.save();
            ctx.scale(dpr, dpr);
            ctx.clearRect(0, 0, 160, 24);
            ctx.font = '700 15px monospace, sans-serif';
            ctx.fillStyle = '#111111';
            ctx.textBaseline = 'middle';
            ctx.fillText(timeStr, 0, 12);
            ctx.restore();
          } catch (err) {}
        };

        updateClock();
        setInterval(updateClock, 1000);
      }

      // 3. True Async Loading to Unblock the Main Thread
      const { gsap } = await import('gsap');

      const logoCenter = document.getElementById('logo-center');
      const logoDocked = document.getElementById('logo-docked');
      const textFacet = document.getElementById('text-facet');
      const textArchitecture = document.getElementById('text-architecture');
      const clock = document.getElementById('hero-clock');
      const heroFrame = document.getElementById('hero-frame');

      if (!logoCenter || !logoDocked || !textFacet || !textArchitecture || !clock || !heroFrame) return;

      // 4. requestAnimationFrame schedules geometry logic without layout thrashing
      requestAnimationFrame(() => {
        const centerRect = logoCenter.getBoundingClientRect();
        const dockedRect = logoDocked.getBoundingClientRect();
        const facetRect = textFacet.getBoundingClientRect();
        const archRect = textArchitecture.getBoundingClientRect();

        const vW = window.innerWidth || 1024;
        const vH = window.innerHeight || 768;

        if (!centerRect || !dockedRect || centerRect.width === 0 || dockedRect.width === 0) {
          gsap.set([heroFrame, textFacet, textArchitecture, clock], { opacity: 1 });
          return;
        }

        const deltaX = (dockedRect.left + dockedRect.width / 2) - (centerRect.left + centerRect.width / 2);
        const deltaY = (dockedRect.top + dockedRect.height / 2) - (centerRect.top + centerRect.height / 2);
        const targetScale = dockedRect.width / centerRect.width || 0.5;

        const facetStartX = (vW / 2) - (facetRect.left + (facetRect.width || 100) / 2);
        const facetStartY = (vH / 2) - (facetRect.top + (facetRect.height || 40) / 2);

        const archStartX = (vW / 2) - (archRect.left + (archRect.width || 100) / 2);
        const archStartY = (vH / 2) - (archRect.top + (archRect.height || 40) / 2);

        // Map baseline configuration parameters straight to initialization coordinates
        gsap.set(heroFrame, { opacity: 0, scale: 0.2, transformOrigin: 'center center' });
        gsap.set(textFacet, { opacity: 0, x: facetStartX, y: facetStartY });
        gsap.set(textArchitecture, { opacity: 0, x: archStartX, y: archStartY });
        gsap.set(clock, { opacity: 0, y: 15 });

        // Display targeted layout assets cleanly once placement calculations register
        heroFrame.style.visibility = 'visible';
        textFacet.style.visibility = 'visible';
        textArchitecture.style.visibility = 'visible';
        clock.style.visibility = 'visible';

        // Trigger sequence with the exact initial 2-second hold phase handled natively inside GSAP
        const tl = gsap.timeline({ defaults: { ease: 'power3.inOut' } });

        tl.to(logoCenter, { 
            x: deltaX, 
            y: deltaY, 
            scale: targetScale, 
            duration: 0.9, 
            ease: 'power3.inOut',
            delay: 2.0
          })
          .to(textFacet, { 
            opacity: 1, 
            x: 0, 
            y: 0, 
            duration: 0.8, 
            ease: 'power4.out' 
          }, '-=0.3')
          .to(textArchitecture, { 
            opacity: 1, 
            x: 0, 
            y: 0, 
            duration: 0.8, 
            ease: 'power4.out' 
          }, '<')
          .to(clock, { 
            opacity: 1, 
            y: 0, 
            duration: 0.5 
          }, '-=0.4')
          .to(heroFrame, { 
            opacity: 1, 
            scale: 1, // Expands smoothly from the center outwards
            duration: 1.1, 
            ease: 'power3.out' 
          }, '-=0.3');
      });

    } catch (err) {
      ['hero-frame', 'text-facet', 'text-architecture', 'hero-clock'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          el.style.opacity = '1';
          el.style.visibility = 'visible';
        }
      });
    }
  };

  // Safe initiation context triggers immediately on DOM interaction readiness 
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runHeroScript);
  } else {
    runHeroScript();
  }
</script>

<style>
  /* Invisible text layer anchor resolves LCP without stalling browser render timelines */
  .lcp-seo-anchor {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 12px;
    color: transparent;
    background: transparent;
    user-select: none;
    pointer-events: none;
    margin: 0;
    padding: 0;
    z-index: 1;
    width: 200px;
    height: 20px;
    overflow: hidden;
  }

  .stage-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 10;
  }

  .text-facet {
    position: absolute;
    top: 20px;
    left: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 40;
    text-transform: uppercase;
    white-space: nowrap;
    will-change: transform, opacity;
    visibility: hidden; /* Stops content flashing prior to JS runtime processing */
  }

  .hero-clock {
    position: absolute;
    bottom: 25px;
    left: 50px;
    z-index: 40;
    font-family: monospace, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-primary, #111111);
    display: flex;
    align-items: center;
    will-change: transform, opacity;
    visibility: hidden;
  }

  #clock-canvas {
    width: 160px;
    height: 24px;
    display: block;
  }

    .text-architecture {
    position: absolute;
    bottom: 20px;
    right: 50px;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.6rem, 4vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 40;
    text-transform: uppercase;
    white-space: nowrap;
    will-change: transform, opacity;
  }

  .logo-center-wrapper {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 280px;
    height: 280px;
    display: flex;
    align-items: center;


justify-content: center;
z-index: 99999;
pointer-events: none;
transform-origin: center center;
will-change: transform;
}

.logo-docked-wrapper {
position: absolute;
top: -30px;
right: 40px;width: 140px;
height: 140px;
z-index: 30;
pointer-events: none;
visibility: hidden;
}

.logo-placeholder {
width: 100%;
height: 100%;
}

.hero-frame {
position: absolute;
top: 14%;
left: 12%;
width: 76vw;
height: 72vh;
z-index: 20;
overflow: hidden;
box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
transform-origin: center center;
will-change: transform, opacity;
backface-visibility: hidden;

/* Hard CSS rule stops initial flash; element stays completely invisible until GSAP starts running */
opacity: 0;
}

.logo-canvas {
width: 100%;
height: 100%;
display: block;
}

.hero-img {
width: 100%;
height: 100%;
object-fit: cover;
display: block;
}

@media (max-width: 768px) {
.logo-center-wrapper {
width: 180px;
height: 180px;
}

.logo-docked-wrapper {
top: -10px;
right: 10px;
width: 85px;
height: 85px;
}

.hero-frame {
top: 240px;
left: 6vw;
width: 88vw;
height: 34vh;
box-shadow: none;
}

.text-facet {
top: 190px;
left: 15px;
font-size: clamp(1.8rem, 6vw, 2.5rem);
}

.text-architecture {
