---
import { getImage } from 'astro:assets';
import heroLogoImg from '../assets/facet-logo-white.avif';

import resHeroImg from '../assets/res-eoa-1597-v2.avif';
import resDavidImg from '../assets/res-david.avif';
import resBlannImg from '../assets/res-blann.avif';
import ascotManorImg from '../assets/dev-ascot-manor.avif';
import intStarckImg from '../assets/int-starck.avif';

// --- FRONTMATTER OPTIMIZATION ---
const heroMobile = await getImage({ src: resHeroImg, format: 'avif', width: 500, quality: 60 });
const heroDesktop = await getImage({ src: resHeroImg, format: 'avif', width: 1440, quality: 85 });

const slide1Mobile = await getImage({ src: resDavidImg, format: 'avif', width: 480, quality: 60 });
const slide1Desktop = await getImage({ src: resDavidImg, format: 'avif', width: 1440, quality: 85 });

const slide2Mobile = await getImage({ src: resBlannImg, format: 'avif', width: 480, quality: 60 });
const slide2Desktop = await getImage({ src: resBlannImg, format: 'avif', width: 1440, quality: 85 });

const slide3Mobile = await getImage({ src: ascotManorImg, format: 'avif', width: 480, quality: 60 });
const slide3Desktop = await getImage({ src: ascotManorImg, format: 'avif', width: 1440, quality: 85 });

const slide4Mobile = await getImage({ src: intStarckImg, format: 'avif', width: 480, quality: 60 });
const slide4Desktop = await getImage({ src: intStarckImg, format: 'avif', width: 1440, quality: 85 });

const logoImg = await getImage({ src: heroLogoImg, format: 'avif', width: 350, height: 350, quality: 85 });
---

<!-- CRITICAL PRELOADS FOR INSTANT LCP PAINT -->
<link 
  rel="preload" 
  as="image" 
  href={logoImg.src} 
  type="image/avif" 
  fetchpriority="high" 
/>
<link 
  rel="preload" 
  as="image" 
  href={heroMobile.src} 
  media="(max-width: 768px)"
  type="image/avif" 
  fetchpriority="high" 
/>
<link 
  rel="preload" 
  as="image" 
  href={heroDesktop.src} 
  media="(min-width: 769px)"
  type="image/avif" 
  fetchpriority="high" 
/>

<section id="hero-stage" class="stage-container">
  <h2 class="lcp-seo-anchor">FACET ARCHITECTURE PORTFOLIO SHOWCASE GAUTENG</h2>

  <!-- CENTER WRAPPER: Renders DEAD-CENTER instantly on Frame 1 -->
  <div id="intro-center-group" class="intro-center-group">
    <!-- LOGO (Shoots off-screen upward) -->
    <div id="logo-center" class="logo-wrapper" role="img" aria-label="Facet Architecture Logo">
      <img 
        src={logoImg.src} 
        alt="Facet Architecture Logo" 
        class="site-logo"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="350"
        height="350"
      />
    </div>

    <!-- FA TEXT (Glides up to top-left header position, stays completely ON SCREEN) -->
    <div id="hero-text-container" class="hero-text-container">
      <h1 id="text-facet" class="title-text text-facet">FACET</h1>
      <h1 id="text-architecture" class="title-text text-architecture">ARCHITECTURE</h1>
    </div>
  </div>

  <main id="hero-main-content">
    <div 
      id="fullscreen-bg" 
      class="fullscreen-bg"
      data-slides-mobile={JSON.stringify([slide1Mobile.src, slide2Mobile.src, slide3Mobile.src, slide4Mobile.src])}
      data-slides-desktop={JSON.stringify([slide1Desktop.src, slide2Desktop.src, slide3Desktop.src, slide4Desktop.src])}
    ></div>

    <div id="hero-frame" class="hero-frame">
      <picture>
        <source media="(max-width: 768px)" srcset={heroMobile.src} type="image/avif" />
        <source media="(min-width: 769px)" srcset={heroDesktop.src} type="image/avif" />
        <img 
          src={heroDesktop.src} 
          alt="Facet Architecture Initial Hero" 
          class="hero-img intro-frame-img"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width={heroDesktop.attributes.width}
          height={heroDesktop.attributes.height}
        />
      </picture>
    </div>
  </main>

  <div id="hero-clock" class="hero-clock">
    <canvas id="clock-canvas" width="160" height="24" aria-hidden="true"></canvas>
  </div>
</section>

<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    // --- NON-BLOCKING CANVAS CLOCK ---
    const clockCanvas = document.getElementById('clock-canvas');
    if (clockCanvas) {
      const ctx = clockCanvas.getContext('2d', { alpha: false });
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      
      clockCanvas.width = 160 * dpr;
      clockCanvas.height = 24 * dpr;

      const updateClock = () => {
        if (!ctx) return;
        const now = new Date();
        const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
        const sastTime = new Date(utc + 7200000);

        const hours = String(sastTime.getHours()).padStart(2, '0');
        const minutes = String(sastTime.getMinutes()).padStart(2, '0');
        const seconds = String(sastTime.getSeconds()).padStart(2, '0');

        ctx.save();
        ctx.scale(dpr, dpr);
        ctx.fillStyle = '#BEBEBE';
        ctx.fillRect(0, 0, 160, 24);
        ctx.font = '700 15px monospace, sans-serif';
        ctx.fillStyle = '#111111';
        ctx.textBaseline = 'middle';
        ctx.fillText(`${hours}:${minutes}:${seconds} SAST`, 0, 12);
        ctx.restore();
      };

      requestAnimationFrame(() => {
        updateClock();
        setInterval(updateClock, 1000);
      });
    }

    // --- TIMED GPU-COMPOSITED ANIMATION SEQUENCE ---
    const logoCenter = document.getElementById('logo-center');
    const heroText = document.getElementById('hero-text-container');
    const heroFrame = document.getElementById('hero-frame');
    const bg = document.getElementById('fullscreen-bg');

    // Step 1: Hold dead-center for 1.8s, then trigger transition
    setTimeout(() => {
      if (logoCenter) logoCenter.classList.add('animate-offscreen');
      if (heroText) heroText.classList.add('animate-to-header');
      if (heroFrame) heroFrame.classList.add('show-hero-frame');

      // Step 2: Hold Hero Frame 3s then fade out
      setTimeout(() => {
        if (heroFrame) {
          heroFrame.classList.remove('show-hero-frame');
          setTimeout(() => { heroFrame.style.display = 'none'; }, 1000);
        }

        // Step 3: Slideshow
        if (!bg) return;
        const isMobile = window.matchMedia('(max-width: 768px)').matches;
        const slidesAttr = isMobile 
          ? bg.getAttribute('data-slides-mobile') 
          : bg.getAttribute('data-slides-desktop');

        if (!slidesAttr) return;

        const urls = JSON.parse(slidesAttr);
        
        urls.forEach((url, idx) => {
          const img = document.createElement('img');
          img.src = url;
          img.alt = `Facet Architecture Slide ${idx + 1}`;
          img.style.cssText = `
            position: absolute; top:0; left:0; width:100vw; height:100vh;
            object-fit:cover; opacity:0; transition: opacity 1.8s ease-in-out;
            will-change: opacity;
          `;
          bg.appendChild(img);
        });

        const slides = bg.querySelectorAll('img');
        if (slides.length === 0) return;

        slides[0].style.opacity = '1';

        let current = 0;
        setInterval(() => {
          const next = (current + 1) % slides.length;
          slides[next].style.opacity = '1';
          slides[current].style.opacity = '0';
          current = next;
        }, 5500);

      }, 3000);

    }, 1800);
  });
</script>

<style>
  .lcp-seo-anchor {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 12px;
    color: transparent;
    background: transparent;
    user-select: none;
    pointer-events: none;
    margin: 0;
    padding: 0;
    z-index: 1;
    width: 200px;
    height: 20px;
    overflow: hidden;
  }

  .stage-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 10;
  }

  .fullscreen-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 5;
    overflow: hidden;
    pointer-events: none;
  }

  /* --- DEAD-CENTER INTRO GROUP (GPU COMPOSITED) --- */
  .intro-center-group {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate3d(-50%, -50%, 0);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    z-index: 9999;
    pointer-events: none;
    width: max-content;
  }

  .logo-wrapper {
    width: min(350px, 60vw);
    height: min(350px, 60vw);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition: transform 1.2s cubic-bezier(0.77, 0, 0.175, 1), opacity 0.8s ease-in-out;
    will-change: transform, opacity;
  }

  /* LOGO SHOOTS OFF SCREEN UPWARD */
  .logo-wrapper.animate-offscreen {
    transform: translate3d(0, -150vh, 0) !important;
    opacity: 0 !important;
  }

  .site-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* --- FA TEXT: Pure GPU Transform Animation (No CLS / Non-composited errors) --- */
  .hero-text-container {
    display: flex;
    flex-direction: row;
    gap: 12px;
    white-space: nowrap;
    opacity: 1; /* Instant paint for zero element render delay */
    transition: transform 1.2s cubic-bezier(0.77, 0, 0.175, 1);
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  /* FA TEXT MOVES TO TOP HEADER (CALCULATED FROM DEAD-CENTER) */
  .hero-text-container.animate-to-header {
    transform: translate3d(calc(-50vw + 50px + 50%), calc(-50vh + 35px + 100%), 0) !important;
  }

  .text-facet,
  .text-architecture {
    font-family: 'Nesobrite', 'Bank Gothic', sans-serif !important;
    font-weight: 900 !important;
    font-size: clamp(1.2rem, 3.8vw, 4.1rem) !important;
    letter-spacing: 0.10em !important;
    color: #111111 !important;
    margin: 0 !important;
    line-height: 1 !important;
    text-transform: uppercase !important;
  }

  .hero-clock {
    position: absolute;
    bottom: 25px;
    left: 50px;
    z-index: 40;
    font-family: monospace, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-primary, #111111);
    display: flex;
    align-items: center;
    contain: strict;
  }

  #clock-canvas {
    width: 160px;
    height: 24px;
    display: block;
  }

  /* --- HERO IMAGE FRAME --- */
  .hero-frame {
    position: absolute;
    top: 22%;
    left: 12%;
    width: 76vw;
    height: 65vh;
    z-index: 20;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    transform-origin: center center;
    will-change: opacity;
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }

  .hero-frame.show-hero-frame {
    opacity: 1;
  }

  .intro-frame-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- MOBILE STYLING --- */
  @media (max-width: 768px) {
    .intro-center-group {
      gap: 10px;
    }

    .logo-wrapper {
      width: 200px;
      height: 200px;
    }

    .hero-text-container.animate-to-header {
      transform: translate3d(calc(-50vw + 15px + 50%), calc(-50vh + 25px + 100%), 0) !important;
    }

    .text-facet,
    .text-architecture {
      font-size: clamp(1.05rem, 4.1vw, 1.5rem) !important;
    }

    .hero-frame {
      top: 190px;
      left: 0;
      width: 100vw;
      height: 45vh;
      box-shadow: none;
      border-radius: 0;
    }

    .hero-clock {
      bottom: 20px;
      left: 15px;
      font-size: 0.85rem;
    }
  }
</style>