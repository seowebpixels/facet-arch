---
import { getImage } from 'astro:assets';
import heroLogoImg from '../assets/facet-logo-white.avif';

import resHeroImg from '../assets/res-eoa-1597-v2.avif';
import resDavidImg from '../assets/res-david.avif';
import resBlannImg from '../assets/kb-res-blann.avif';
import ascotManorImg from '../assets/dev-ascot-manor.avif';
import intStarckImg from '../assets/int-starck.avif';

// Optimized explicitly for 9:16 / Phone Wallpaper dimensions (e.g., 1080x1920 scaled to 432x768 / 480x853)
const heroMobile = await getImage({ src: resHeroImg, format: 'avif', width: 480, height: 853, quality: 65 });
const heroDesktop = await getImage({ src: resHeroImg, format: 'avif', width: 1440, quality: 85 });

const slide1Mobile = await getImage({ src: resDavidImg, format: 'avif', width: 480, height: 853, quality: 65 });
const slide1Desktop = await getImage({ src: resDavidImg, format: 'avif', width: 1440, quality: 85 });

const slide2Mobile = await getImage({ src: resBlannImg, format: 'avif', width: 480, height: 853, quality: 65 });
const slide2Desktop = await getImage({ src: resBlannImg, format: 'avif', width: 1440, quality: 85 });

const slide3Mobile = await getImage({ src: ascotManorImg, format: 'avif', width: 480, height: 853, quality: 65 });
const slide3Desktop = await getImage({ src: ascotManorImg, format: 'avif', width: 1440, quality: 85 });

const slide4Mobile = await getImage({ src: intStarckImg, format: 'avif', width: 480, height: 853, quality: 65 });
const slide4Desktop = await getImage({ src: intStarckImg, format: 'avif', width: 1440, quality: 85 });

const logoImg = await getImage({ src: heroLogoImg, format: 'avif', width: 350, height: 350, quality: 85 });

// Extract src strings into clean frontmatter arrays
const mobileSlideSrcs = [slide1Mobile.src, slide2Mobile.src, slide3Mobile.src, slide4Mobile.src];
const desktopSlideSrcs = [slide1Desktop.src, slide2Desktop.src, slide3Desktop.src, slide4Desktop.src];
---

<!-- CRITICAL LCP PRELOAD FOR LOGO -->
<link rel="preload" as="image" href={logoImg.src} type="image/avif" fetchpriority="high" />

<section id="hero-stage" class="stage-container">
  <!-- FA Title Positioned Initially at Center, Transitions to Top -->
  <div id="hero-text-container" class="hero-text-container">
    <h1 class="title-text">FACET ARCHITECTURE</h1>
  </div>

  <!-- Initial Center Intro Logo -->
  <div id="logo-center" class="logo-wrapper">
    <img 
      src={logoImg.src} 
      alt="Facet Architecture Logo" 
      class="site-logo"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      width="350"
      height="350"
    />
  </div>

  <main>
    <div 
      id="fullscreen-bg" 
      class="fullscreen-bg"
      data-slides-mobile={JSON.stringify(mobileSlideSrcs)}
      data-slides-desktop={JSON.stringify(desktopSlideSrcs)}
    ></div>

    <!-- Hidden initially during intro -->
    <div id="hero-frame" class="hero-frame">
      <picture>
        <source media="(max-width: 768px)" srcset={heroMobile.src} type="image/avif" />
        <source media="(min-width: 769px)" srcset={heroDesktop.src} type="image/avif" />
        <img 
          src={heroDesktop.src} 
          alt="Facet Architecture Showcase" 
          class="intro-frame-img"
          loading="lazy"
          decoding="async"
          width={heroDesktop.attributes.width}
          height={heroDesktop.attributes.height}
        />
      </picture>
    </div>
  </main>

  <div class="hero-clock">
    <span id="sast-clock-display">00:00:00 SAST</span>
  </div>
</section>

<script is:inline>
  // Real-time clock setup
  const clockEl = document.getElementById('sast-clock-display');
  if (clockEl) {
    const updateClock = () => {
      const now = new Date();
      const sastTime = new Date(now.getTime() + (now.getTimezoneOffset() * 60000) + 7200000);
      clockEl.textContent = `${String(sastTime.getHours()).padStart(2, '0')}:${String(sastTime.getMinutes()).padStart(2, '0')}:${String(sastTime.getSeconds()).padStart(2, '0')} SAST`;
    };
    updateClock();
    setInterval(updateClock, 1000);
  }

  window.addEventListener('DOMContentLoaded', () => {
    const logoCenter = document.getElementById('logo-center');
    const heroText = document.getElementById('hero-text-container');
    const heroFrame = document.getElementById('hero-frame');
    const bg = document.getElementById('fullscreen-bg');

    // STEP 1: 0s - 2s -> Only Logo visible.
    // STEP 2: At 2s -> Show FA title under/with logo.
    setTimeout(() => {
      if (heroText) heroText.classList.add('show-text');

      // STEP 3: At 3s (1s after FA appears) -> Logo shoots off screen, FA moves to top header slot, Hero image appears.
      setTimeout(() => {
        if (logoCenter) logoCenter.classList.add('hide-logo');
        if (heroText) heroText.classList.add('move-to-top');
        if (heroFrame) heroFrame.classList.add('show-hero-frame');

        // STEP 4: Reveal background slider
        setTimeout(() => {
          if (heroFrame) {
            heroFrame.classList.remove('show-hero-frame');
            setTimeout(() => { heroFrame.style.display = 'none'; }, 1000);
          }

          if (!bg) return;
          const isMobile = window.matchMedia('(max-width: 768px)').matches;
          const slidesAttr = isMobile 
            ? bg.getAttribute('data-slides-mobile') 
            : bg.getAttribute('data-slides-desktop');

          if (!slidesAttr) return;

          let urls = [];
          try {
            urls = JSON.parse(slidesAttr);
          } catch (e) {
            console.error('Failed to parse slide URLs:', e);
            return;
          }

          const fragment = document.createDocumentFragment();
          
          urls.forEach((url, idx) => {
            const img = document.createElement('img');
            img.src = url;
            img.alt = `Slide ${idx + 1}`;
            img.className = 'slide-img';
            fragment.appendChild(img);
          });

          bg.appendChild(fragment);
          const slides = bg.querySelectorAll('.slide-img');
          if (slides.length === 0) return;

          slides[0].style.opacity = '1';

          let current = 0;
          setInterval(() => {
            const next = (current + 1) % slides.length;
            slides[next].style.opacity = '1';
            slides[current].style.opacity = '0';
            current = next;
          }, 5500);

        }, 3000);

      }, 1000);

    }, 2000);
  });
</script>

<style>
  .stage-container {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh; /* Dynamic viewport height for modern mobile browsers */
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 10;
  }

  .fullscreen-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    z-index: 5;
    overflow: hidden;
    pointer-events: none;
  }

  :global(.slide-img) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 1.8s ease-in-out;
    will-change: opacity;
  }

  /* INTRO LOGO (Center) */
  .logo-wrapper {
    position: absolute;
    top: 45%;
    left: 50%;
    transform: translate3d(-50%, -50%, 0);
    width: min(350px, 60vw);
    height: min(350px, 60vw);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    pointer-events: none;
  }

  .logo-wrapper.hide-logo {
    transform: translate3d(-50%, -180vh, 0);
    opacity: 0;
    transition: transform 1.2s cubic-bezier(0.77, 0, 0.175, 1), opacity 0.8s ease-in-out;
  }

  .site-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* FA TITLE ANIMATION */
  .hero-text-container {
    position: absolute;
    top: 65%;
    left: 50%;
    transform: translate3d(-50%, -50%, 0);
    z-index: 30;
    opacity: 0;
    will-change: transform, opacity;
    transition: opacity 0.8s ease-in-out, transform 1.2s cubic-bezier(0.77, 0, 0.175, 1);
    pointer-events: none;
  }

  .hero-text-container.show-text {
    opacity: 1;
  }

  .hero-text-container.move-to-top {
    transform: translate3d(calc(-50vw + 12vw + 50%), calc(-65vh + 135px), 0);
  }

  .title-text {
    font-family: 'Nesobrite', 'Bank Gothic', sans-serif !important;
    font-weight: 900 !important;
    font-size: clamp(1.2rem, 2.5vw, 2.8rem) !important;
    letter-spacing: 0.10em !important;
    color: #111111 !important;
    margin: 0 !important;
    line-height: 1 !important;
    text-transform: uppercase !important;
    white-space: nowrap;
  }

  /* HERO SHOWCASE FRAME */
  .hero-frame {
    position: absolute;
    top: 22%;
    left: 12vw;
    width: 76vw;
    height: 65vh;
    z-index: 20;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }

  .hero-frame.show-hero-frame {
    opacity: 1;
  }

  .intro-frame-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-clock {
    position: absolute;
    bottom: 25px;
    left: 50px;
    z-index: 40;
    font-family: monospace, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-primary, #111111);
  }

  /* MOBILE FULL-SCREEN OVERRIDES */
  @media (max-width: 768px) {
    .hero-text-container.move-to-top {
      transform: translate3d(calc(-50vw + 20px + 50%), calc(-65vh + 100px), 0);
    }

    .hero-frame,
    .fullscreen-bg {
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 100vh !important;
      height: 100dvh !important;
    }

    :global(.slide-img),
    .intro-frame-img {
      width: 100% !important;
      height: 100vh !important;
      height: 100dvh !important;
      object-fit: cover !important;
      object-position: center !important;
    }
  
    .hero-clock {
      bottom: 20px;
      left: 15px;
    }
  }
</style>