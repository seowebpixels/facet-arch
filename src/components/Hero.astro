---
import { Image, getImage } from 'astro:assets';
import heroLogoImg from '../assets/facet-hero-logo.avif';

// Import verified showcase images
import resHeroImg from '../assets/res-eoa-1597.avif';
import resBlannImg from '../assets/res-blann.avif';
import ascotManorImg from '../assets/dev-ascot-manor.avif';
import intStarckImg from '../assets/int-starck.avif';

const heroImages = [resHeroImg, resBlannImg, intStarckImg];

const optimizedHero = await getImage({ src: resHeroImg, format: 'webp', width: 720, height: 480, quality: 100 });
---

<!-- Preload main initial image -->
<link rel="preload" as="image" href={optimizedHero.src} type="image/webp" fetchpriority="high" />

<section id="hero-stage" class="stage-container">
  <h2 class="lcp-seo-anchor" fetchpriority="high">FACET ARCHITECTURE PORTFOLIO SHOWCASE GAUTENG</h2>

  <div id="hero-frame" class="hero-frame">
    {heroImages.map((img, index) => (
      <Image 
        src={img} 
        alt={`Facet Architecture Showcase ${index + 1}`} 
        class={`hero-img slide-img ${index === 0 ? 'active' : ''}`}
        widths={[720, 1280, 1920, 2560, 3840]}
        sizes="100vw"
        format="avif"
        quality={100}
        loading={index === 0 ? "eager" : "lazy"}
        fetchpriority={index === 0 ? "high" : "low"}
        decoding="sync"
      />
    ))}
  </div>

  <h1 id="text-facet" class="title-text text-facet">FACET</h1>
  <h1 id="text-architecture" class="title-text text-architecture">ARCHITECTURE</h1>

  <div id="hero-clock" class="hero-clock">
    <canvas id="clock-canvas" width="160" height="24" aria-hidden="true"></canvas>
  </div>

  <div id="logo-center" class="logo-center-wrapper" role="img" aria-label="Facet Architecture Logo">
    <canvas
      id="logo-canvas"
      class="logo-canvas"
      width="760"
      height="760"
      data-logo-src={heroLogoImg.src}
      aria-hidden="true"
    ></canvas>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function initHero() {
    // 1. Canvas Logo Render Engine
    const logoCanvas = document.getElementById('logo-canvas') as HTMLCanvasElement | null;
    if (logoCanvas) {
      const ctx = logoCanvas.getContext('2d');
      const src = logoCanvas.getAttribute('data-logo-src');
      if (ctx && src) {
        const dpr = window.devicePixelRatio || 1;
        const displaySize = 380;
        
        logoCanvas.width = displaySize * dpr;
        logoCanvas.height = displaySize * dpr;

        const logoImage = new Image();
        logoImage.onload = () => {
          ctx.save();
          ctx.scale(dpr, dpr);
          ctx.imageSmoothingEnabled = true;
          ctx.imageSmoothingQuality = 'high';
          ctx.clearRect(0, 0, displaySize, displaySize);
          ctx.drawImage(logoImage, 0, 0, displaySize, displaySize);
          ctx.restore();
        };
        logoImage.src = src;
      }
    }

    // 2. Real-time SAST Clock
    const clockCanvas = document.getElementById('clock-canvas') as HTMLCanvasElement | null;
    if (clockCanvas) {
      const updateClock = () => {
        const ctx = clockCanvas.getContext('2d');
        if (!ctx) return;

        const now = new Date();
        const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
        const sastTime = new Date(utc + (3600000 * 2));

        const hours = String(sastTime.getHours()).padStart(2, '0');
        const minutes = String(sastTime.getMinutes()).padStart(2, '0');
        const seconds = String(sastTime.getSeconds()).padStart(2, '0');
        const timeStr = `${hours}:${minutes}:${seconds} SAST`;

        const dpr = window.devicePixelRatio || 1;
        if (clockCanvas.width !== 160 * dpr) {
          clockCanvas.width = 160 * dpr;
          clockCanvas.height = 24 * dpr;
        }

        ctx.save();
        ctx.scale(dpr, dpr);
        ctx.clearRect(0, 0, 160, 24);
        ctx.font = '700 15px monospace, sans-serif';
        ctx.fillStyle = '#111111';
        ctx.textBaseline = 'middle';
        ctx.fillText(timeStr, 0, 12);
        ctx.restore();
      };

      updateClock();
      setInterval(updateClock, 1000);
    }

    // 3. Ken Burns Moving Image Carousel Loop
    function startKenBurnsCarousel() {
      const slides = document.querySelectorAll('.slide-img');
      if (slides.length <= 1) return;

      let current = 0;
      
      gsap.to(slides[0], { scale: 1.15, duration: 7, ease: 'none' });

      setInterval(() => {
        const next = (current + 1) % slides.length;

        gsap.set(slides[next], { opacity: 0, scale: 1.0, zIndex: 2 });
        gsap.set(slides[current], { zIndex: 1 });

        gsap.to(slides[next], {
          opacity: 1,
          duration: 1.8,
          ease: 'power2.inOut'
        });

        gsap.to(slides[next], {
          scale: 1.15,
          duration: 7,
          ease: 'none'
        });

        gsap.to(slides[current], {
          opacity: 0,
          duration: 1.8,
          ease: 'power2.inOut',
          onComplete: () => {
            gsap.set(slides[current], { scale: 1.0 });
          }
        });

        current = next;
      }, 5500);
    }

    // 4. GSAP Intro Timeline Sequence
    const logoCenter = document.getElementById('logo-center');
    const textFacet = document.getElementById('text-facet');
    const textArchitecture = document.getElementById('text-architecture');
    const clock = document.getElementById('hero-clock');
    const heroFrame = document.getElementById('hero-frame');

    if (!logoCenter || !textFacet || !textArchitecture || !clock || !heroFrame) return;

    const frameBounds = heroFrame.getBoundingClientRect();
    const isMobile = window.innerWidth <= 768;

    if (isMobile) {
      gsap.set(heroFrame, { opacity: 0, scale: 0.1, transformOrigin: 'center center' });
      gsap.set([textFacet, textArchitecture], { opacity: 0 });
      gsap.set(clock, { opacity: 0, y: 15 });

      logoCenter.style.visibility = 'visible';
      heroFrame.style.visibility = 'visible';
      textFacet.style.visibility = 'visible';
      textArchitecture.style.visibility = 'visible';
      clock.style.visibility = 'visible';

      const tl = gsap.timeline({ 
        defaults: { ease: 'power3.inOut' },
        onComplete: startKenBurnsCarousel
      });

      tl.to(logoCenter, {
          top: '-60px',
          left: '50%',
          xPercent: -50,
          yPercent: 0,
          x: 0,
          y: 0,
          scale: 0.50,
          duration: 1.3,
          delay: 2.0
        })
        .to([textFacet, textArchitecture], {
          opacity: 1,
          duration: 1.1,
          ease: 'power4.out'
        }, '-=0.5')
        .to(clock, {
          opacity: 1,
          y: 0,
          duration: 0.5
        }, '-=0.4')
        .to(heroFrame, {
          opacity: 1,
          scale: 1,
          duration: 1.2,
          ease: 'power4.out'
        }, '-=0.6');

    } else {
      const startX = window.innerWidth / 2;
      const startY = window.innerHeight / 2;

      gsap.set(heroFrame, { opacity: 0, scale: 0.1, transformOrigin: 'center center' });
      gsap.set(textFacet, { opacity: 0, x: startX, y: startY, xPercent: -50, yPercent: -50 }); 
      gsap.set(textArchitecture, { opacity: 0, x: startX, y: startY, xPercent: -50, yPercent: -50 });
      gsap.set(clock, { opacity: 0, y: 15 });

      logoCenter.style.visibility = 'visible';
      heroFrame.style.visibility = 'visible';
      textFacet.style.visibility = 'visible';
      textArchitecture.style.visibility = 'visible';
      clock.style.visibility = 'visible';

      const facetWidth = textFacet.offsetWidth;
      const architectureX = frameBounds.left + facetWidth + 20;

      const tl = gsap.timeline({ 
        defaults: { ease: 'power3.inOut' },
        onComplete: startKenBurnsCarousel 
      });

      tl.to(logoCenter, {
          top: '-122px',
          left: 'calc(100vw + 85px)',
          xPercent: -100,
          yPercent: 0,
          x: 0,
          y: 0,
          scale: 0.45,
          duration: 1.3,
          ease: 'power2.inOut',
          delay: 2.0
        })
        .to(textFacet, {
          opacity: 1,
          x: frameBounds.left, 
          y: frameBounds.top - 45,
          xPercent: 0,
          yPercent: -100,
          duration: 1.1,
          ease: 'power4.out'
        }, '-=0.5')
        .to(textArchitecture, {
          opacity: 1,
          x: architectureX,
          y: frameBounds.top - 45,
          xPercent: 0,
          yPercent: -100,
          duration: 1.1,
          ease: 'power4.out'
        }, '<')
        .to(clock, {
          opacity: 1,
          y: 0,
          duration: 0.5
        }, '-=0.4')
        .to(heroFrame, {
          opacity: 1,
          scale: 1,
          duration: 1.2,
          ease: 'power4.out'
        }, '-=0.6');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>

<style>
  .lcp-seo-anchor {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 12px;
    color: transparent;
    background: transparent;
    user-select: none;
    pointer-events: none;
    margin: 0;
    padding: 0;
    z-index: 1;
    width: 200px;
    height: 20px;
    overflow: hidden;
  }

  .stage-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 10;
  }

  .text-facet,
  .text-architecture {
    position: absolute;
    top: 0;
    left: 0;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.2rem, 3.8vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 40;
    text-transform: uppercase;
    white-space: nowrap;
    will-change: transform, opacity;
    visibility: hidden;
  }

  .hero-clock {
    position: absolute;
    bottom: 25px;
    left: 50px;
    z-index: 40;
    font-family: monospace, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-primary, #111111);
    display: flex;
    align-items: center;
    will-change: transform, opacity;
    visibility: hidden;
  }

  #clock-canvas {
    width: 160px;
    height: 24px;
    display: block;
  }

  .logo-center-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 380px;
    height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    pointer-events: none;
    will-change: transform, top, left;
    visibility: hidden;
  }

  .hero-frame {
    position: absolute;
    top: 15%;
    left: 12%;
    width: 76vw;
    height: 70vh;
    z-index: 20;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    transform-origin: center center;
    will-change: transform, opacity;
    backface-visibility: hidden;
    opacity: 0;
  }

  .logo-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .slide-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    will-change: transform, opacity;
  }

  .slide-img.active {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .logo-center-wrapper {
      width: 340px;
      height: 340px;
    }

    .hero-frame {
      top: 230px;
      left: 0;
      width: 100vw;
      height: 38vh;
      box-shadow: none;
      border-radius: 0;
    }

    .text-facet {
      top: 185px;
      left: 15px;
      font-size: clamp(1.3rem, 5vw, 1.9rem);
      font-weight: 900;
      -webkit-text-stroke: 0.8px #111111;
    }

    .text-architecture {
      position: absolute;
      top: 185px;
      left: calc(15px + 5.2em);
      bottom: auto;
      right: auto;
      font-size: clamp(1.3rem, 5vw, 1.9rem);
      font-weight: 900;
      -webkit-text-stroke: 0.8px #111111;
    }

    .hero-clock {
      bottom: 30px;
      left: 15px;
      font-size: 0.85rem;
    }
  }
</style>