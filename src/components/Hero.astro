---
import { Image, getImage } from 'astro:assets';
import heroLogoImg from '../assets/facet-logo-white.avif';

// Import showcase images
import resHeroImg from '../assets/res-eoa-1597.avif';
import resBlannImg from '../assets/res-blann.avif';
import ascotManorImg from '../assets/dev-ascot-manor.avif';
import intStarckImg from '../assets/int-starck.avif';

const heroImages = [resHeroImg, resBlannImg, ascotManorImg, intStarckImg];

const optimizedHero = await getImage({ src: resHeroImg, format: 'webp', width: 720, height: 480, quality: 100 });
---

<!-- Preload main initial image -->
<link rel="preload" as="image" href={optimizedHero.src} type="image/webp" fetchpriority="high" />

<section id="hero-stage" class="stage-container">
  <h2 class="lcp-seo-anchor" fetchpriority="high">FACET ARCHITECTURE PORTFOLIO SHOWCASE GAUTENG</h2>

  <!-- Fullscreen Container for Ken Burns Slides -->
  <div id="fullscreen-bg" class="fullscreen-bg">
    {heroImages.map((img, index) => (
      <Image 
        src={img} 
        alt={`Facet Architecture Showcase ${index + 1}`} 
        class={`hero-img slide-img ${index === 0 ? 'active' : ''}`}
        widths={[720, 1280, 1920, 2560, 3840]}
        sizes="100vw"
        format="avif"
        quality={100}
        loading={index === 0 ? "eager" : "lazy"}
        fetchpriority={index === 0 ? "high" : "low"}
        decoding="async"
      />
    ))}
  </div>

  <div id="hero-frame" class="hero-frame">
    <!-- Initial Intro Focal Frame -->
    <Image 
      src={resHeroImg} 
      alt="Facet Architecture Initial Hero" 
      class="hero-img intro-frame-img"
      widths={[720, 1280, 1920]}
      sizes="76vw"
      format="avif"
      quality={100}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>

  <div class="mobile-text-wrapper">
    <h1 id="text-facet" class="title-text text-facet">FACET</h1>
    <h1 id="text-architecture" class="title-text text-architecture">ARCHITECTURE</h1>
  </div>

  <div id="hero-clock" class="hero-clock">
    <canvas id="clock-canvas" width="160" height="24" aria-hidden="true"></canvas>
  </div>

  <div id="logo-center" class="logo-center-wrapper" role="img" aria-label="Facet Architecture Logo">
    <canvas
      id="logo-canvas"
      class="logo-canvas"
      width="760"
      height="760"
      data-logo-src={heroLogoImg.src}
      aria-hidden="true"
    ></canvas>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function initHero() {
    // Force GPU Acceleration globally in GSAP
    gsap.config({ force3D: true });

    // 1. Canvas Logo Render Engine
    const logoCanvas = document.getElementById('logo-canvas') as HTMLCanvasElement | null;
    if (logoCanvas) {
      const ctx = logoCanvas.getContext('2d');
      const src = logoCanvas.getAttribute('data-logo-src');
      if (ctx && src) {
        const dpr = window.devicePixelRatio || 1;
        const displaySize = 430;
        
        logoCanvas.width = displaySize * dpr;
        logoCanvas.height = displaySize * dpr;

        const logoImage = new Image();
        logoImage.onload = () => {
          ctx.save();
          ctx.scale(dpr, dpr);
          ctx.imageSmoothingEnabled = true;
          ctx.imageSmoothingQuality = 'high';
          ctx.clearRect(0, 0, displaySize, displaySize);
          ctx.drawImage(logoImage, 0, 0, displaySize, displaySize);
          ctx.restore();
        };
        logoImage.src = src;
      }
    }

    // 2. Real-time SAST Clock
    const clockCanvas = document.getElementById('clock-canvas') as HTMLCanvasElement | null;
    if (clockCanvas) {
      const updateClock = () => {
        const ctx = clockCanvas.getContext('2d');
        if (!ctx) return;

        const now = new Date();
        const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
        const sastTime = new Date(utc + (3600000 * 2));

        const hours = String(sastTime.getHours()).padStart(2, '0');
        const minutes = String(sastTime.getMinutes()).padStart(2, '0');
        const seconds = String(sastTime.getSeconds()).padStart(2, '0');
        const timeStr = `${hours}:${minutes}:${seconds} SAST`;

        const dpr = window.devicePixelRatio || 1;
        if (clockCanvas.width !== 160 * dpr) {
          clockCanvas.width = 160 * dpr;
          clockCanvas.height = 24 * dpr;
        }

        ctx.save();
        ctx.scale(dpr, dpr);
        ctx.clearRect(0, 0, 160, 24);
        ctx.font = '700 15px monospace, sans-serif';
        ctx.fillStyle = '#111111';
        ctx.textBaseline = 'middle';
        ctx.fillText(timeStr, 0, 12);
        ctx.restore();
      };

      updateClock();
      setInterval(updateClock, 1000);
    }

    // 3. Smooth Fullscreen Ken Burns + Sideways Pan Carousel
    function startKenBurnsCarousel() {
      const fullscreenBg = document.getElementById('fullscreen-bg');
      const heroFrame = document.getElementById('hero-frame');
      const slides = document.querySelectorAll('.slide-img');

      if (!fullscreenBg || !heroFrame || slides.length === 0) return;

      gsap.to(fullscreenBg, {
        opacity: 1,
        duration: 1.5,
        ease: 'power2.inOut'
      });

      gsap.to(heroFrame, {
        opacity: 0,
        duration: 1.2,
        ease: 'power2.inOut'
      });

      let current = 0;
      
      const directions = [
        { xStart: -25, xEnd: 25, scaleStart: 1.05, scaleEnd: 1.18 },
        { xStart: 25, xEnd: -25, scaleStart: 1.18, scaleEnd: 1.05 },
        { xStart: -20, xEnd: 20, scaleStart: 1.08, scaleEnd: 1.20 },
        { xStart: 20, xEnd: -20, scaleStart: 1.15, scaleEnd: 1.05 }
      ];

      gsap.fromTo(slides[0], 
        { x: directions[0].xStart, scale: directions[0].scaleStart },
        { x: directions[0].xEnd, scale: directions[0].scaleEnd, duration: 7.5, ease: 'none', force3D: true }
      );

      setInterval(() => {
        const next = (current + 1) % slides.length;
        const dir = directions[next % directions.length];

        gsap.set(slides[next], { 
          opacity: 0, 
          x: dir.xStart, 
          scale: dir.scaleStart, 
          zIndex: 2 
        });
        gsap.set(slides[current], { zIndex: 1 });

        gsap.to(slides[next], {
          opacity: 1,
          duration: 2.0,
          ease: 'power2.inOut',
          force3D: true
        });

        gsap.to(slides[next], {
          x: dir.xEnd,
          scale: dir.scaleEnd,
          duration: 7.5,
          ease: 'none',
          force3D: true
        });

        gsap.to(slides[current], {
          opacity: 0,
          duration: 2.0,
          ease: 'power2.inOut',
          force3D: true
        });

        current = next;
      }, 5800);
    }

    // 4. Primary GSAP Intro Sequence
    const logoCenter = document.getElementById('logo-center');
    const textFacet = document.getElementById('text-facet');
    const textArchitecture = document.getElementById('text-architecture');
    const clock = document.getElementById('hero-clock');
    const heroFrame = document.getElementById('hero-frame');

    if (!logoCenter || !textFacet || !textArchitecture || !clock || !heroFrame) return;

    const isMobile = window.innerWidth <= 768;

    if (isMobile) {
      // Mobile setup: Logo starts strictly in center screen
      gsap.set(logoCenter, { 
        top: '50%', 
        left: '50%', 
        xPercent: -50, 
        yPercent: -50, 
        scale: 0.75 
      });

      gsap.set(heroFrame, { opacity: 0, scale: 0.1, transformOrigin: 'center center' });
      gsap.set([textFacet, textArchitecture], { opacity: 0, y: 10 });
      gsap.set(clock, { opacity: 0, y: 15 });

      logoCenter.style.visibility = 'visible';
      heroFrame.style.visibility = 'visible';
      textFacet.style.visibility = 'visible';
      textArchitecture.style.visibility = 'visible';
      clock.style.visibility = 'visible';

      const tl = gsap.timeline({ 
        defaults: { ease: 'power3.inOut' },
        onComplete: startKenBurnsCarousel
      });

      // Animate logo to TOP RIGHT corner and slightly lower (~115px down)
      tl.to(logoCenter, {
          top: '115px',
          left: 'calc(100vw - 75px)',
          xPercent: -50,
          yPercent: -50,
          scale: 0.32,
          duration: 1.3,
          delay: 1.8
        })
        .to([textFacet, textArchitecture], {
          opacity: 1,
          y: 0,
          duration: 1.0,
          ease: 'power4.out'
        }, '-=0.5')
        .to(clock, {
          opacity: 1,
          y: 0,
          duration: 0.5
        }, '-=0.4')
        .to(heroFrame, {
          opacity: 1,
          scale: 1,
          duration: 1.2,
          ease: 'power4.out'
        }, '-=0.6');

    } else {
      /* DESKTOP BRANCH */
      const frameBounds = heroFrame.getBoundingClientRect();
      const startX = window.innerWidth / 2;
      const startY = window.innerHeight / 2;

      gsap.set(heroFrame, { opacity: 0, scale: 0.1, transformOrigin: 'center center' });
      gsap.set(textFacet, { opacity: 0, x: startX, y: startY, xPercent: -50, yPercent: -50 }); 
      gsap.set(textArchitecture, { opacity: 0, x: startX, y: startY, xPercent: -50, yPercent: -50 });
      gsap.set(clock, { opacity: 0, y: 15 });

      logoCenter.style.visibility = 'visible';
      heroFrame.style.visibility = 'visible';
      textFacet.style.visibility = 'visible';
      textArchitecture.style.visibility = 'visible';
      clock.style.visibility = 'visible';

      const facetWidth = textFacet.offsetWidth;
      const architectureX = frameBounds.left + facetWidth + 20;

      const targetY = Math.max(frameBounds.top - 45, 145);

      const tl = gsap.timeline({ 
        defaults: { ease: 'power3.inOut' },
        onComplete: startKenBurnsCarousel 
      });

      tl.to(logoCenter, {
        top: '90px',
        left: '100vw', 
        xPercent: -90, 
        x: 130,
        yPercent: 0,
        y: 0,
        scale: 0.55,
        transformOrigin: 'top left',
        duration: 1.3,
        ease: 'power2.inOut',
        delay: 1.8
      })
        .to(textFacet, {
          opacity: 1,
          x: frameBounds.left, 
          y: targetY,
          xPercent: 0,
          yPercent: 0,
          duration: 1.1,
          ease: 'power4.out'
        }, '-=0.5')
        .to(textArchitecture, {
          opacity: 1,
          x: architectureX,
          y: targetY,
          xPercent: 0,
          yPercent: 0,
          duration: 1.1,
          ease: 'power4.out'
        }, '<')
        .to(clock, {
          opacity: 1,
          y: 0,
          duration: 0.5
        }, '-=0.4')
        .to(heroFrame, {
          opacity: 1,
          scale: 1,
          duration: 1.2,
          ease: 'power4.out'
        }, '-=0.6');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>

<style>
  /* Base Navigation Overlay Styles */
  .menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(17, 17, 17, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 999999;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .menu-overlay.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .menu-content {
    text-align: center;
  }

  .menu-nav {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .menu-nav a {
    font-family: 'Bank Gothic', sans-serif, system-ui;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 900;
    color: #ffffff;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .menu-nav a:hover {
    color: #00E5FF;
    transform: translateY(-2px);
  }

  .lcp-seo-anchor {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 12px;
    color: transparent;
    background: transparent;
    user-select: none;
    pointer-events: none;
    margin: 0;
    padding: 0;
    z-index: 1;
    width: 200px;
    height: 20px;
    overflow: hidden;
  }

  .stage-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-concrete, #BEBEBE);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 10;
  }

  .fullscreen-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 5;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .text-facet,
  .text-architecture {
    position: absolute;
    top: 0;
    left: 0;
    font-family: 'Bank Gothic', sans-serif !important;
    font-weight: 900;
    font-size: clamp(2.2rem, 3.8vw, 4.1rem);
    letter-spacing: 0.10em;
    color: var(--text-primary, #111111);
    margin: 0;
    line-height: 1;
    z-index: 40;
    text-transform: uppercase;
    white-space: nowrap;
    will-change: transform, opacity;
    visibility: hidden;
  }

  .hero-clock {
    position: absolute;
    bottom: 25px;
    left: 50px;
    z-index: 40;
    font-family: monospace, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-primary, #111111);
    display: flex;
    align-items: center;
    will-change: transform, opacity;
    visibility: hidden;
  }

  #clock-canvas {
    width: 160px;
    height: 24px;
    display: block;
  }

  .logo-center-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 430px;
    height: 430px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    pointer-events: none;
    will-change: transform, top, left;
    visibility: hidden;
  }

  .hero-frame {
    position: absolute;
    top: 18%;
    left: 12%;
    width: 76vw;
    height: 67vh;
    z-index: 20;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    transform-origin: center center;
    will-change: transform, opacity;
    backface-visibility: hidden;
    opacity: 0;
  }

  .logo-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .intro-frame-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide-img {
    position: absolute;
    top: -5%;
    left: -5%;
    width: 110vw;
    height: 110vh;
    object-fit: cover;
    display: block;
    opacity: 0;
    will-change: transform, opacity;
    backface-visibility: hidden;
    transform-style: preserve-3d;
  }

  .slide-img.active {
    opacity: 1;
  }

  .mobile-text-wrapper {
    display: contents;
  }

  @media (max-width: 768px) {
    .logo-center-wrapper {
      width: 280px;
      height: 280px;
    }

    .hero-frame {
      top: 190px;
      left: 0;
      width: 100vw;
      height: 45vh;
      box-shadow: none;
      border-radius: 0;
    }

    .mobile-text-wrapper {
      position: absolute;
      top: 75px;
      left: 15px;
      z-index: 50;
      display: flex;
      flex-direction: row;
      gap: 8px;
    }

    .text-facet,
    .text-architecture {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      font-size: clamp(1.1rem, 4.2vw, 1.6rem) !important;
      font-weight: 900;
      color: #111111;
      line-height: 1;
      visibility: visible;
    }

    .hero-clock {
      bottom: 20px;
      left: 15px;
      font-size: 0.85rem;
    }
  }
</style>