---
import { Image } from 'astro:assets';
import logoImg from '../assets/facet-logo-white.avif';

const { pathname } = Astro.url;
const currentPath = pathname.replace(/\/$/, '') || '/';

const navItems = [
  { name: 'HOME', href: '/' },
  { name: 'PORTFOLIO', href: '/portfolio' },
  { name: 'ABOUT', href: '/about' },
  { name: 'CONTACT', href: '/contact' },
];

const socialLinks = [
  { 
    name: 'Facebook', 
    href: 'https://www.facebook.com/facetarchitecture',
    icon: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z'
  },
  { 
    name: 'Instagram', 
    href: 'https://www.instagram.com/facetarchitecture_za?igsh=YTF3MjJmOW92cW5y&utm_source=qr',
    rect: true,
    circle: true,
    path: 'M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z'
  },
  { 
    name: 'LinkedIn', 
    href: 'https://www.linkedin.com/in/warren-green-a5674927',
    icon: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z M2 9h4v12H2z',
    dot: true
  },
];
---

<header class="site-header">
  <div class="header-inner">
    <!-- Top Left Logo Container -->
    <a href="/" class="logo-link" aria-label="Facet Architecture Home">
    <Image 
  src={logoImg} 
  alt="Facet Architecture Logo" 
  class="site-logo"
  width={175} 
  height={175} 
  format="avif"
  quality={80}
  loading="eager"
  fetchpriority="high"
  decoding="async"
/>
    </a>

    <!-- Desktop Navigation Links (Centered) -->
    <nav class="desktop-nav">
      {navItems.map((item) => {
        const isActive = (item.href === '/' && currentPath === '/') || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a href={item.href} class={`nav-link ${isActive ? 'active' : ''}`}>
            <span class="nav-text">{item.name}</span>
            <span class="nav-underline"></span>
          </a>
        );
      })}
    </nav>

    <!-- Social Media SVG Icons Row (Right on Desktop / Centered on Mobile) -->
    <div class="header-socials">
      {socialLinks.map((social) => (
        <a 
          href={social.href} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="social-icon-link"
          aria-label={`Facet Architecture ${social.name}`}
        >
          {social.name === 'Facebook' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="social-svg">
              <path d={social.icon}></path>
            </svg>
          )}

          {social.name === 'Instagram' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="social-svg">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d={social.path}></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          )}

          {social.name === 'LinkedIn' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="social-svg">
              <path d={social.icon}></path>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          )}
        </a>
      ))}
    </div>

    <!-- Mobile Menu Toggle Button (Mobile Only) -->
    <button id="menu-toggle" class="mobile-toggle" aria-label="Toggle Navigation Menu" aria-expanded="false">
      <span class="line line-1"></span>
      <span class="line line-2"></span>
      <span class="line line-3"></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    z-index: 2147483646 !important;
    background-color: #2e343b; /* Charcoal grey */
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-sizing: border-box;
    pointer-events: auto !important;
  }

  .header-inner {
    width: 100%;
    margin: 0 auto;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 80px 0 40px; /* 80px padding on the right edge for desktop */
    box-sizing: border-box;
    position: relative;
  }

  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    height: 100%;
    z-index: 10;
  }

  .logo-link:hover {
    transform: scale(1.02);
  }

  .site-logo {
    height: 120px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  /* Desktop Nav Links Row - Centered */
  .desktop-nav {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: clamp(24px, 3.5vw, 52px);
    z-index: 5;
  }

  .nav-link {
    position: relative;
    text-decoration: none;
    padding: 8px 0;
  }

  .nav-text {
    font-family: 'Bank Gothic', 'BankGothic', sans-serif, system-ui;
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    color: #ffffff;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .nav-link:hover .nav-text,
  .nav-link.active .nav-text {
    color: #00ffc8;
  }

  .nav-underline {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #00ffc8;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .nav-link:hover .nav-underline,
  .nav-link.active .nav-underline {
    transform: scaleX(1);
    transform-origin: left center;
  }

  /* Social Icons Display (Desktop Right) */
  .header-socials {
    display: flex;
    align-items: center;
    gap: 18px;
    z-index: 10;
  }

  .social-icon-link {
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: color 0.3s ease, transform 0.2s ease;
  }

  .social-svg {
    width: 22px;
    height: 22px;
  }

  .social-icon-link:hover {
    color: #00ffc8;
    transform: translateY(-2px);
  }

  /* Mobile Toggle Button (Hidden on Desktop) */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 32px;
    height: 22px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 2147483647 !important;
    pointer-events: auto !important;
  }

  .line {
    width: 100%;
    height: 2px;
    background-color: #ffffff;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  /* Mobile Breakpoint Adjustments (b.png) */
  @media (max-width: 899px) {
    .header-inner {
      padding: 0 20px;
      height: 90px;
    }

    .site-logo {
      height: 100px;
    }

    .desktop-nav {
      display: none; /* Hide center menu text links on mobile */
    }

    .header-socials {
      position: absolute;
      left: 50%;
      transform: translateX(-50%); /* Perfectly centered social icons on mobile */
      gap: 16px;
    }

    .social-svg {
      width: 20px;
      height: 20px;
    }

    .mobile-toggle {
      display: flex; /* Show Hamburger Icon on Mobile */
    }

    .mobile-toggle[aria-expanded="true"] .line-1 {
      transform: translateY(10px) rotate(45deg);
    }

    .mobile-toggle[aria-expanded="true"] .line-2 {
      opacity: 0;
    }

    .mobile-toggle[aria-expanded="true"] .line-3 {
      transform: translateY(-10px) rotate(-45deg);
    }
  }
</style>

<script>
  function initHeaderToggle() {
    const toggleBtn = document.getElementById('menu-toggle');
    const overlay = document.getElementById('menu-overlay');

    if (!toggleBtn) return;

    toggleBtn.onclick = (e) => {
      e.preventDefault();
      e.stopPropagation();

      const overlayEl = overlay || document.getElementById('menu-overlay');
      if (overlayEl) {
        const isActive = overlayEl.classList.contains('active');
        if (isActive) {
          overlayEl.classList.remove('active');
          toggleBtn.setAttribute('aria-expanded', 'false');
          document.body.classList.remove('menu-open');
          document.body.style.overflow = '';
        } else {
          overlayEl.classList.add('active');
          toggleBtn.setAttribute('aria-expanded', 'true');
          document.body.classList.add('menu-open');
          document.body.style.overflow = 'hidden';
        }
      }
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderToggle);
  } else {
    initHeaderToggle();
  }

  document.addEventListener('astro:page-load', initHeaderToggle);
</script>