---
/* Header.astro - Dynamic Image Import */
import { Image } from 'astro:assets';
import MenuOverlay from './MenuOverlay.astro';

// Dynamically import all images from src/assets/
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{jpeg,jpg,png,gif,avif,webp}');

const logoPath = '../assets/facet-logo-white.avif';
if (!images[logoPath]) {
  throw new Error(`"${logoPath}" does not exist in "src/assets/". Check path or filename.`);
}

const { pathname } = Astro.url;
const isDarkPage = ['/portfolio', '/about', '/contact'].some((path) => pathname.includes(path));
---

<header class="site-header">
  <!-- Brand Logo -->
  <a href="/" class="logo-link" aria-label="Facet Architecture Home">
    <Image 
      src={images[logoPath]()} 
      alt="Facet Architecture Logo" 
      class={`site-logo ${isDarkPage ? 'invert-dark' : ''}`}
      loading="eager"
      decoding="sync"
    />
  </a>

  <!-- Menu Box Container -->
  <button 
    id="menu-toggle" 
    class="menu-box" 
    aria-label="Toggle Navigation Menu" 
    aria-expanded="false"
  >
    <div class="hamburger-lines">
      <span class="line line-1"></span>
      <span class="line line-2"></span>
      <span class="line line-3"></span>
    </div>
  </button>

  <!-- Navigation Overlay Component -->
  <MenuOverlay />
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 980;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 32px;
    box-sizing: border-box;
    pointer-events: none;
  }

  .logo-link {
    pointer-events: auto;
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .site-logo {
    height: clamp(28px, 4vw, 40px);
    width: auto;
    display: block;
    transition: filter 0.3s ease, transform 0.3s ease;
  }

  .site-logo:hover {
    transform: scale(1.02);
  }

  /* Optional invert rule if you need to turn white logo dark on light pages */
  .site-logo.invert-dark {
    filter: brightness(0);
  }

  .menu-box {
    pointer-events: auto;
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1000;
    width: 64px;
    height: 72px;
    background-color: #7c7a7a;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
    transition: background-color 0.3s ease;
  }

  .hamburger-lines {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    width: 28px;
    height: 18px;
  }

  .line {
    width: 100%;
    height: 2px;
    background-color: #000000;
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.3s ease;
    transform-origin: center;
  }

  .menu-box[aria-expanded="true"] .line-1 {
    transform: translateY(8px) rotate(45deg);
  }

  .menu-box[aria-expanded="true"] .line-2 {
    opacity: 0;
  }

  .menu-box[aria-expanded="true"] .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .site-header {
      padding: 16px 20px;
    }

    .menu-box {
      width: 52px;
      height: 60px;
    }

    .hamburger-lines {
      width: 24px;
      height: 16px;
    }

    .menu-box[aria-expanded="true"] .line-1 {
      transform: translateY(7px) rotate(45deg);
    }

    .menu-box[aria-expanded="true"] .line-3 {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>

<script>
  function setupMenu() {
    const toggleBtn = document.getElementById('menu-toggle');
    const overlay = document.getElementById('menu-overlay');

    if (!toggleBtn || !overlay) return;

    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      overlay.classList.toggle('active');

      document.body.classList.toggle('menu-open', !isExpanded);
    });
  }

  setupMenu();
  document.addEventListener('astro:page-load', setupMenu);
</script>