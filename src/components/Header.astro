---
import { Image } from 'astro:assets';
import logoImg from '../assets/facet-logo-white.avif';

const { pathname } = Astro.url;
const currentPath = pathname.replace(/\/$/, '') || '/';

const navItems = [
  { name: 'HOME', href: '/' },
  { name: 'PORTFOLIO', href: '/portfolio' },
  { name: 'ABOUT', href: '/about' },
  { name: 'CONTACT', href: '/contact' },
];
---

<header class="site-header">
  <div class="header-inner">
    <!-- Top Left Logo -->
    <a href="/" class="logo-link" aria-label="Facet Architecture Home">
      <Image 
        src={logoImg} 
        alt="Facet Architecture Logo" 
        class="site-logo"
        width={320}
        height={100}
        loading="eager"
        decoding="sync"
      />
    </a>

    <!-- Top Right Nav Row (Desktop) -->
    <nav class="desktop-nav">
      {navItems.map((item) => {
        const isActive = (item.href === '/' && currentPath === '/') || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a href={item.href} class={`nav-link ${isActive ? 'active' : ''}`}>
            <span class="nav-text">{item.name}</span>
            <span class="nav-underline"></span>
          </a>
        );
      })}
    </nav>

    <!-- Mobile Menu Toggle Button -->
    <button id="menu-toggle" class="mobile-toggle" aria-label="Toggle Navigation Menu" aria-expanded="false">
      <span class="line line-1"></span>
      <span class="line line-2"></span>
      <span class="line line-3"></span>
    </button>
  </div>

  <!-- Mobile Dropdown Drawer -->
  <div id="mobile-menu" class="mobile-menu-drawer">
    <nav class="mobile-nav-list">
      {navItems.map((item) => {
        const isActive = (item.href === '/' && currentPath === '/') || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a href={item.href} class={`mobile-nav-link ${isActive ? 'active' : ''}`}>
            {item.name}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    z-index: 2147483646;
    background-color: #2e343b; /* Charcoal grey */
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-sizing: border-box;
  }

  /* Expanded height to prevent logo clipping & increase menu bar size */
  .header-inner {
    max-width: 1800px;
    margin: 0 auto;
    height: 110px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
    box-sizing: border-box;
  }

  /* Top Left Logo Container */
  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: transform 0.3s ease;
    overflow: visible;
  }

  .logo-link:hover {
    transform: scale(1.02);
  }

  .site-logo {
    height: clamp(55px, 5.5vw, 75px);
    width: auto;
    display: block;
    object-fit: contain;
  }

  /* Desktop Top Menu Row */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(24px, 3.5vw, 52px);
  }

  .nav-link {
    position: relative;
    text-decoration: none;
    padding: 8px 0;
  }

  .nav-text {
    font-family: 'Bank Gothic', 'BankGothic', sans-serif, system-ui;
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    color: #ffffff;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .nav-link:hover .nav-text,
  .nav-link.active .nav-text {
    color: #00ffc8;
  }

  .nav-underline {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #00ffc8;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .nav-link:hover .nav-underline,
  .nav-link.active .nav-underline {
    transform: scaleX(1);
    transform-origin: left center;
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 32px;
    height: 22px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 10;
  }

  .line {
    width: 100%;
    height: 2px;
    background-color: #ffffff;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  /* Mobile Drawer */
  .mobile-menu-drawer {
    display: none;
    position: fixed;
    top: 110px;
    left: 0;
    width: 100vw;
    height: calc(100vh - 110px);
    background-color: #2e343b;
    padding: 40px 32px;
    box-sizing: border-box;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .mobile-menu-drawer.open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .mobile-nav-link {
    font-family: 'Bank Gothic', 'BankGothic', sans-serif, system-ui;
    font-size: 1.8rem;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: 2px;
    transition: color 0.3s ease;
  }

  .mobile-nav-link.active,
  .mobile-nav-link:hover {
    color: #00ffc8;
  }

  @media (max-width: 899px) {
    .header-inner {
      padding: 0 20px;
      height: 80px;
    }

    .site-logo {
      height: 48px;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .mobile-menu-drawer {
      display: block;
      top: 80px;
      height: calc(100vh - 80px);
    }

    .mobile-toggle[aria-expanded="true"] .line-1 {
      transform: translateY(10px) rotate(45deg);
    }

    .mobile-toggle[aria-expanded="true"] .line-2 {
      opacity: 0;
    }

    .mobile-toggle[aria-expanded="true"] .line-3 {
      transform: translateY(-10px) rotate(-45deg);
    }
  }
</style>

<script>
  function initHeader() {
    const toggleBtn = document.getElementById('menu-toggle');
    const drawer = document.getElementById('mobile-menu');

    if (!toggleBtn || !drawer) return;

    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      drawer.classList.toggle('open', !isExpanded);
      document.body.style.overflow = !isExpanded ? 'hidden' : '';
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }

  document.addEventListener('astro:page-load', initHeader);
</script>