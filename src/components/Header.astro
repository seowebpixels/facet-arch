---
import { Image } from 'astro:assets';
import logoImg from '../assets/facet-logo-white.avif';

const { pathname } = Astro.url;
const currentPath = pathname.replace(/\/$/, '') || '/';

const navItems = [
  { name: 'HOME', href: '/' },
  { name: 'PORTFOLIO', href: '/portfolio' },
  { name: 'ABOUT', href: '/about' },
  { name: 'CONTACT', href: '/contact' },
];
---

<header class="site-header">
  <div class="header-inner">
    <!-- Top Left Logo Container -->
    <a href="/" class="logo-link" aria-label="Facet Architecture Home">
      <Image 
        src={logoImg} 
        alt="Facet Architecture Logo" 
        class="site-logo"
        loading="eager"
        decoding="sync"
      />
    </a>

    <!-- Top Right Nav Row (Desktop) -->
    <nav class="desktop-nav">
      {navItems.map((item) => {
        const isActive = (item.href === '/' && currentPath === '/') || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a href={item.href} class={`nav-link ${isActive ? 'active' : ''}`}>
            <span class="nav-text">{item.name}</span>
            <span class="nav-underline"></span>
          </a>
        );
      })}
    </nav>

    <!-- Mobile Menu Toggle Button -->
    <button id="menu-toggle" class="mobile-toggle" aria-label="Toggle Navigation Menu" aria-expanded="false">
      <span class="line line-1"></span>
      <span class="line line-2"></span>
      <span class="line line-3"></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    z-index: 2147483646 !important;
    background-color: #2e343b; /* Charcoal grey */
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-sizing: border-box;
    pointer-events: auto !important;
  }

  .header-inner {
    max-width: 1800px;
    margin: 0 auto;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
    box-sizing: border-box;
  }

  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    height: 100%;
    overflow: visible;
  }

  .logo-link:hover {
    transform: scale(1.02);
  }

  .site-logo {
    height: 175px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  /* Desktop Top Menu Row */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(24px, 3.5vw, 52px);
  }

  .nav-link {
    position: relative;
    text-decoration: none;
    padding: 8px 0;
  }

  .nav-text {
    font-family: 'Bank Gothic', 'BankGothic', sans-serif, system-ui;
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    color: #ffffff;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .nav-link:hover .nav-text,
  .nav-link.active .nav-text {
    color: #00ffc8;
  }

  .nav-underline {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #00ffc8;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .nav-link:hover .nav-underline,
  .nav-link.active .nav-underline {
    transform: scaleX(1);
    transform-origin: left center;
  }

  /* Mobile Toggle Button */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 32px;
    height: 22px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 2147483647 !important;
    pointer-events: auto !important;
  }

  .line {
    width: 100%;
    height: 2px;
    background-color: #ffffff;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  @media (max-width: 899px) {
    .header-inner {
      padding: 0 20px;
      height: 90px;
    }

    .site-logo {
      height: 45px;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .mobile-toggle[aria-expanded="true"] .line-1 {
      transform: translateY(10px) rotate(45deg);
    }

    .mobile-toggle[aria-expanded="true"] .line-2 {
      opacity: 0;
    }

    .mobile-toggle[aria-expanded="true"] .line-3 {
      transform: translateY(-10px) rotate(-45deg);
    }
  }
</style>

<script>
  function initHeaderToggle() {
    const toggleBtn = document.getElementById('menu-toggle');
    const overlay = document.getElementById('menu-overlay');

    if (!toggleBtn) return;

    toggleBtn.onclick = (e) => {
      e.preventDefault();
      e.stopPropagation();

      const overlayEl = overlay || document.getElementById('menu-overlay');
      if (overlayEl) {
        const isActive = overlayEl.classList.contains('active');
        if (isActive) {
          overlayEl.classList.remove('active');
          toggleBtn.setAttribute('aria-expanded', 'false');
          document.body.classList.remove('menu-open');
          document.body.style.overflow = '';
        } else {
          overlayEl.classList.add('active');
          toggleBtn.setAttribute('aria-expanded', 'true');
          document.body.classList.add('menu-open');
          document.body.style.overflow = 'hidden';
        }
      }
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderToggle);
  } else {
    initHeaderToggle();
  }

  document.addEventListener('astro:page-load', initHeaderToggle);
</script>