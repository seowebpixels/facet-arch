---
/* src/components/Header.astro */
import { Image } from 'astro:assets';
import MenuOverlay from './MenuOverlay.astro';
import logoImg from '../assets/facet-logo-white.avif';

const { pathname } = Astro.url;

// Check current page route
const isHomePage = pathname === '/' || pathname === '';
const showLogoPages = ['/portfolio', '/about', '/contact'].some((path) => pathname.includes(path));
const shouldShowLogo = !isHomePage && showLogoPages;
---

<header class="site-header">
  {shouldShowLogo && (
    <a href="/" class="logo-link" aria-label="Facet Architecture Home">
      <Image 
        src={logoImg} 
        alt="Facet Architecture Logo" 
        class="site-logo"
        loading="eager"
        decoding="sync"
      />
    </a>
  )}

  <button 
    id="menu-toggle" 
    class="menu-box" 
    aria-label="Toggle Navigation Menu" 
    aria-expanded="false"
  >
    <div class="hamburger-lines">
      <span class="line line-1"></span>
      <span class="line line-2"></span>
      <span class="line line-3"></span>
    </div>
  </button>

  <MenuOverlay />
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding: 24px 32px;
    box-sizing: border-box;
    pointer-events: none; /* Allows clicks through empty areas of header */
  }

  /* Ensure interactive children explicitly capture clicks */
  .logo-link,
  .menu-box {
    pointer-events: auto !important;
  }

  .logo-link {
    position: fixed;
    top: -16px;
    right: 20px;
    z-index: 1001;
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .site-logo {
    height: clamp(125px, 14vw, 155px);
    width: auto;
    display: block;
    filter: none;
    transition: transform 0.3s ease;
  }

  .site-logo:hover {
    transform: scale(1.04);
  }

  .menu-box {
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1002; /* Stacked above menu overlay */
    width: 64px;
    height: 72px;
    background-color: #7c7a7a;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
    transition: background-color 0.3s ease;
  }

  .hamburger-lines {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    width: 28px;
    height: 18px;
    pointer-events: none;
  }

  .line {
    width: 100%;
    height: 2px;
    background-color: #000000;
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.3s ease;
    transform-origin: center;
  }

  .menu-box[aria-expanded="true"] .line-1 {
    transform: translateY(8px) rotate(45deg);
  }

  .menu-box[aria-expanded="true"] .line-2 {
    opacity: 0;
  }

  .menu-box[aria-expanded="true"] .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .site-header {
      padding: 16px 20px;
    }

    .logo-link {
      top: -18px;
      right: 15px;
    }

    .site-logo {
      height: clamp(115px, 16vw, 130px);
    }

    .menu-box {
      width: 52px;
      height: 60px;
    }

    .hamburger-lines {
      width: 24px;
      height: 16px;
    }

    .menu-box[aria-expanded="true"] .line-1 {
      transform: translateY(7px) rotate(45deg);
    }

    .menu-box[aria-expanded="true"] .line-3 {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>

<script>
  function setupMenu() {
    const toggleBtn = document.getElementById('menu-toggle');
    const overlay = document.getElementById('menu-overlay');

    if (!toggleBtn || !overlay) return;

    // Remove existing listener duplicates on view transitions
    const newToggleBtn = toggleBtn.cloneNode(true);
    toggleBtn.parentNode?.replaceChild(newToggleBtn, toggleBtn);

    newToggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = newToggleBtn.getAttribute('aria-expanded') === 'true';
      const nextState = !isExpanded;
      
      newToggleBtn.setAttribute('aria-expanded', nextState.toString());
      overlay.classList.toggle('active', nextState);
      document.body.classList.toggle('menu-open', nextState);
    });
  }

  setupMenu();
  document.addEventListener('astro:page-load', setupMenu);
</script>