---
/* Header.astro - Custom Hamburger Box & Menu Overlay Integration */
import MenuOverlay from './MenuOverlay.astro';
---

<header>
  <!-- Menu Box Container (Fixed Middle Right) -->
  <button 
    id="menu-toggle" 
    class="menu-box" 
    aria-label="Toggle Navigation Menu" 
    aria-expanded="false"
  >
    <div class="hamburger-lines">
      <span class="line line-1"></span>
      <span class="line line-2"></span>
      <span class="line line-3"></span>
    </div>
  </button>

  <!-- Navigation Overlay Component -->
  <MenuOverlay />
</header>

<style>
  /* ==========================================================================
     Menu Box (#7c7a7a background, 3 black lines perfectly centered)
     ========================================================================== */
  .menu-box {
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1000;
    width: 64px;
    height: 72px;
    background-color: #7c7a7a;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
    transition: background-color 0.3s ease;
  }

  .hamburger-lines {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    width: 28px;
    height: 18px;
  }

  .line {
    width: 100%;
    height: 2px;
    background-color: #000000;
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.3s ease;
    transform-origin: center;
  }

  /* Animated "X" state when menu is open */
  .menu-box[aria-expanded="true"] .line-1 {
    transform: translateY(8px) rotate(45deg);
  }

  .menu-box[aria-expanded="true"] .line-2 {
    opacity: 0;
  }

  .menu-box[aria-expanded="true"] .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Responsive positioning for mobile screens */
  @media (max-width: 768px) {
    .menu-box {
      width: 52px;
      height: 60px;
    }

    .hamburger-lines {
      width: 24px;
      height: 16px;
    }

    .menu-box[aria-expanded="true"] .line-1 {
      transform: translateY(7px) rotate(45deg);
    }

    .menu-box[aria-expanded="true"] .line-3 {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>

<script>
  function setupMenu() {
    const toggleBtn = document.getElementById('menu-toggle');
    const overlay = document.getElementById('menu-overlay');

    if (!toggleBtn || !overlay) return;

    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      overlay.classList.toggle('active');

      document.body.classList.toggle('menu-open', !isExpanded);
    });
  }

  setupMenu();
  document.addEventListener('astro:page-load', setupMenu);
</script>