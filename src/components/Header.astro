---
/* src/components/Header.astro */
import { Image } from 'astro:assets';
import MenuOverlay from './MenuOverlay.astro';
import logoImg from '../assets/facet-logo-white.avif';

const { pathname } = Astro.url;

const isHomePage = pathname === '/' || pathname === '';
const showLogoPages = ['/portfolio', '/about', '/contact'].some((path) => pathname.includes(path));
const shouldShowLogo = true;
---

<header class="site-header">
  {shouldShowLogo && (
    <a href="/" class="logo-link" aria-label="Facet Architecture Home">
      <Image 
        src={logoImg} 
        alt="Facet Architecture Logo" 
        class="site-logo"
        loading="eager"
        decoding="sync"
      />
    </a>
  )}

  <button 
    id="menu-toggle" 
    class="menu-box" 
    aria-label="Toggle Navigation Menu" 
    aria-expanded="false"
    onclick="
      const overlay = document.getElementById('menu-overlay');
      const isExpanded = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', (!isExpanded).toString());
      if (overlay) {
        overlay.classList.toggle('active', !isExpanded);
        document.body.classList.toggle('menu-open', !isExpanded);
      }
    "
  >
    <div class="hamburger-lines">
      <span class="line line-1"></span>
      <span class="line line-2"></span>
      <span class="line line-3"></span>
    </div>
  </button>
</header>

<MenuOverlay />

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 0;
    z-index: 2147483646;
    pointer-events: none;
  }

  /* Logo pinned to the RIGHT */
  .logo-link {
    pointer-events: auto !important;
    position: fixed;
    top: -41px;
    right: 20px;
    left: auto;
    z-index: 2147483647;
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .site-logo {
    height: clamp(125px, 14vw, 155px);
    width: auto;
    display: block;
    transition: transform 0.3s ease;
  }

  .site-logo:hover {
    transform: scale(1.04);
  }

  /* TOGGLE BOX: Fixed to the RIGHT at all times */
  .menu-box {
    pointer-events: auto !important;
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2147483647;
    width: 64px;
    height: 72px;
    background-color: #7c7a7a;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
  }

  .hamburger-lines {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    width: 28px;
    height: 18px;
    pointer-events: none;
  }

  .line {
    width: 100%;
    height: 2px;
    background-color: #000000;
    transition: transform 0.3s ease, opacity 0.3s ease;
    pointer-events: none;
  }

  /* MORPH TO 'X' IN PLACE WHEN ACTIVE */
  .menu-box[aria-expanded="true"] .line-1 {
    transform: translateY(8px) rotate(45deg);
  }

  .menu-box[aria-expanded="true"] .line-2 {
    opacity: 0;
  }

  .menu-box[aria-expanded="true"] .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .logo-link {
      right: 12px;
      top: -37px;
    }

    .menu-box {
      width: 52px;
      height: 60px;
    }

    .hamburger-lines {
      width: 24px;
      height: 16px;
    }

    .menu-box[aria-expanded="true"] .line-1 {
      transform: translateY(7px) rotate(45deg);
    }

    .menu-box[aria-expanded="true"] .line-3 {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>