---
const currentYear = new Date().getFullYear();
---

<!-- 1. Stats / Credentials Bar -->
<section class="home-footer-credentials" style="width: 100%; background-color: #2D3239; border-top: 1px solid rgba(255, 255, 255, 0.2); border-bottom: 1px solid rgba(255, 255, 255, 0.2); padding: 48px 24px; box-sizing: border-box;">
  <div style="max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px; text-align: left;">
    <div>
      <p style="font-size: 11px; font-family: monospace; letter-spacing: 0.2em; color: #FFFFFF; text-transform: uppercase; margin: 0; opacity: 0.9; font-weight: 700;">PRACTICE</p>
      <p style="font-size: 18px; font-weight: 400; color: #FFFFFF; text-transform: uppercase; letter-spacing: 0.05em; margin: 6px 0 0 0;">SACAP Registered</p>
    </div>
    <div>
      <p style="font-size: 11px; font-family: monospace; letter-spacing: 0.2em; color: #FFFFFF; text-transform: uppercase; margin: 0; opacity: 0.9; font-weight: 700;">SCOPE</p>
      <p style="font-size: 18px; font-weight: 400; color: #FFFFFF; text-transform: uppercase; letter-spacing: 0.05em; margin: 6px 0 0 0;">Turnkey Design</p>
    </div>
    <div>
      <p style="font-size: 11px; font-family: monospace; letter-spacing: 0.2em; color: #FFFFFF; text-transform: uppercase; margin: 0; opacity: 0.9; font-weight: 700;">DISCIPLINE</p>
      <p style="font-size: 18px; font-weight: 400; color: #FFFFFF; text-transform: uppercase; letter-spacing: 0.05em; margin: 6px 0 0 0;">Bespoke Architecture</p>
    </div>
    <div>
      <p style="font-size: 11px; font-family: monospace; letter-spacing: 0.2em; color: #FFFFFF; text-transform: uppercase; margin: 0; opacity: 0.9; font-weight: 700;">LOCATION</p>
      <p style="font-size: 18px; font-weight: 400; color: #FFFFFF; text-transform: uppercase; letter-spacing: 0.05em; margin: 6px 0 0 0;">South Africa</p>
    </div>
  </div>
</section>

<!-- 2. Studio Ethos / Practice Section -->
<section class="home-footer-practice" style="width: 100%; background-color: #2D3239; padding: 96px 24px; border-bottom: 1px solid rgba(255, 255, 255, 0.2); box-sizing: border-box;">
  <div style="max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 48px; align-items: start;">
    <div>
      <h2 style="font-size: 11px; font-family: monospace; color: #FFFFFF; letter-spacing: 0.3em; text-transform: uppercase; display: block; margin: 0; font-weight: 700;">THE PRACTICE</h2>
      <p style="font-size: 28px; font-weight: 400; color: #FFFFFF; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 16px; line-height: 1.3;">
        Precision Engineering Meets Spatial Harmony.
      </p>
    </div>

    <div style="display: flex; flex-direction: column; gap: 24px; color: #FFFFFF; font-weight: 400; line-height: 1.7; font-size: 16px;">
      <p style="margin: 0;">
        Facet Architecture operates at the intersection of structural form, environmental responsiveness, and refined interior aesthetics. Every project is approached as a site-specific dialogue between volume, material, and light.
      </p>
      <p style="margin: 0;">
        Our practice manages the full project lifecycle—from conceptual master planning and council submission through to detailed technical documentation and site administration.
      </p>
    </div>
  </div>
</section>

<!-- 3. High-Impact CTA & Footer Base -->
<footer class="home-footer-main" style="width: 100%; background-color: #111418; color: #FFFFFF; padding: 80px 24px; box-sizing: border-box;" role="contentinfo">
  <div style="max-width: 1280px; margin: 0 auto; display: flex; flex-direction: column; gap: 64px;">
    
    <!-- Big CTA Row -->
    <div class="cta-content" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px; padding-bottom: 64px; border-bottom: 1px solid rgba(255, 255, 255, 0.3);">
      <div class="cta-text">
        <span style="font-size: 11px; font-family: monospace; color: #FFFFFF; letter-spacing: 0.3em; text-transform: uppercase; display: block; font-weight: 700;">NEXT STEPS</span>
        <p class="cta-heading" style="font-size: 28px; font-weight: 500; color: #FFFFFF; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 16px; line-height: 1.3;">
          HAVE A PROJECT IN MIND?
        </p>
      </div>
      <div class="cta-action">
        <a 
          href="mailto:info@facetarch.co.za" 
          class="cta-btn"
          aria-label="Initiate consultation via email"
        >
          Initiate Consultation &rarr;
        </a>
      </div>
    </div>

    <!-- Copyright Base -->
    <div class="footer-base">
      <p class="footer-line copyright-line">&copy; {currentYear} FACET ARCHITECTURE</p>
      <p class="footer-line rights-line">ALL RIGHTS RESERVED</p>
      <p class="footer-line credits-line">
        DESIGNED BY&nbsp;<a 
          href="https://webdesignpros.co.za" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="wdp-link"
          aria-label="Designed by Web Design Pros (opens in a new tab)"
        >WEB DESIGN PROS</a>
      </p>
    </div>

  </div>
</footer>

<style is:global>
  .home-footer-main .cta-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-height: 44px !important;
    padding: 12px 32px !important;
    border: 2px solid #FFFFFF !important;
    color: #FFFFFF !important;
    font-size: 12px !important;
    font-family: monospace !important;
    letter-spacing: 0.25em !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    font-weight: 600 !important;
    background-color: transparent !important;
    transition: background-color 0.3s ease, color 0.3s ease, outline 0.2s ease !important;
  }

  .home-footer-main .cta-btn:hover,
  .home-footer-main .cta-btn:focus-visible {
    background-color: #FFFFFF !important;
    color: #000000 !important;
    outline: 3px solid #FFFFFF !important;
    outline-offset: 3px !important;
  }

  .home-footer-main .footer-base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    color: #FFFFFF !important;
    font-family: monospace;
    letter-spacing: 0.2em;
    gap: 16px;
    width: 100%;
    opacity: 1 !important;
  }

  .home-footer-main .footer-line {
    margin: 0;
    color: #FFFFFF !important;
  }

  .home-footer-main .wdp-link {
    display: inline-block;
    padding: 4px 2px;
    color: #FFFFFF !important;
    font-weight: 600 !important;
    text-decoration: underline !important;
    transition: color 0.2s ease, text-shadow 0.2s ease, outline 0.2s ease;
  }

  .home-footer-main .wdp-link:hover,
  .home-footer-main .wdp-link:focus-visible {
    color: #FFFFFF !important;
    text-shadow: 0 0 2px #FFFFFF;
    outline: 2px solid #FFFFFF !important;
    outline-offset: 2px !important;
  }

  @media (max-width: 899px) {
    .home-footer-main .cta-content {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 20px !important;
    }

    .home-footer-main .cta-text {
      width: 100% !important;
    }

    .home-footer-main .cta-heading {
      font-size: clamp(1rem, 4.8vw, 1.3rem) !important;
      white-space: nowrap !important;
      letter-spacing: 1.5px !important;
      line-height: 1.2 !important;
    }

    .home-footer-main .cta-action {
      width: 100% !important;
    }

    .home-footer-main .cta-btn {
      display: flex !important;
      width: 100% !important;
      text-align: center !important;
      box-sizing: border-box !important;
      padding: 12px 16px !important;
      font-size: 0.75rem !important;
      letter-spacing: 2px !important;
    }

    .home-footer-main .footer-base {
      flex-direction: column !important;
      align-items: center !important;
      text-align: center !important;
      gap: 8px !important;
    }

    .home-footer-main .footer-line {
      white-space: nowrap !important;
      line-height: 1.6 !important;
    }

    .home-footer-main .credits-line {
      margin-top: 0.5rem !important;
    }
  }
</style>