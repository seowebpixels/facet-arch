---
/* src/components/Clock.astro */
const { pathname } = Astro.url;

const isHomePage = pathname === '/' || pathname === '';
---

<div id="site-clock" class={`site-clock ${isHomePage ? 'home-clock' : 'inner-page-clock'}`}>
  <span id="clock-time">00:00:00 GMT+2</span>
</div>

<style>
  .site-clock {
    font-family: 'Bank Gothic', 'BankGothic', sans-serif, system-ui;
    font-size: 0.95rem;
    letter-spacing: 2px;
    z-index: 99;
    pointer-events: none;
    white-space: nowrap;
  }

  /* Inner pages (Portfolio, About, Contact): Absolute position so it scrolls up with the page */
  .inner-page-clock {
    position: absolute;
    top: 50px;
    left: 50px;
    color: #a0a6b0; /* Light Grey */
  }

  /* Home Page clock styling */
  .home-clock {
    position: absolute;
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .inner-page-clock {
      top: 24px;
      left: 20px;
      font-size: 0.8rem;
    }
  }
</style>

<script>
  function updateClock() {
    const clockEl = document.querySelectorAll('#clock-time, #overlay-clock-time');
    if (!clockEl.length) return;

    const now = new Date();
    
    const options: Intl.DateTimeFormatOptions = {
      timeZone: 'Africa/Johannesburg',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false
    };

    const timeString = new Intl.DateTimeFormat('en-GB', options).format(now);
    const fullClockText = `${timeString} GMT+2`;

    clockEl.forEach((el) => {
      el.textContent = fullClockText;
    });
  }

  updateClock();
  setInterval(updateClock, 1000);

  document.addEventListener('astro:page-load', updateClock);
</script>