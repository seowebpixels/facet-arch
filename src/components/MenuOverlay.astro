---
import logoImg from '../assets/facet-logo-white.avif';

interface Props {
  isOpen?: boolean;
}

const { isOpen = false } = Astro.props;

const menuItems = [
  { name: 'HOME', href: '/' },
  { name: 'PORTFOLIO', href: '/portfolio' },
  { name: 'ABOUT', href: '/about' },
  { name: 'CONTACT', href: '/contact' },
];
---

<div id="menu-overlay" class={`menu-overlay ${isOpen ? 'active' : ''}`}>
  <div class="menu-container">
    
    <a href="/" class="overlay-logo-link" aria-label="Facet Architecture Home">
      <img 
        src={logoImg.src} 
        alt="Facet Architecture Logo" 
        class="overlay-logo"
        width={logoImg.width || 300}
        height={logoImg.height || 300}
        loading="eager"
        decoding="sync"
      />
    </a>

    <nav class="menu-nav-list">
      {menuItems.map((item) => (
        <a href={item.href} class="menu-link" data-link={item.name} data-href={item.href}>
          <span class="menu-link-text">{item.name}</span>
          <span class="menu-link-underline"></span>
        </a>
      ))}
    </nav>

    <!-- Overlay Bottom Clock -->
    <div class="overlay-clock-container">
      <span id="overlay-clock-time" class="overlay-clock-text">00:00:00 GMT+2</span>
    </div>

  </div>
</div>

<style>
  :global(body.menu-open) {
    overflow: hidden !important;
    height: 100vh !important;
  }

  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 2147483640;
    background-color: #2e343b;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease, visibility 0.4s ease;
    visibility: hidden;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
  }

  .menu-overlay.active {
    opacity: 1 !important;
    pointer-events: auto !important;
    visibility: visible !important;
  }

  .menu-overlay.active * {
    pointer-events: auto !important;
  }

  .menu-overlay * {
    pointer-events: auto !important;
  }

  /* Centered Layout for Logo, Navigation Links, and Clock */
  .menu-container {
    width: 100%;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    box-sizing: border-box;
    padding: 20px;
  }

  /* Overlay White Logo */
  .overlay-logo-link {
    position: absolute;
    top: 30px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .overlay-logo {
    height: clamp(100px, 12vw, 140px);
    width: auto;
    display: block;
  }

  /* Navigation Links Stack */
  .menu-nav-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(20px, 4vh, 40px);
  }

  .menu-link {
    position: relative;
    display: inline-block;
    text-decoration: none;
    width: fit-content;
    padding-bottom: 6px;
  }

  .menu-link-text {
    font-family: 'Bank Gothic', 'BankGothic', sans-serif, system-ui;
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: #ffffff;
    letter-spacing: 3px;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .menu-link.selected .menu-link-text {
    color: #00ffc8;
  }

  .menu-link-underline {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: #00ffc8;
    transform-origin: right center;
    transform: scaleX(0);
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .menu-link:hover .menu-link-underline,
  .menu-link:active .menu-link-underline,
  .menu-link.holding .menu-link-underline {
    transform-origin: left center;
    transform: scaleX(1);
  }

  .menu-link:not(:hover):not(:active):not(.holding) .menu-link-underline {
    transform-origin: right center;
    transform: scaleX(0);
  }

  /* Menu Overlay Bottom Clock */
  .overlay-clock-container {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    width: 100%;
  }

  .overlay-clock-text {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: clamp(1rem, 1.8vw, 1.4rem);
    color: #ffffff;
    letter-spacing: 2px;
    opacity: 0.9;
  }
</style>

<script>
  function renderClockTime() {
    const clockEl = document.getElementById('overlay-clock-time');
    if (!clockEl) return;

    const now = new Date();
    const options: Intl.DateTimeFormatOptions = {
      timeZone: 'Africa/Johannesburg',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false
    };

    const timeString = new Intl.DateTimeFormat('en-GB', options).format(now);
    clockEl.textContent = `${timeString} GMT+2`;
  }

  function closeMenuOverlay() {
    const overlay = document.getElementById('menu-overlay');
    const heroBtn = document.getElementById('hero-hamburger');
    const headerBtn = document.getElementById('menu-toggle');

    if (overlay) overlay.classList.remove('active');
    if (heroBtn) heroBtn.setAttribute('aria-expanded', 'false');
    if (headerBtn) headerBtn.setAttribute('aria-expanded', 'false');

    document.body.classList.remove('menu-open');
    document.body.style.overflow = '';
  }

  function initMenuOverlay() {
    renderClockTime();

    const links = document.querySelectorAll<HTMLAnchorElement>('.menu-link');
    if (!links.length) return;

    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';

    let activeItemName = 'HOME';
    links.forEach((link) => {
      const href = link.getAttribute('data-href')?.replace(/\/$/, '') || '/';
      const name = link.getAttribute('data-link');

      if (href === currentPath) {
        activeItemName = name || 'HOME';
      }
    });

    links.forEach((link) => {
      const linkName = link.getAttribute('data-link');
      if (linkName && linkName === activeItemName) {
        link.classList.add('selected');
      } else {
        link.classList.remove('selected');
      }

      link.addEventListener('mousedown', () => link.classList.add('holding'));
      link.addEventListener('touchstart', () => link.classList.add('holding'), { passive: true });
      link.addEventListener('mouseup', () => link.classList.remove('holding'));
      link.addEventListener('mouseleave', () => link.classList.remove('holding'));
      link.addEventListener('touchend', () => link.classList.remove('holding'));

      link.addEventListener('click', () => {
        if (linkName) {
          localStorage.setItem('facet_last_menu_item', linkName);
        }
        closeMenuOverlay();
      });
    });
  }

  if (!(window as any)._overlayClockTimer) {
    (window as any)._overlayClockTimer = setInterval(renderClockTime, 1000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMenuOverlay);
  } else {
    initMenuOverlay();
  }

  document.addEventListener('astro:page-load', initMenuOverlay);
</script>