---
import featProjectImg from '../assets/res-eoa-1597.avif';
import addressImg from '../assets/res-blann.avif';
import sacapLogoImg from '../assets/sacap-logo.avif';

interface Props {
  isOpen?: boolean;
}

const { isOpen = false } = Astro.props;

const menuItems = [
  { name: 'HOME', href: '/' },
  { name: 'PORTFOLIO', href: '/portfolio' },
  { name: 'ABOUT', href: '/about' },
  { name: 'CONTACT', href: '/contact' },
];
---

<div id="menu-overlay" class={`menu-overlay ${isOpen ? 'active' : ''}`}>
  <div class="menu-container">
    
    <!-- Left Section: 2x2 Grid -->
    <div class="left-grid">
      
      <!-- Top Tile: Featured Project -->
      <a href="/portfolio#residential" class="grid-tile tile-featured">
        <div class="tile-bg" style={`background-image: url('${featProjectImg.src}');`}></div>
        <div class="tile-overlay"></div>
        <div class="tile-content content-featured">
          <span class="featured-label">FEATURED PROJECT</span>
          <span class="project-name">EoA1597</span>
        </div>
      </a>

      <!-- Bottom-Left Tile: Address -->
      <div class="grid-tile tile-address">
        <div class="tile-bg" style={`background-image: url('${addressImg.src}');`}></div>
        <div class="tile-overlay address-darken"></div>
        <div class="tile-content content-address">
          <p class="address-text">
            118 Kastaiing Street<br />
            Weltevredenpark<br />
            Johannesburg<br />
            South Africa<br />
            1709
          </p><br>
          <p class="telephone number">
            Tel: +27 60 996 0690
          </p>
        </div>
      </div>

      <!-- Bottom-Right Tile: SACAP Logo -->
      <div class="grid-tile tile-logo">
        <img src={sacapLogoImg.src} alt="SACAP Logo" class="sacap-logo-img" />
      </div>

    </div>

    <!-- Right Section: Navigation Links -->
    <div class="right-nav">
      <nav class="menu-nav-list">
        {menuItems.map((item) => (
          <a href={item.href} class="menu-link" data-link={item.name}>
            <span class="menu-link-text">{item.name}</span>
            <span class="menu-link-underline"></span>
          </a>
        ))}
      </nav>
    </div>

  </div>
</div>

<style>
  :global(body.menu-open) {
    overflow: hidden !important;
    height: 100vh !important;
  }

  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 990;
    background-color: #2e343b;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease, visibility 0.4s ease;
    visibility: hidden;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
  }

  .menu-overlay.active {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .menu-container {
    width: 100%;
    height: 100dvh;
    display: grid;
    grid-template-columns: 1fr;
    box-sizing: border-box;
  }

  @media (min-width: 900px) {
    .menu-container {
      grid-template-columns: 55% 45%;
    }
  }

  /* Left Grid Layout */
  .left-grid {
    display: grid;
    grid-template-columns: 50% 50%;
    grid-template-rows: 50% 50%;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .grid-tile {
    position: relative;
    overflow: hidden;
    display: flex;
    text-decoration: none;
    width: 100%;
    height: 100%;
  }

  .tile-featured {
    grid-column: 1 / -1;
    grid-row: 1 / 2;
  }

  .tile-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .tile-featured:hover .tile-bg {
    transform: scale(1.05);
  }

  .tile-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
  }

  .address-darken {
    background: rgba(0, 0, 0, 0.55);
  }

  .tile-content {
    position: relative;
    z-index: 2;
    padding: clamp(16px, 3vw, 32px);
    width: 100%;
    height: 100%;
    box-sizing: border-box;
  }

  /* Featured Project Text */
  .content-featured {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;
    text-align: right;
  }

  .featured-label {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: clamp(1.2rem, 2.2vw, 2.2rem);
    color: #ffffff;
    letter-spacing: 2px;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .project-name {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    color: #ffffff;
    margin-top: 4px;
    font-weight: 400;
  }

  /* Address Tile */
  .tile-address {
    grid-column: 1 / 2;
    grid-row: 2 / 3;
  }

  .content-address {
    display: flex;
    align-items: flex-end;
  }

  .address-text {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: clamp(0.75rem, 1vw, 0.95rem);
    color: #ffffff;
    line-height: 1.35;
    margin: 0;
    font-weight: 400;
  }

  /* SACAP Logo Tile Fix */
  .tile-logo {
    grid-column: 2 / 3;
    grid-row: 2 / 3;
    background-color: #f36c21;
    padding: 0;
    margin: 0;
    line-height: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .sacap-logo-img {
    width: 100%;
    height: 100%;
    object-fit: fill;
    display: block;
    margin: 0;
    padding: 0;
    border: none;
  }

  /* Right Navigation Area */
  .right-nav {
    display: flex;
    align-items: center;
    padding: 0 40px 0 10%;
    background-color: #2e343b;
    height: 100%;
    box-sizing: border-box;
  }

  .menu-nav-list {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vh, 36px);
  }

  .menu-link {
    position: relative;
    display: inline-block;
    text-decoration: none;
    width: fit-content;
    padding-bottom: 6px;
  }

  .menu-link-text {
    font-family: 'BankGothic', sans-serif, system-ui;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    color: #ffffff;
    letter-spacing: 3px;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .menu-link.selected .menu-link-text {
    color: #00ffc8;
  }

  .menu-link-underline {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: #00ffc8;
    transform-origin: right center;
    transform: scaleX(0);
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .menu-link:hover .menu-link-underline,
  .menu-link:active .menu-link-underline,
  .menu-link.holding .menu-link-underline {
    transform-origin: left center;
    transform: scaleX(1);
  }

  .menu-link:not(:hover):not(:active):not(.holding) .menu-link-underline {
    transform-origin: right center;
    transform: scaleX(0);
  }

  /* Responsive Fallback for smaller screen heights */
  @media (max-width: 899px) {
    .menu-overlay {
      overflow-y: auto;
    }
    .menu-container {
      height: auto;
      min-height: 100dvh;
    }
    .left-grid {
      height: 60vh;
    }
    .right-nav {
      padding: 40px 24px;
    }
  }
</style>

<script>
  const overlay = document.getElementById('menu-overlay');
  const links = document.querySelectorAll<HTMLAnchorElement>('.menu-link');

  const savedItem = localStorage.getItem('facet_last_menu_item') || 'HOME';

  function updateSelectedState(itemName: string) {
    links.forEach((link) => {
      const linkName = link.getAttribute('data-link');
      if (linkName === itemName) {
        link.classList.add('selected');
      } else {
        link.classList.remove('selected');
      }
    });
  }

  updateSelectedState(savedItem);

  links.forEach((link) => {
    const linkName = link.getAttribute('data-link');

    link.addEventListener('mousedown', () => link.classList.add('holding'));
    link.addEventListener('touchstart', () => link.classList.add('holding'), { passive: true });

    link.addEventListener('mouseup', () => link.classList.remove('holding'));
    link.addEventListener('mouseleave', () => link.classList.remove('holding'));
    link.addEventListener('touchend', () => link.classList.remove('holding'));

    link.addEventListener('click', () => {
      if (linkName) {
        localStorage.setItem('facet_last_menu_item', linkName);
        updateSelectedState(linkName);
      }
    });
  });
</script>