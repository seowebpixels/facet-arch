---
/* MenuOverlay.astro */
import featProjectImg from '../assets/res-eoa-1597.avif';
import addressImg from '../assets/res-blann.avif';
import sacapLogoImg from '../assets/sacap-logo.avif';
import logoImg from '../assets/facet-logo-white.avif';

interface Props {
  isOpen?: boolean;
}

const { isOpen = false } = Astro.props;

const menuItems = [
  { name: 'HOME', href: '/' },
  { name: 'PORTFOLIO', href: '/portfolio' },
  { name: 'ABOUT', href: '/about' },
  { name: 'CONTACT', href: '/contact' },
];
---

<div id="menu-overlay" class={`menu-overlay ${isOpen ? 'active' : ''}`}>
  <div class="menu-container">
    
    <div class="left-grid">
      
      <a href="/portfolio#residential" class="grid-tile tile-featured">
        <div class="tile-bg" style={`background-image: url('${featProjectImg.src}');`}></div>
        <div class="tile-overlay"></div>
        <div class="tile-content content-featured">
          <span class="featured-label">FEATURED PROJECT</span>
          <span class="project-name">EoA1597</span>
        </div>
      </a>

      <div class="grid-tile tile-address">
        <div class="tile-bg" style={`background-image: url('${addressImg.src}');`}></div>
        <div class="tile-overlay address-darken"></div>
        <div class="tile-content content-address">
          <div class="address-wrapper">
            <p class="address-text">
              118 Kastaiing Street<br />
              Weltevredenpark<br />
              Johannesburg<br />
              South Africa<br />
              1709
            </p>
            <p class="telephone-number">
              Tel: +27 60 996 0690
            </p>
          </div>
        </div>
      </div>

      <div class="grid-tile tile-logo">
        <img src={sacapLogoImg.src} alt="SACAP Logo" class="sacap-logo-img" />
      </div>

    </div>

    <div class="right-nav">
      <a href="/" class="overlay-logo-link" aria-label="Facet Architecture Home">
        <img src={logoImg.src} alt="Facet Architecture Logo" class="overlay-logo" />
      </a>

      <nav class="menu-nav-list">
        {menuItems.map((item) => (
          <a href={item.href} class="menu-link" data-link={item.name} data-href={item.href}>
            <span class="menu-link-text">{item.name}</span>
            <span class="menu-link-underline"></span>
          </a>
        ))}
      </nav>

      <!-- Overlay Bottom Clock -->
      <div class="overlay-clock-container">
        <span id="overlay-clock-time" class="overlay-clock-text">00:00:00 GMT+2</span>
      </div>
    </div>

  </div>
</div>

<style>
  :global(body.menu-open) {
    overflow: hidden !important;
    height: 100vh !important;
  }

  .menu-overlay {
  position: fixed;
  inset: 0;
  z-index: 2147483640; /* Set to maximum layer depth */
  background-color: #2e343b;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s ease, visibility 0.4s ease;
  visibility: hidden;
  width: 100vw;
  height: 100dvh;
  overflow: hidden;
}

/* Must be defined so clicks work when open */
.menu-overlay.active {
  opacity: 1 !important;
  pointer-events: auto !important;
  visibility: visible !important;
}

/* Ensure child elements inside overlay capture mouse/tap events */
.menu-overlay.active * {
  pointer-events: auto !important;
}

  .menu-overlay * {
    pointer-events: auto !important;
  }

  .menu-container {
    width: 100%;
    height: 100dvh;
    display: grid;
    grid-template-columns: 1fr;
    box-sizing: border-box;
  }

  @media (min-width: 900px) {
    .menu-container {
      grid-template-columns: 55% 45%;
    }
  }

  /* Left Grid Layout */
  .left-grid {
    display: grid;
    grid-template-columns: 50% 50%;
    grid-template-rows: 50% 50%;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .grid-tile {
    position: relative;
    overflow: hidden;
    display: flex;
    text-decoration: none;
    width: 100%;
    height: 100%;
  }

  .tile-featured {
    grid-column: 1 / -1;
    grid-row: 1 / 2;
  }

  .tile-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .tile-featured:hover .tile-bg {
    transform: scale(1.05);
  }

  .tile-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
  }

  .address-darken {
    background: rgba(0, 0, 0, 0.55);
  }

  .tile-content {
    position: relative;
    z-index: 2;
    padding: clamp(12px, 3vw, 32px);
    width: 100%;
    height: 100%;
    box-sizing: border-box;
  }

  /* Featured Project Text */
  .content-featured {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;
    text-align: right;
  }

  .featured-label {
    font-family: 'Bank Gothic', 'BankGothic', sans-serif, system-ui;
    font-size: clamp(1.2rem, 2.2vw, 2.2rem);
    color: #ffffff;
    letter-spacing: 2px;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .project-name {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    color: #ffffff;
    margin-top: 4px;
    font-weight: 400;
  }

  /* Address Tile Layout */
  .tile-address {
    grid-column: 1 / 2;
    grid-row: 2 / 3;
  }

  .tile-address .tile-bg {
    filter: grayscale(100%);
  }

  .content-address {
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    text-align: left;
  }

  .address-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    width: 100%;
  }

  .address-text {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: clamp(0.7rem, 1vw, 0.95rem);
    color: #ffffff;
    line-height: 1.3;
    margin: 0;
    font-weight: 400;
    text-align: left;
  }

  .telephone-number {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: clamp(0.7rem, 1vw, 0.95rem);
    color: #ffffff;
    line-height: 1.3;
    margin: 0.6rem 0 0 0;
    padding: 0;
    font-weight: 400;
    text-align: left;
  }

  /* SACAP Logo Tile Fix */
  .tile-logo {
    grid-column: 2 / 3;
    grid-row: 2 / 3;
    background-color: #f36c21;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .sacap-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8%;
    box-sizing: border-box;
    display: block;
    margin: 0;
    border: none;
  }

  /* Right Navigation Area */
  .right-nav {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0 40px 0 10%;
    background-color: #2e343b;
    height: 100%;
    box-sizing: border-box;
  }

  /* Overlay White Logo Placement */
  .overlay-logo-link {
    position: absolute;
    top: -16px;
    right: 20px;
    z-index: 10;
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .overlay-logo {
    height: clamp(125px, 14vw, 155px);
    width: auto;
    display: block;
  }

  .menu-nav-list {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 3vh, 36px);
  }

  .menu-link {
    position: relative;
    display: inline-block;
    text-decoration: none;
    width: fit-content;
    padding-bottom: 6px;
  }

  .menu-link-text {
    font-family: 'Bank Gothic', 'BankGothic', sans-serif, system-ui;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    color: #ffffff;
    letter-spacing: 3px;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .menu-link.selected .menu-link-text {
    color: #00ffc8;
  }

  .menu-link-underline {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: #00ffc8;
    transform-origin: right center;
    transform: scaleX(0);
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .menu-link:hover .menu-link-underline,
  .menu-link:active .menu-link-underline,
  .menu-link.holding .menu-link-underline {
    transform-origin: left center;
    transform: scaleX(1);
  }

  .menu-link:not(:hover):not(:active):not(.holding) .menu-link-underline {
    transform-origin: right center;
    transform: scaleX(0);
  }

  /* Menu Overlay Bottom Clock Styling */
  .overlay-clock-container {
    position: absolute;
    bottom: 48px;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    width: 100%;
  }

  .overlay-clock-text {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: clamp(1.1rem, 1.8vw, 1.5rem);
    color: #ffffff;
    letter-spacing: 2px;
    opacity: 0.9;
  }

  /* Mobile Specific Layout Adjustments */
  @media (max-width: 899px) {
    .menu-overlay {
      overflow-y: auto;
    }
    .menu-container {
      height: auto;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
    }
    .left-grid {
      height: 42vh;
      flex-shrink: 0;
    }
    .right-nav {
      padding: 32px 24px 48px 24px;
      flex-grow: 1;
    }
    .overlay-logo-link {
      top: -18px;
      right: 15px;
    }
    .overlay-logo {
      height: clamp(115px, 16vw, 130px);
    }
    .menu-link-text {
      font-size: clamp(2.2rem, 8vw, 3.2rem);
    }
    .overlay-clock-container {
      bottom: 24px;
    }
  }
</style>

<script>
  function updateOverlayClock() {
    const clockEl = document.getElementById('overlay-clock-time');
    if (!clockEl) return;

    const now = new Date();
    const options: Intl.DateTimeFormatOptions = {
      timeZone: 'Africa/Johannesburg',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false
    };

    const timeString = new Intl.DateTimeFormat('en-GB', options).format(now);
    clockEl.textContent = `${timeString} GMT+2`;
  }

  function setupOverlayMenu() {
    // Update clock immediately when menu component runs
    updateOverlayClock();

    const links = document.querySelectorAll<HTMLAnchorElement>('.menu-link');
    if (!links.length) return;

    // Detect active page based on current URL path
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';

    function syncActiveLink() {
      let activeItemName = 'HOME';

      links.forEach((link) => {
        const href = link.getAttribute('data-href')?.replace(/\/$/, '') || '/';
        const name = link.getAttribute('data-link');

        if (href === currentPath) {
          activeItemName = name || 'HOME';
        }
      });

      links.forEach((link) => {
        const linkName = link.getAttribute('data-link');
        if (linkName === activeItemName) {
          link.classList.add('selected');
        } else {
          link.classList.remove('selected');
        }
      });
    }

    syncActiveLink();

    links.forEach((link) => {
      const linkName = link.getAttribute('data-link');

      link.addEventListener('mousedown', () => link.classList.add('holding'));
      link.addEventListener('touchstart', () => link.classList.add('holding'), { passive: true });

      link.addEventListener('mouseup', () => link.classList.remove('holding'));
      link.addEventListener('mouseleave', () => link.classList.remove('holding'));
      link.addEventListener('touchend', () => link.classList.remove('holding'));

      link.addEventListener('click', () => {
        if (linkName) {
          localStorage.setItem('facet_last_menu_item', linkName);
        }
      });
    });
  }

  // Ensure interval runs continuously for the overlay clock
  if (!(window as any)._overlayClockInterval) {
    (window as any)._overlayClockInterval = setInterval(updateOverlayClock, 1000);
  }

  setupOverlayMenu();
  document.addEventListener('astro:page-load', () => {
    updateOverlayClock();
    setupOverlayMenu();
  });
</script>